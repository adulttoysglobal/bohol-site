          return;
        }
        let csv = '\uFEFF单据编号,来源渠道,提交时间,采购商姓名,企业/品牌,联系电话,联系邮箱,国家/地区,目的港/要求,运输方式,订购产品明细/规格,客户说明附言\n';
        leads.forEach(l => {
          let detail = '';
          if (Array.isArray(l.rawItems) && l.rawItems.length) {
            detail = l.rawItems.map(i => `[${i.code || i.id}] ${i.name} * ${i.quantity}`).join('; ');
          } else if (l.type || l.models) {
            detail = `${l.type || ''} / ${l.quantity || ''} / 意向:${l.models || ''}`;
          }
          const cleanNotes = (l.message || '').replace(/"/g, '""').replace(/\r?\n/g, ' ');
          csv += `"${l.id || ''}","${l.source || ''}","${l.submittedAt || ''}","${l.name || ''}","${l.company || ''}","${l.phone || ''}","${l.email || ''}","${l.country || ''}","${l.destinationAddress || l.destination || ''}","${l.shippingMode || ''}","${detail}","${cleanNotes}"\n`;
        });
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = `bohol_rfq_inquiries_${new Date().toISOString().slice(0, 10)}.csv`;
        link.click();
        showToast('已导出买家询盘单据报表 CSV！');
      });
    }

    // Save Settings
    const btnSaveSettings = document.getElementById('btn-save-settings');
    if (btnSaveSettings) {
      btnSaveSettings.addEventListener('click', () => {
        showToast('设置已保存');
      });
    }

    // Refresh Data button
    const btnRefreshData = document.getElementById('btn-refresh-data');
    if (btnRefreshData) {
      btnRefreshData.addEventListener('click', () => {
        renderInquiries();
        filterProducts();
        showToast('数据已刷新');
      });
    }

    // Check URL hash on load
    window.addEventListener('DOMContentLoaded', () => {
      const hash = window.location.hash.replace('#', '');
      if (hash && document.getElementById(`panel-${hash}`)) {
        switchTab(hash);
      }
    });
  </script>
</body>
</html>
