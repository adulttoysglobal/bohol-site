          <!-- 6. 目录推荐与售货机 (Catalog Options) -->
          <div class="woo-postbox">
            <div class="woo-postbox-header">
              <h3>前台展示与终端适配</h3>
            </div>
            <div class="woo-postbox-inside">
              <label style="display:flex; align-items:center; gap:6px; font-size:12.5px; cursor:pointer;">
                <input type="checkbox" id="woo-is-featured" checked />
                <span>设为首页精选推荐产品 (Featured)</span>
              </label>
              <label style="display:flex; align-items:center; gap:6px; font-size:12.5px; cursor:pointer; margin-top:8px;">
                <input type="checkbox" id="woo-is-vending" checked />
                <span>适配智能售货机弹簧槽位 (Vending Slot Ready)</span>
