---
import { getCollection } from 'astro:content';
import '../../styles/bohol-control.css';
import '../../styles/woo-product-editor.css';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const journal = (await getCollection('journal')).sort((a, b) => a.data.order - b.data.order);

function getFobPrice(prod: any) {
  if (prod.data.price) return prod.data.price;
  const cat = prod.data.category;
  if (cat === 'Electric') return '$18.50 - $28.00';
  if (cat === 'Adaptive') return '$14.20 - $21.50';
  if (cat === 'Compact') return '$9.80 - $15.00';
  return '$12.00 - $18.50';
}

function getMoq(prod: any) {
  const cat = prod.data.category;
  if (cat === 'Electric') return '50 pcs';
  if (cat === 'Adaptive') return '100 pcs';
  if (cat === 'Compact') return '200 pcs';
  return '100 pcs';
}

const corePages = [
  { path: '/', title: 'Home · 官方外贸首页', type: '核心落地页', category: 'Landing' },
  { path: '/about/', title: 'About Us · 品牌工厂与研发实力', type: '核心落地页', category: 'Company' },
  { path: '/products/', title: 'Products · 全系列私模产品中心', type: '核心落地页', category: 'Catalog' },
  { path: '/manufacturing/', title: 'Manufacturing · 万级洁净车间与精工制造', type: '核心落地页', category: 'Factory' },
  { path: '/technology/', title: 'Technology · 液态硅胶模具与电机声学核心技术', type: '核心落地页', category: 'Tech' },
  { path: '/guide/', title: 'B2B Guide · 采购商避坑指南与打样流程', type: '核心落地页', category: 'Guide' },
  { path: '/journal/', title: 'Journal & Insights · 行业洞察与出海技术文章库', type: '核心落地页', category: 'Journal' },
  { path: '/catalogue/', title: 'E-Catalogue · 电子产品画册与规格书在线交互', type: '核心落地页', category: 'Catalog' },
  { path: '/rfq/', title: 'RFQ · B2B 询盘与工程快速报价单', type: '核心落地页', category: 'Inquiry' },
  { path: '/partners/', title: 'Partners · 全球分销商与海外运营商合伙计划', type: '核心落地页', category: 'Partners' },
  { path: '/support/', title: 'Support · 售后维保与技术支持中心', type: '核心落地页', category: 'Support' },
  { path: '/support/documentation/', title: 'Documentation · CE / FCC / FDA / RoHS 合规文库', type: '核心落地页', category: 'Compliance' },
  { path: '/news/', title: 'News · 品牌动态与展会资讯', type: '核心落地页', category: 'News' },
  { path: '/privacy/', title: 'Privacy · 国际隐私政策与合规条款', type: '核心落地页', category: 'Legal' },
  { path: '/contact/', title: 'Contact Us · 7x24h 官方商务对接通道', type: '核心落地页', category: 'Contact' }
];

const totalPagesCount = corePages.length + products.length + journal.length;
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Adult Toys Global 网站管理后台</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="bc-body">
  <!-- Admin Password Authentication Gate -->
  <div id="admin-auth-gate" class="bc-auth-gate" style="display:none;">
    <div class="bc-auth-card">
      <div class="bc-auth-icon">🛡️</div>
      <h2 class="bc-auth-title">Adult Toys Global 管理控制台</h2>
      <p class="bc-auth-subtitle">受保护的管理页面 · 请输入访问授权密码</p>

      <form id="admin-auth-form" class="bc-auth-form">
        <label class="bc-auth-label" for="admin-auth-pwd">管理员安全密码 (Password)</label>
        <div class="bc-auth-input-wrapper">
          <input
            type="password"
            id="admin-auth-pwd"
            class="bc-auth-input"
            placeholder="请输入管理员密码..."
            required
            autocomplete="current-password"
            autofocus
          />
          <button type="button" id="admin-auth-eye-btn" class="bc-auth-toggle-pwd" title="切换密码显示">👁️</button>
        </div>

        <label class="bc-auth-remember">
          <input type="checkbox" id="admin-auth-remember" checked />
          <span>保持登录状态（30天内免密）</span>
        </label>

        <button type="submit" class="bc-auth-btn" id="admin-auth-submit-btn">
          <span>安全登录工作台 ➔</span>
        </button>

        <div id="admin-auth-error" class="bc-auth-error"></div>
      </form>
    </div>
  </div>

  <script is:inline>
    // Immediate synchronous auth check (prevents blank screen)
    (function() {
      try {
        var token = localStorage.getItem('atg_admin_auth_session') || sessionStorage.getItem('atg_admin_auth_session');
        var isAuth = false;
        if (token) {
          var parsed = JSON.parse(token);
          if (parsed && parsed.auth === true && (!parsed.expiry || Date.now() < parsed.expiry)) {
            isAuth = true;
          }
        }
        var gate = document.getElementById('admin-auth-gate');
        var app = document.getElementById('bc-admin-app-layout');
        if (isAuth) {
          if (app) app.style.display = 'flex';
          if (gate) gate.style.display = 'none';
        } else {
          if (gate) gate.style.display = 'flex';
          if (app) app.style.display = 'none';
        }
      } catch(e) {
        var g = document.getElementById('admin-auth-gate');
        if (g) g.style.display = 'flex';
      }
    })();
  </script>

  <div class="bc-layout" id="bc-admin-app-layout" style="display:none;">
    <!-- Sidebar Navigation -->
    <aside class="bc-sidebar">
      <div class="bc-sidebar-brand">
        <h1 class="bc-brand-title" style="font-size:16px; line-height:1.2; letter-spacing:-0.2px;">Adult Toys Global</h1>
        <p class="bc-brand-subtitle">外贸综合管理后台</p>
      </div>

      <nav class="bc-nav-list" id="bc-nav">
        <li class="bc-nav-item">
          <button class="bc-nav-btn active" data-tab="workbench">
            <span class="bc-nav-icon">📊</span>
            <span>工作台</span>
          </button>
        </li>
        <li class="bc-nav-item">
          <button class="bc-nav-btn" data-tab="products">
            <span class="bc-nav-icon">📦</span>
            <span>产品管理 · 模块1</span>
          </button>
        </li>
        <li class="bc-nav-item">
          <button class="bc-nav-btn" data-tab="articles">
            <span class="bc-nav-icon">📝</span>
            <span>文章与新闻</span>
          </button>
        </li>
        <li class="bc-nav-item">
          <button class="bc-nav-btn" data-tab="inquiries">
            <span class="bc-nav-icon">💬</span>
            <span>留言与聊天</span>
            <span class="bc-badge bc-badge-warning" id="sidebar-inquiry-badge" style="margin-left:auto; font-size:10px; padding:1px 6px; border-radius:10px;">0</span>
          </button>
        </li>
        <li class="bc-nav-item">
          <button class="bc-nav-btn" data-tab="social">
            <span class="bc-nav-icon">🌐</span>
            <span>社媒管理</span>
          </button>
        </li>
        <li class="bc-nav-item">
          <button class="bc-nav-btn" data-tab="google">
            <span class="bc-nav-icon">🔍</span>
            <span>Google 收录与 SEO</span>
            <span class="bc-badge bc-badge-success" style="margin-left:auto; font-size:10px; padding:1px 6px; border-radius:10px;">🟢 已认证</span>
          </button>
        </li>
        <li class="bc-nav-item">
          <button class="bc-nav-btn" data-tab="analytics">
            <span class="bc-nav-icon">📈</span>
            <span>访问分析</span>
          </button>
        </li>
        <li class="bc-nav-item">
          <button class="bc-nav-btn" data-tab="toolbox">
            <span class="bc-nav-icon">🧰</span>
            <span>百宝箱设置</span>
          </button>
        </li>
        <li class="bc-nav-item">
          <button class="bc-nav-btn" data-tab="security">
            <span class="bc-nav-icon">🛡️</span>
            <span>安全设置</span>
          </button>
        </li>
      </nav>

      <div style="padding: 16px 20px; border-top: 1px solid rgba(255,255,255,0.06); font-size: 11px; color: #64748b;">
        <div>网站管理系统</div>
        <div style="margin-top: 4px; color: #10b981;">● 线上连接正常</div>
      </div>
    </aside>

    <!-- Main Container -->
    <main class="bc-main">
      <!-- Topbar -->
      <div class="bc-topbar" style="display:flex; justify-content:space-between; align-items:center; padding:16px 36px;">
        <div class="bc-breadcrumbs" id="bc-breadcrumb">
          <span style="color:#64748b;">网站管理</span>
          <span style="color:#cbd5e1;">/</span>
          <span style="color:#0f172a; font-weight:700;" id="bc-current-title">工作台</span>
        </div>
        <div style="display:flex; align-items:center; gap:12px;">
          <a href="/" target="_blank" class="bc-btn-secondary bc-btn-sm" style="text-decoration:none;">
            <span>网站前台</span>
            <span style="font-size:11px;">↗</span>
          </a>
          <button type="button" class="bc-btn-secondary bc-btn-sm" id="btn-refresh-data">
            <span>刷新数据 ↻</span>
          </button>
          <div style="display:flex; align-items:center; gap:8px; margin-left:12px; padding-left:12px; border-left:1px solid #e2e8f0;">
            <div style="width:28px; height:28px; border-radius:50%; background:#2563eb; color:#fff; display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:700;">
              AD
            </div>
            <span style="font-size:13px; font-weight:600; color:#334155;">Admin</span>
            <button type="button" id="btn-admin-logout" class="bc-btn-secondary bc-btn-sm" style="margin-left:6px; font-size:11px; padding:3px 8px; color:#ef4444; border-color:#fecaca;" title="安全退出">
              退出 ✕
            </button>
          </div>
        </div>
      </div>

      <!-- Main Tab Panels -->
      <div class="bc-content">

        <!-- ========================================== -->
        <!-- TAB 1: 工作台 (Workbench - Screenshot 1 & 2) -->
        <!-- ========================================== -->
        <div class="bc-panel active" id="panel-workbench">
          <div class="bc-page-header">
            <div class="bc-page-title">
              <h1>工作台</h1>
              <p>管理总体内容，监控发布状态和服务连接。</p>
            </div>
            <div>
              <button class="bc-btn-primary" id="wb-quick-add-btn">
                <span>+ 新建产品</span>
              </button>
            </div>
          </div>

          <!-- 4 KPI Cards -->
          <div class="bc-kpi-row" style="grid-template-columns: repeat(4, 1fr);">
            <div class="bc-kpi-card">
              <div class="bc-kpi-title">产品内容</div>
              <div class="bc-kpi-num" id="kpi-product-count">{products.length}</div>
              <div class="bc-kpi-desc">中英文私模产品</div>
            </div>

            <div class="bc-kpi-card">
              <div class="bc-kpi-title">文章内容</div>
              <div class="bc-kpi-num">{journal.length}</div>
              <div class="bc-kpi-desc">已发布高权重文章</div>
            </div>

            <div class="bc-kpi-card">
              <div class="bc-kpi-title">站点收录规模</div>
              <div class="bc-kpi-num">{totalPagesCount}</div>
              <div class="bc-kpi-desc">Sitemap 静态收录页</div>
            </div>

            <div class="bc-kpi-card">
              <div class="bc-kpi-title">客户单据</div>
              <div class="bc-kpi-num" id="kpi-lead-count">0</div>
              <div class="bc-kpi-desc">未处理询盘</div>
            </div>
          </div>

          <!-- 实时监控与运营大盘 (Real-time Operations & Live Monitoring) -->
          <div class="bc-card">
            <div class="bc-card-head" style="margin-bottom:12px;">
              <div class="bc-card-title">
                <h3>🌐 网站实时监控与全球网络大盘</h3>
                <p>独立站 <code>adulttoysglobal.com</code> 已全面接入 Cloudflare 全球边缘网络，支持毫秒级实时流量监控与询盘实时同步。</p>
              </div>
              <div style="display:flex; gap:8px;">
                <a href="https://dash.cloudflare.com/" target="_blank" class="bc-btn-primary" style="text-decoration:none; font-size:12px; padding:6px 12px;">
                  <span>打开 Cloudflare 全球实时分析 ↗</span>
                </a>
              </div>
            </div>

            <!-- 实时网络健康状态条 -->
            <div style="display:grid; grid-template-columns:repeat(4, 1fr); gap:12px; margin-bottom:16px;">
              <div style="padding:12px 14px; background:#f0fdf4; border:1px solid #bbf7d0; border-radius:8px;">
                <div style="font-size:11px; color:#166534; font-weight:700;">● 独立站主域名</div>
                <div style="font-size:14px; font-weight:800; color:#14532d; margin-top:3px; word-break:break-all;">adulttoysglobal.com</div>
                <div style="font-size:11px; color:#15803d; margin-top:2px;">🟢 全球 300+ 边缘节点直连</div>
              </div>

              <div style="padding:12px 14px; background:#eff6ff; border:1px solid #bfdbfe; border-radius:8px;">
                <div style="font-size:11px; color:#1e40af; font-weight:700;">● 边缘安全与加速</div>
                <div style="font-size:14px; font-weight:800; color:#1e3a8a; margin-top:3px;">Cloudflare CDN / SSL</div>
                <div style="font-size:11px; color:#2563eb; margin-top:2px;">🟢 HTTPS / HTTP3 极速分发</div>
              </div>

              <div style="padding:12px 14px; background:#faf5ff; border:1px solid #e9d5ff; border-radius:8px;">
                <div style="font-size:11px; color:#6b21a8; font-weight:700;">● 搜索引擎收录</div>
                <div style="font-size:14px; font-weight:800; color:#581c87; margin-top:3px;">Google 官方已验证</div>
                <div style="font-size:11px; color:#7e22ce; margin-top:2px;">🟢 Sitemap 状态: 成功 ({totalPagesCount} 页)</div>
              </div>

              <div style="padding:12px 14px; background:#fff7ed; border:1px solid #fed7aa; border-radius:8px;">
                <div style="font-size:11px; color:#9a3412; font-weight:700;">● 询盘接收邮箱</div>
                <div style="font-size:13px; font-weight:800; color:#7c2d12; margin-top:3px; word-break:break-all;">adulttoysglobal1997@...</div>
                <div style="font-size:11px; color:#c2410c; margin-top:2px;">🟢 实时表单接口已联通</div>
              </div>
            </div>

            <!-- 实时监控与分析接入指南 -->
            <div style="padding:14px 18px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
              <div style="font-size:13px; color:#475569; max-width:680px; line-height:1.6;">
                <strong style="color:#0f172a;">📊 为什么初始数据显示为 0 或等待爬虫？</strong><br/>
                因为 <code>adulttoysglobal.com</code> 是今天刚上线的全新外贸独立站。Google 搜索引擎蜘蛛（Googlebot）在接收到本站的 <code>/sitemap-index.xml</code> 后，通常在 24~72 小时内开始建立索引并产生自然搜索展现。您可直接通过下方 Cloudflare 查看今日实时进入网站的每一笔真实访客。
              </div>
              <div style="display:flex; gap:10px;">
                <button type="button" class="bc-btn-secondary" onclick="document.querySelector('[data-tab=inquiries]')?.click()">
                  <span>查看买家留言 &rarr;</span>
                </button>
                <button type="button" class="bc-btn-secondary" onclick="document.querySelector('[data-tab=analytics]')?.click()">
                  <span>监控对接设置 &rarr;</span>
                </button>
              </div>
            </div>
          </div>

          <!-- 开始管理 matching Screenshot 2 -->
          <div class="bc-card">
            <div class="bc-card-title">
              <h3>开始管理</h3>
              <p>产品名称、正文与 SEO 文章请填写英文，保存后的内容需要网站重新部署，才能更新线上页面。</p>
            </div>
            <div style="display:flex; gap:16px; margin-top:14px;">
              <button class="bc-btn-secondary" data-action="go-products" style="color:#2563eb; font-weight:600;">
                管理产品 &rarr;
              </button>
              <button class="bc-btn-secondary" data-action="go-articles" style="color:#2563eb; font-weight:600;">
                管理文章 &rarr;
              </button>
            </div>
          </div>

          <!-- 接入进度与系统状态 -->
          <div class="bc-card">
            <div class="bc-card-title">
              <h3>核心服务连接与接入状态</h3>
            </div>
            <div style="display:flex; flex-direction:column; gap:8px; margin-top:12px; font-size:13px; color:#4a5568;">
              <div><strong>Google 官方验证:</strong> 🟢 已通过 HTML 所有权验证 (google5987a4e5dbc06ae5.html) · 资源 <code>https://adulttoysglobal.com/</code></div>
              <div><strong>Google Sitemap 提交:</strong> 🟢 sitemap.xml & sitemap-index.xml 状态均为「成功」(共 {totalPagesCount} 个 URL 抓取解析完成)</div>
              <div><strong>SEO & GEO 技术规范:</strong> 🟢 全站 109 篇技术文章配备 Schema.org FAQPage、TechArticle 语义标签与 ISO 13485 / FDA 权威引用</div>
              <div><strong>实时流量统计分析:</strong> 🟢 Cloudflare 边缘全球实时分析已激活，支持 GA4 衡量 ID 一键热插拔绑定</div>
            </div>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- TAB 2: 产品管理 · 模块1 (Product Management) -->
        <!-- ========================================== -->
        <div class="bc-panel" id="panel-products">
          <div class="bc-page-header">
            <div class="bc-page-title">
              <h1>产品管理 · 模块1</h1>
              <p>管理全站 {products.length} 款产品，支持修改价格、起订量、规格参数、上架状态与直接新建发布产品</p>
            </div>
            <div style="display:flex; gap:10px;">
              <button class="bc-btn-secondary" id="btn-export-products-csv">
                <span>导出 CSV 清单</span>
              </button>
              <button class="bc-btn-primary" id="btn-open-add-product-modal">
                <span>+ 新建产品</span>
              </button>
            </div>
          </div>

          <!-- Product Filters Toolbar -->
          <div class="bc-card" style="padding:16px 20px; margin-bottom:16px;">
            <div style="display:flex; gap:16px; flex-wrap:wrap; align-items:center; justify-content:space-between;">
              <div style="display:flex; gap:12px; flex:1; min-width:280px; align-items:center;">
                <div style="position:relative; flex:1; max-width:360px;">
                  <input type="text" class="bc-input" id="prod-search-input" placeholder="搜索产品名称、型号或关键词..." style="padding-left:32px;" />
                  <span style="position:absolute; left:10px; top:50%; transform:translateY(-50%); color:#94a3b8; font-size:14px;">🔍</span>
                </div>
                <select class="bc-select" id="prod-filter-category" style="width:180px;">
                  <option value="ALL">全部分类 (全部)</option>
                  <option value="Electric">Electric 电动系列</option>
                  <option value="Adaptive">Adaptive 自适应系列</option>
                  <option value="Compact">Compact 紧凑系列</option>
                  <option value="Sculpted">Sculpted 匠心雕花系列</option>
                </select>
                <select class="bc-select" id="prod-filter-status" style="width:140px;">
                  <option value="ALL">全部状态</option>
                  <option value="ACTIVE">已上架</option>
                  <option value="DRAFT">草稿 / 已下架</option>
                </select>
              </div>
              <div>
                <span class="bc-badge bc-badge-neutral" id="prod-counter-badge" style="font-size:12px; padding:6px 12px;">
                  共 {products.length} 款产品
                </span>
              </div>
            </div>
          </div>

          <!-- Product Table -->
          <div class="bc-card" style="padding:0; overflow:hidden;">
            <div class="bc-table-wrap" style="border:none;">
              <table class="bc-table" id="products-table">
                <thead>
                  <tr>
                    <th style="width:70px; text-align:center;">缩略图</th>
                    <th style="min-width:220px;">产品名称 & 编号</th>
                    <th style="width:120px;">所属分类</th>
                    <th style="width:100px;">起订量 MOQ</th>
                    <th style="width:140px;">批发参考价 (USD)</th>
                    <th style="width:100px; text-align:center;">上架状态</th>
                    <th style="width:160px; text-align:center;">操作</th>
                  </tr>
                </thead>
                <tbody id="products-tbody">
                  {products.map(p => (
                    <tr data-id={p.id} data-cat={p.data.category} data-name={p.data.name.toLowerCase()} data-status="ACTIVE">
                      <td style="text-align:center;">
                        <img src={p.data.image} alt={p.data.name} style="width:44px; height:44px; object-fit:cover; border-radius:6px; border:1px solid #e2e8f0; background:#f8fafc;" loading="lazy" />
                      </td>
                      <td>
                        <strong style="color:#0f172a; font-size:13px;">{p.data.name}</strong>
                        <div style="font-size:11px; color:#64748b; margin-top:2px;">
                          <code>{p.id}</code> &bull; <span style="color:#2563eb;">{p.data.label}</span>
                        </div>
