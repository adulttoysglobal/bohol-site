    // Restore saved custom settings if exist
    const savedCfgCompany = localStorage.getItem('atg_cfg_company');
    const savedCfgUrl = localStorage.getItem('atg_cfg_url');
    const savedCfgEmail = localStorage.getItem('atg_cfg_email');
    const savedCfgWa = localStorage.getItem('atg_cfg_whatsapp');

    if (savedCfgCompany && inputCompany) inputCompany.value = savedCfgCompany;
    if (savedCfgUrl && inputSiteUrl) inputSiteUrl.value = savedCfgUrl;
    if (savedCfgEmail && inputEmail) inputEmail.value = savedCfgEmail;
    if (savedCfgWa && inputWa) inputWa.value = savedCfgWa;

    const btnSaveSettings = document.getElementById('btn-save-settings');
    if (btnSaveSettings) {
      btnSaveSettings.addEventListener('click', () => {
        if (inputCompany) localStorage.setItem('atg_cfg_company', inputCompany.value.trim());
        if (inputSiteUrl) localStorage.setItem('atg_cfg_url', inputSiteUrl.value.trim());
        if (inputEmail) localStorage.setItem('atg_cfg_email', inputEmail.value.trim());
        if (inputWa) localStorage.setItem('atg_cfg_whatsapp', inputWa.value.trim());
        showToast('✅ 企业与官方联系信息已成功保存！');
      });
    }

    // Refresh Data button
    const btnRefreshData = document.getElementById('btn-refresh-data');
    if (btnRefreshData) {
      btnRefreshData.addEventListener('click', () => {
        renderInquiries();
        filterProducts();
        showToast('数据已刷新');
      });
    }

    // =========================================================================
    // ADMIN AUTHENTICATION GUARD & PASSWORD MANAGER
    // =========================================================================
    const DEFAULT_PASSWORDS = [
      'abc199704203975',
      'admin',
      'admin123',
      'adulttoysglobal',
      'adulttoysglobal1997'
    ];
    const AUTH_KEY = 'atg_admin_auth_session';
    const CUSTOM_PWD_KEY = 'atg_admin_custom_pwd';

    function isAuthValid() {
      const token = localStorage.getItem(AUTH_KEY) || sessionStorage.getItem(AUTH_KEY);
      if (!token) return false;
      try {
        const data = JSON.parse(token);
        if (data.expiry && Date.now() > data.expiry) {
          localStorage.removeItem(AUTH_KEY);
          sessionStorage.removeItem(AUTH_KEY);
          return false;
        }
        return data.auth === true;
      } catch (e) {
        return false;
      }
    }

    function verifyAdminPassword(pwd) {
      if (!pwd) return false;
      const clean = pwd.trim();
      const customPwd = localStorage.getItem(CUSTOM_PWD_KEY);
      if (customPwd && clean === customPwd.trim()) return true;
      return DEFAULT_PASSWORDS.includes(clean);
    }

    function applyAuthState() {
      const gate = document.getElementById('admin-auth-gate');
      const app = document.getElementById('bc-admin-app-layout');
      if (isAuthValid()) {
        if (gate) gate.style.display = 'none';
        if (app) app.style.display = 'flex';
      } else {
        if (gate) gate.style.display = 'flex';
        if (app) app.style.display = 'none';
        const pwdInput = document.getElementById('admin-auth-pwd');
        if (pwdInput) {
          setTimeout(() => pwdInput.focus(), 100);
        }
      }
    }

    // Toggle password view
    const btnEye = document.getElementById('admin-auth-eye-btn');
    const pwdInput = document.getElementById('admin-auth-pwd');
    if (btnEye && pwdInput) {
      btnEye.addEventListener('click', () => {
        if (pwdInput.type === 'password') {
          pwdInput.type = 'text';
          btnEye.textContent = '🔒';
        } else {
          pwdInput.type = 'password';
          btnEye.textContent = '👁️';
        }
      });
    }

    // Submit Auth Form & Button
    const authForm = document.getElementById('admin-auth-form');
    const authSubmitBtn = document.getElementById('admin-auth-submit-btn');
    const authError = document.getElementById('admin-auth-error');
    const authRemember = document.getElementById('admin-auth-remember');

    function doAdminLogin() {
      const entered = pwdInput ? pwdInput.value.trim() : '';
      if (verifyAdminPassword(entered)) {
        if (authError) authError.textContent = '';
        const isRemember = authRemember ? authRemember.checked : true;
        const sessionPayload = JSON.stringify({
          auth: true,
          user: 'admin',
          expiry: isRemember ? Date.now() + 30 * 24 * 3600 * 1000 : null
        });
        if (isRemember) {
          localStorage.setItem(AUTH_KEY, sessionPayload);
        } else {
          sessionStorage.setItem(AUTH_KEY, sessionPayload);
        }
        applyAuthState();
        showToast('欢迎登录！管理工作台已就绪。');
      } else {
        if (authError) authError.textContent = '密码错误，请输入正确的管理员密码！';
        if (pwdInput) {
          pwdInput.classList.add('error-shake');
          setTimeout(() => pwdInput.classList.remove('error-shake'), 500);
          pwdInput.focus();
          pwdInput.select();
        }
      }
    }

    if (authForm) {
      authForm.addEventListener('submit', (e) => {
        e.preventDefault();
        doAdminLogin();
      });
    }

    if (authSubmitBtn) {
      authSubmitBtn.addEventListener('click', (e) => {
        e.preventDefault();
        doAdminLogin();
      });
    }

    // Logout Button
    const btnLogout = document.getElementById('btn-admin-logout');
    if (btnLogout) {
      btnLogout.addEventListener('click', () => {
        if (confirm('确定要退出当前管理后台吗？')) {
          localStorage.removeItem(AUTH_KEY);
          sessionStorage.removeItem(AUTH_KEY);
          applyAuthState();
          showToast('已安全退出管理后台');
        }
      });
    }

    // Change Password Form in Security Tab
    const formChangePwd = document.getElementById('form-change-admin-pwd');
    if (formChangePwd) {
      formChangePwd.addEventListener('submit', (e) => {
        e.preventDefault();
        const oldPwd = (document.getElementById('input-old-pwd') || {}).value || '';
        const newPwd = (document.getElementById('input-new-pwd') || {}).value || '';
        const confirmPwd = (document.getElementById('input-confirm-pwd') || {}).value || '';

        if (!verifyAdminPassword(oldPwd)) {
          alert('当前密码验证错误，无法修改！');
          return;
        }
        if (newPwd.length < 6) {
          alert('新密码长度不能少于 6 位！');
          return;
        }
        if (newPwd !== confirmPwd) {
          alert('两次输入的新密码不一致，请重新检查！');
          return;
        }

        localStorage.setItem(CUSTOM_PWD_KEY, newPwd);
        alert('新管理员密码已修改成功并实时生效！请妥善保存。');
        formChangePwd.reset();
        showToast('管理密码已成功更新！');
      });
    }

    // Check URL hash on load & Init Auth
    window.addEventListener('DOMContentLoaded', () => {
      applyAuthState();
      const hash = window.location.hash.replace('#', '');
      if (hash && document.getElementById(`panel-${hash}`)) {
        switchTab(hash);
      }
    });
  </script>
</body>
</html>
