  </div>

  <!-- Toast Container -->
  <div id="bc-toast-container"></div>

  <!-- Client-side Interactive Logic -->
  <script is:inline>
    // Tab Switching
    const navButtons = document.querySelectorAll('.bc-nav-btn');
    const panels = document.querySelectorAll('.bc-panel');
    const currentTitleEl = document.getElementById('bc-current-title');

    function switchTab(tabId) {
      navButtons.forEach(btn => {
        if (btn.getAttribute('data-tab') === tabId) {
          btn.classList.add('active');
          const title = btn.querySelector('span:not(.bc-nav-icon)')?.textContent || '工作台';
          if (currentTitleEl) currentTitleEl.textContent = title;
        } else {
          btn.classList.remove('active');
        }
      });

      panels.forEach(p => {
        if (p.id === `panel-${tabId}`) {
          p.classList.add('active');
        } else {
          p.classList.remove('active');
        }
      });

      window.location.hash = tabId;
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    navButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const tab = btn.getAttribute('data-tab');
        if (tab) switchTab(tab);
      });
    });

    // Handle Quick Action Clicks in Workbench
    document.querySelectorAll('[data-action]').forEach(el => {
      el.addEventListener('click', () => {
        const action = el.getAttribute('data-action');
        if (action === 'go-products') {
          switchTab('products');
        } else if (action === 'go-articles') {
          switchTab('articles');
        }
      });
    });

    // =========================================================================
    // WOOCOMMERCE PRODUCT PUBLISHING STUDIO CONTROLLER
    // =========================================================================
    const modalWooStudio = document.getElementById('modal-woo-product-studio');
    const btnCloseWooStudio = document.getElementById('woo-close-btn');
    const btnOpenAddProduct = document.getElementById('btn-open-add-product-modal');
    const wbQuickAddBtn = document.getElementById('wb-quick-add-btn');
    const btnMainPublish = document.getElementById('woo-btn-main-publish');
    const btnSaveDraft = document.getElementById('woo-btn-save-draft');
    const btnTrash = document.getElementById('woo-btn-trash');

    // Parse all original products from embedded JSON tag
    let rawProductsMap = {};
    try {
      const rawEl = document.getElementById('bohol-raw-products-data');
      if (rawEl) {
        const rawList = JSON.parse(rawEl.textContent || '[]');
        rawList.forEach(p => {
          rawProductsMap[p.id] = p;
        });
      }
    } catch (e) {
      console.warn('Could not parse initial products data', e);
    }

    // Merge any localStorage products into the map
    function getStoredProducts() {
      try {
        return JSON.parse(localStorage.getItem('bohol_custom_products') || '[]');
      } catch (e) {
        return [];
      }
    }

    // Preload custom products from localStorage into rawProductsMap
    getStoredProducts().forEach(p => {
      rawProductsMap[p.id || p.slug] = p;
    });

    let editingProductId = null; // null if adding new, or string slug if editing

    function slugify(text) {
      return text
        .toString()
        .toLowerCase()
        .trim()
        .replace(/[\s\W-]+/g, '-')
        .replace(/^-+|-+$/g, '');
    }

    function openWooStudio(prod = null) {
      if (!modalWooStudio) return;

      const titleEl = document.getElementById('woo-prod-title');
      const slugEl = document.getElementById('woo-prod-slug');
      const descEl = document.getElementById('woo-prod-desc');
      const subtitleEl = document.getElementById('woo-prod-subtitle');
      const featuresEl = document.getElementById('woo-prod-features');
      const regPriceEl = document.getElementById('woo-regular-price');
      const salePriceEl = document.getElementById('woo-sale-price');
      const fobPriceEl = document.getElementById('woo-fob-price');
      const moqEl = document.getElementById('woo-moq');
      const skuEl = document.getElementById('woo-sku');
      const imgUrlEl = document.getElementById('woo-prod-image-url');
      const mainImgTag = document.getElementById('woo-main-img-tag');
      const modeTitleEl = document.getElementById('woo-studio-mode-title');
      const modeBadgeEl = document.getElementById('woo-mode-badge');
      const previewTopBtn = document.getElementById('woo-preview-top-btn');
      const viewFrontendBtn = document.getElementById('woo-btn-view-frontend');
      const previewBtn = document.getElementById('woo-btn-preview');
      const seriesSelect = document.getElementById('woo-series-select');

      if (prod) {
        editingProductId = prod.id || prod.slug;
        if (modeTitleEl) modeTitleEl.textContent = `编辑产品: ${prod.name}`;
        if (modeBadgeEl) modeBadgeEl.textContent = `编辑现有商品 #${editingProductId}`;
        if (titleEl) titleEl.value = prod.name || '';
        if (slugEl) slugEl.value = editingProductId;
        if (descEl) descEl.value = prod.description || '';
        if (subtitleEl) subtitleEl.value = prod.subtitle || '';
        if (featuresEl) featuresEl.value = Array.isArray(prod.features) ? prod.features.join('\n') : (prod.features || '');
        if (regPriceEl) regPriceEl.value = prod.comparePrice || '$28.00';
        if (salePriceEl) salePriceEl.value = prod.price || prod.fobPrice || '$18.50';
        if (fobPriceEl) fobPriceEl.value = prod.fobPrice || prod.price || '$16.50 - $24.00';
        if (moqEl) moqEl.value = prod.moq || '100 pcs';
        if (skuEl) skuEl.value = prod.sku || editingProductId.toUpperCase();
        if (imgUrlEl) imgUrlEl.value = prod.image || '/images/spotlight-bobi-i.webp';
        if (mainImgTag) mainImgTag.src = prod.image || '/images/spotlight-bobi-i.webp';
        if (seriesSelect && prod.category) seriesSelect.value = prod.category;

        // Match category radio
        const subcat = prod.subCategory || "Men's Toys";
        document.querySelectorAll('input[name="woo-radio-cat"]').forEach(r => {
          r.checked = r.value === subcat || r.value.includes(subcat);
        });

        // Set preview URLs
        const previewUrl = `/products/${editingProductId}/`;
        if (previewTopBtn) previewTopBtn.href = previewUrl;
        if (viewFrontendBtn) viewFrontendBtn.href = previewUrl;
        if (previewBtn) previewBtn.href = previewUrl;

        // Populate attributes table
        const tbody = document.getElementById('woo-attrs-tbody');
        if (tbody && Array.isArray(prod.specs) && prod.specs.length > 0) {
          tbody.innerHTML = prod.specs.map(s => `
            <tr>
              <td><input type="text" class="woo-attr-input attr-key" value="${s.label || ''}" /></td>
              <td><input type="text" class="woo-attr-input attr-val" value="${s.value || ''}" /></td>
              <td style="text-align:center;"><button type="button" class="woo-btn-del-attr">✕</button></td>
            </tr>
          `).join('');
        }
      } else {
        editingProductId = null;
        if (modeTitleEl) modeTitleEl.textContent = '添加新产品 (Add New Product)';
        if (modeBadgeEl) modeBadgeEl.textContent = '新增商品';
        if (titleEl) titleEl.value = '';
        if (slugEl) slugEl.value = 'new-product-' + Math.floor(Math.random() * 900 + 100);
        if (descEl) descEl.value = '';
        if (subtitleEl) subtitleEl.value = 'Precision engineered intimate wellness hardware for wholesale & automated retail.';
        if (featuresEl) featuresEl.value = 'Medical-grade platinum LSR silicone\nDual-motor synchronous drive\nIPX7 deep waterproof rating\nUSB-C high-speed recharge';
        if (regPriceEl) regPriceEl.value = '$24.00';
        if (salePriceEl) salePriceEl.value = '$16.50';
        if (fobPriceEl) fobPriceEl.value = '$16.50 - $24.00';
        if (moqEl) moqEl.value = '100 pcs';
        const randSku = 'BHL-' + Math.floor(Math.random() * 80 + 20);
        if (skuEl) skuEl.value = randSku;
        if (imgUrlEl) imgUrlEl.value = '/images/spotlight-bobi-i.webp';
        if (mainImgTag) mainImgTag.src = '/images/spotlight-bobi-i.webp';

        const previewUrl = `/products/`;
        if (previewTopBtn) previewTopBtn.href = previewUrl;
        if (viewFrontendBtn) viewFrontendBtn.href = previewUrl;
        if (previewBtn) previewBtn.href = previewUrl;
      }

      modalWooStudio.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeWooStudio() {
      if (modalWooStudio) modalWooStudio.classList.remove('active');
      document.body.style.overflow = '';
    }

    if (btnCloseWooStudio) btnCloseWooStudio.addEventListener('click', closeWooStudio);
    if (btnOpenAddProduct) btnOpenAddProduct.addEventListener('click', () => openWooStudio(null));
    if (wbQuickAddBtn) {
      wbQuickAddBtn.addEventListener('click', () => {
        switchTab('products');
        openWooStudio(null);
      });
    }

    // Vertical Tabs Switching in Product Data Metabox
    const vtabButtons = document.querySelectorAll('.woo-vtab-btn');
    const vpanels = document.querySelectorAll('.woo-vpanel');
    vtabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetTab = btn.getAttribute('data-vtab');
        vtabButtons.forEach(b => b.classList.toggle('active', b === btn));
        vpanels.forEach(p => p.classList.toggle('active', p.id === `vpanel-${targetTab}`));
      });
    });

    // Auto-generate slug from title
    const titleInput = document.getElementById('woo-prod-title');
    const slugInput = document.getElementById('woo-prod-slug');
    const btnGenSlug = document.getElementById('woo-btn-gen-slug');

    if (btnGenSlug && titleInput && slugInput) {
      btnGenSlug.addEventListener('click', () => {
        const val = titleInput.value.trim();
        if (val) slugInput.value = slugify(val);
      });
    }

    if (titleInput && slugInput) {
      titleInput.addEventListener('blur', () => {
        if (!editingProductId && (!slugInput.value || slugInput.value.startsWith('new-product-'))) {
          slugInput.value = slugify(titleInput.value) || slugInput.value;
        }
      });
    }

    // Image Preset Thumbnails Click
    const imgUrlInput = document.getElementById('woo-prod-image-url');
    const mainImgTag = document.getElementById('woo-main-img-tag');
    document.querySelectorAll('.woo-preset-thumb').forEach(thumb => {
      thumb.addEventListener('click', () => {
        const src = thumb.getAttribute('src');
        if (src) {
          if (imgUrlInput) imgUrlInput.value = src;
          if (mainImgTag) mainImgTag.src = src;
          showToast(`已选用预设图: ${src.split('/').pop()}`);
        }
      });
    });

    if (imgUrlInput && mainImgTag) {
      imgUrlInput.addEventListener('input', () => {
        mainImgTag.src = imgUrlInput.value.trim();
      });
    }

    // Local File Upload trigger
    const fileUploadBtn = document.getElementById('woo-btn-upload-file');
    const fileInput = document.getElementById('woo-local-file-input');
    if (fileUploadBtn && fileInput) {
      fileUploadBtn.addEventListener('click', () => fileInput.click());
      fileInput.addEventListener('change', (e) => {
        const file = e.target.files?.[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = (evt) => {
            const dataUrl = evt.target?.result;
            if (dataUrl) {
              if (mainImgTag) mainImgTag.src = dataUrl;
              if (imgUrlInput) imgUrlInput.value = `/images/${file.name}`;
              showToast(`本地图片 "${file.name}" 已载入预览！`);
            }
          };
          reader.readAsDataURL(file);
        }
      });
    }

    // Add Attribute Row
    const btnAddAttr = document.getElementById('woo-btn-add-attr');
    const attrsTbody = document.getElementById('woo-attrs-tbody');
    if (btnAddAttr && attrsTbody) {
      btnAddAttr.addEventListener('click', () => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><input type="text" class="woo-attr-input attr-key" placeholder="自定义属性 (如: 净重)" /></td>
          <td><input type="text" class="woo-attr-input attr-val" placeholder="规格参数 (如: 320g)" /></td>
          <td style="text-align:center;"><button type="button" class="woo-btn-del-attr">✕</button></td>
        `;
        attrsTbody.appendChild(tr);
      });
    }

    // Delete Attribute Row
    document.addEventListener('click', (e) => {
      if (e.target.classList.contains('woo-btn-del-attr')) {
        e.target.closest('tr')?.remove();
      }
    });

    // Tag Cloud Quick Add
    const tagInput = document.getElementById('woo-tag-input');
    document.querySelectorAll('.woo-tag-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        const tagText = pill.textContent.replace('+', '').trim();
        if (tagInput) {
          const current = tagInput.value ? tagInput.value.split(',').map(s => s.trim()) : [];
          if (!current.includes(tagText)) {
            current.push(tagText);
            tagInput.value = current.join(', ');
          }
        }
      });
    });

    // Toast Notification helper
    function showToast(msg) {
      const container = document.getElementById('bc-toast-container');
      if (!container) return;
      const toast = document.createElement('div');
      toast.className = 'bc-toast';
      toast.innerHTML = `<span>🔔</span> <span>${msg}</span>`;
      container.appendChild(toast);
      setTimeout(() => {
        toast.remove();
      }, 3500);
    }

    // Product Filter & Search
    const searchInput = document.getElementById('prod-search-input');
    const categorySelect = document.getElementById('prod-filter-category');
    const statusSelect = document.getElementById('prod-filter-status');
    const productsTbody = document.getElementById('products-tbody');
    const prodCounterBadge = document.getElementById('prod-counter-badge');

    function filterProducts() {
      if (!productsTbody) return;
      const query = (searchInput?.value || '').toLowerCase().trim();
      const cat = categorySelect?.value || 'ALL';
      const stat = statusSelect?.value || 'ALL';

      const rows = productsTbody.querySelectorAll('tr');
      let visibleCount = 0;

      rows.forEach(row => {
        const rowName = row.getAttribute('data-name') || '';
        const rowId = row.getAttribute('data-id') || '';
        const rowCat = row.getAttribute('data-cat') || '';
        const rowStat = row.getAttribute('data-status') || 'ACTIVE';

        const matchQuery = !query || rowName.includes(query) || rowId.includes(query);
        const matchCat = cat === 'ALL' || rowCat === cat;
        const matchStat = stat === 'ALL' || rowStat === stat;

        if (matchQuery && matchCat && matchStat) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      if (prodCounterBadge) {
        prodCounterBadge.textContent = `共 ${visibleCount} 款产品`;
      }
    }

    if (searchInput) searchInput.addEventListener('input', filterProducts);
    if (categorySelect) categorySelect.addEventListener('change', filterProducts);
    if (statusSelect) statusSelect.addEventListener('change', filterProducts);

    // Publish / Save Product
    function saveProductFromWoo(isDraft = false) {
      const title = document.getElementById('woo-prod-title')?.value.trim();
      const slug = document.getElementById('woo-prod-slug')?.value.trim() || slugify(title);
      const subtitle = document.getElementById('woo-prod-subtitle')?.value.trim();
      const description = document.getElementById('woo-prod-desc')?.value.trim();
      const features = (document.getElementById('woo-prod-features')?.value || '').split('\n').map(s => s.trim()).filter(Boolean);
      const regPrice = document.getElementById('woo-regular-price')?.value.trim() || '$28.00';
      const salePrice = document.getElementById('woo-sale-price')?.value.trim() || '$18.50';
      const fobPrice = document.getElementById('woo-fob-price')?.value.trim() || salePrice;
      const moq = document.getElementById('woo-moq')?.value.trim() || '100 pcs';
      const sku = document.getElementById('woo-sku')?.value.trim() || (slug || 'BHL').toUpperCase();
      const image = document.getElementById('woo-prod-image-url')?.value.trim() || '/images/spotlight-bobi-i.webp';
