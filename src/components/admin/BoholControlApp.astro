    function getStoredLeads() {
      const stored = localStorage.getItem('bohol_rfq_leads');
      if (!stored) {
        localStorage.setItem('bohol_rfq_leads', JSON.stringify(BENCHMARK_SEED_LEADS));
        return [...BENCHMARK_SEED_LEADS];
      }
      try {
        const parsed = JSON.parse(stored);
        if (!Array.isArray(parsed) || parsed.length === 0) {
          localStorage.setItem('bohol_rfq_leads', JSON.stringify(BENCHMARK_SEED_LEADS));
          return [...BENCHMARK_SEED_LEADS];
        }
        return parsed;
      } catch (err) {
        localStorage.setItem('bohol_rfq_leads', JSON.stringify(BENCHMARK_SEED_LEADS));
        return [...BENCHMARK_SEED_LEADS];
      }
