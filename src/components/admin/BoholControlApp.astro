---
import { getCollection } from 'astro:content';
import '../../styles/bohol-control.css';
import '../../styles/woo-product-editor.css';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const journal = (await getCollection('journal')).sort((a, b) => a.data.order - b.data.order);

function getFobPrice(prod: any) {
  if (prod.data.price) return prod.data.price;
  const cat = prod.data.category;
  if (cat === 'Electric') return '$18.50 - $28.00';
  if (cat === 'Adaptive') return '$14.20 - $21.50';
  if (cat === 'Compact') return '$9.80 - $15.00';
  return '$12.00 - $18.50';
}

function getMoq(prod: any) {
  const cat = prod.data.category;
  if (cat === 'Electric') return '50 pcs';
  if (cat === 'Adaptive') return '100 pcs';
  if (cat === 'Compact') return '200 pcs';
  return '100 pcs';
}
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>BOHOL 网站管理</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="bc-body">
  <div class="bc-layout">
    <!-- Sidebar Navigation -->
