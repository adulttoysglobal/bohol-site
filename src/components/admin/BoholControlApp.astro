          </button>
        </li>
        <li class="bc-nav-item">
          <button class="bc-nav-btn" data-tab="google">
            <span class="bc-nav-icon">🔍</span>
            <span>Google 收录</span>
          </button>
        </li>
        <li class="bc-nav-item">
          <button class="bc-nav-btn" data-tab="analytics">
            <span class="bc-nav-icon">📈</span>
            <span>访问分析</span>
          </button>
        </li>
        <li class="bc-nav-item">
          <button class="bc-nav-btn" data-tab="toolbox">
            <span class="bc-nav-icon">🧰</span>
            <span>百宝箱设置</span>
          </button>
        </li>
        <li class="bc-nav-item">
          <button class="bc-nav-btn" data-tab="security">
            <span class="bc-nav-icon">🛡️</span>
            <span>安全设置</span>
          </button>
        </li>
      </nav>

      <div style="padding: 16px 20px; border-top: 1px solid rgba(255,255,255,0.06); font-size: 11px; color: #64748b;">
        <div>网站管理系统</div>
        <div style="margin-top: 4px; color: #10b981;">● 线上连接正常</div>
      </div>
    </aside>

    <!-- Main Container -->
    <main class="bc-main">
      <!-- Topbar -->
      <div class="bc-topbar" style="display:flex; justify-content:space-between; align-items:center; padding:16px 36px;">
        <div class="bc-breadcrumbs" id="bc-breadcrumb">
          <span style="color:#64748b;">网站管理</span>
          <span style="color:#cbd5e1;">/</span>
          <span style="color:#0f172a; font-weight:700;" id="bc-current-title">工作台</span>
        </div>
        <div style="display:flex; align-items:center; gap:12px;">
          <a href="/" target="_blank" class="bc-btn-secondary bc-btn-sm" style="text-decoration:none;">
            <span>网站前台</span>
            <span style="font-size:11px;">↗</span>
          </a>
          <button type="button" class="bc-btn-secondary bc-btn-sm" id="btn-refresh-data">
            <span>刷新数据 ↻</span>
          </button>
          <div style="display:flex; align-items:center; gap:8px; margin-left:12px; padding-left:12px; border-left:1px solid #e2e8f0;">
            <div style="width:28px; height:28px; border-radius:50%; background:#2563eb; color:#fff; display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:700;">
              AD
            </div>
            <span style="font-size:13px; font-weight:600; color:#334155;">Admin</span>
          </div>
        </div>
      </div>

      <!-- Main Tab Panels -->
      <div class="bc-content">

        <!-- ========================================== -->
        <!-- TAB 1: 工作台 (Workbench - Screenshot 1 & 2) -->
        <!-- ========================================== -->
        <div class="bc-panel active" id="panel-workbench">
          <div class="bc-page-header">
            <div class="bc-page-title">
              <h1>工作台</h1>
              <p>管理总体内容，监控发布状态和服务连接。</p>
            </div>
            <div>
              <button class="bc-btn-primary" id="wb-quick-add-btn">
                <span>+ 新建产品</span>
              </button>
            </div>
          </div>

          <!-- 3 KPI Cards matching Screenshot 1 -->
          <div class="bc-kpi-row">
            <div class="bc-kpi-card">
              <div class="bc-kpi-title">产品内容</div>
              <div class="bc-kpi-num" id="kpi-product-count">{products.length}</div>
              <div class="bc-kpi-desc">中英文产品总数</div>
            </div>

            <div class="bc-kpi-card">
              <div class="bc-kpi-title">文章内容</div>
              <div class="bc-kpi-num">{journal.length}</div>
              <div class="bc-kpi-desc">已发布国际化文章</div>
            </div>

            <div class="bc-kpi-card">
              <div class="bc-kpi-title">客户单据</div>
              <div class="bc-kpi-num" id="kpi-lead-count">0</div>
              <div class="bc-kpi-desc">未处理询盘</div>
            </div>
          </div>

          <!-- Umami 访问数据内嵌报表 matching Screenshot 1 & 2 -->
          <div class="bc-card">
            <div class="bc-card-head" style="margin-bottom:6px;">
              <div class="bc-card-title">
                <h3>访问数据</h3>
                <p>Umami 已接入主站，下面直接显示实时流量和国家来源。</p>
              </div>
              <div>
                <a href="https://stats.boholvending.com" target="_blank" class="text-link" style="color:#2563eb; font-size:13px; font-weight:600; text-decoration:none;">
                  打开访问分析页 &rarr;
                </a>
              </div>
            </div>

            <!-- Umami Authentic Container matching Screenshot 1 -->
            <div class="bc-umami-embed">
              <!-- Left Sidebar of Umami -->
              <div class="bc-umami-side">
                <div style="font-weight:700; color:#0f172a; margin-bottom:8px; display:flex; align-items:center; gap:6px;">
                  <span style="font-size:14px;">●</span> umami
                </div>
                <div style="font-size:11px; color:#94a3b8; font-weight:700; margin-top:4px;">Traffic</div>
                <div class="bc-umami-side-item active">👁 Overview</div>
                <div class="bc-umami-side-item">⚡ Events</div>
                <div class="bc-umami-side-item">👥 Sessions</div>
                <div class="bc-umami-side-item">⏱ Realtime</div>
                <div class="bc-umami-side-item">⚡ Performance</div>
                <div class="bc-umami-side-item">⚖ Compare</div>
                <div class="bc-umami-side-item">📊 Breakdown</div>
              </div>

              <!-- Main Dashboard Area of Umami -->
              <div class="bc-umami-main">
                <div style="display:flex; justify-content:space-between; align-items:center; padding-bottom:12px; border-bottom:1px solid #edf2f7; margin-bottom:16px;">
                  <div style="font-size:15px; font-weight:700; color:#1a202c;">■ BOHOL Website</div>
                  <div style="display:flex; align-items:center; gap:8px;">
                    <span class="bc-btn-secondary bc-btn-sm" style="font-size:11px; padding:3px 8px;">Filter</span>
                    <span class="bc-btn-secondary bc-btn-sm" style="font-size:11px; padding:3px 8px;">&lt; &gt;</span>
                    <span class="bc-btn-secondary bc-btn-sm" style="font-size:11px; padding:3px 8px;">Last 24 hours</span>
                  </div>
                </div>

                <!-- 5 Real Metrics from Screenshot 1 -->
                <div class="bc-analytics-metrics" style="grid-template-columns:repeat(5, 1fr); margin-bottom:16px;">
                  <div class="bc-metric-card">
                    <div class="bc-metric-label">Visitors</div>
                    <div class="bc-metric-value" style="font-size:22px;">6</div>
                    <div class="bc-metric-change up" style="font-size:11px;">↑ 50%</div>
                  </div>
                  <div class="bc-metric-card">
                    <div class="bc-metric-label">Visits</div>
                    <div class="bc-metric-value" style="font-size:22px;">6</div>
                    <div class="bc-metric-change up" style="font-size:11px;">↑ 20%</div>
                  </div>
                  <div class="bc-metric-card">
                    <div class="bc-metric-label">Views</div>
                    <div class="bc-metric-value" style="font-size:22px;">8</div>
                    <div class="bc-metric-change down" style="font-size:11px;">↓ 68%</div>
                  </div>
                  <div class="bc-metric-card">
                    <div class="bc-metric-label">Bounce rate</div>
                    <div class="bc-metric-value" style="font-size:22px;">83%</div>
                    <div class="bc-metric-change down" style="font-size:11px;">↑ 38%</div>
                  </div>
                  <div class="bc-metric-card">
                    <div class="bc-metric-label">Visit duration</div>
                    <div class="bc-metric-value" style="font-size:22px;">10s</div>
                    <div class="bc-metric-change up" style="font-size:11px;">↑ 96%</div>
                  </div>
                </div>

                <!-- Chart Bar -->
                <div style="height:60px; display:flex; align-items:flex-end; border-bottom:1px solid #edf2f7; padding-bottom:8px; margin-bottom:16px;">
                  <div style="flex:1; height:100%; display:flex; align-items:flex-end; justify-content:flex-end; padding-right:20px;">
                    <div style="width:24px; height:80%; background:#90cdf4; border-radius:3px 3px 0 0;" title="Recent: 6 visitors"></div>
                  </div>
                </div>

                <!-- Country table from Screenshot 1 & 2 -->
                <div class="bc-table-wrap">
                  <table class="bc-table" style="font-size:12px;">
                    <thead>
                      <tr>
                        <th>Country</th>
                        <th style="width:100px;">Visitors</th>
                        <th style="width:100px;">Visits</th>
                        <th style="width:100px;">Views</th>
                        <th style="width:110px;">Bounce rate</th>
                        <th style="width:110px;">Visit duration</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr>
                        <td><strong>🇺🇸 United States</strong></td>
                        <td>4</td>
                        <td>4</td>
                        <td>4</td>
                        <td>100%</td>
                        <td>0s</td>
                      </tr>
                      <tr>
                        <td><strong>🇩🇰 Denmark</strong></td>
                        <td>1</td>
                        <td>1</td>
                        <td>3</td>
                        <td>0%</td>
                        <td>1m 1s</td>
                      </tr>
                      <tr>
                        <td><strong>🇫🇷 France</strong></td>
                        <td>1</td>
                        <td>1</td>
                        <td>1</td>
                        <td>100%</td>
                        <td>0s</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

            <div style="margin-top:10px; font-size:12px; color:#718096;">
              新系统只统计接入后的访问，历史 GA 数据不会自动导入。
            </div>
          </div>

          <!-- 开始管理 matching Screenshot 2 -->
          <div class="bc-card">
            <div class="bc-card-title">
              <h3>开始管理</h3>
              <p>产品名称、正文与 SEO 文章请填写英文，保存后的内容需要网站重新部署，才能更新线上页面。</p>
            </div>
            <div style="display:flex; gap:16px; margin-top:14px;">
              <button class="bc-btn-secondary" data-action="go-products" style="color:#2563eb; font-weight:600;">
                管理产品 &rarr;
              </button>
              <button class="bc-btn-secondary" data-action="go-articles" style="color:#2563eb; font-weight:600;">
                管理文章 &rarr;
              </button>
            </div>
          </div>

          <!-- 接入进度 matching Screenshot 2 -->
          <div class="bc-card">
            <div class="bc-card-title">
              <h3>接入进度</h3>
            </div>
            <div style="display:flex; flex-direction:column; gap:8px; margin-top:12px; font-size:13px; color:#4a5568;">
              <div><strong>留言:</strong> 目前通过邮件表单发送，尚无后台收件箱。</div>
              <div><strong>聊天:</strong> 目前为预设自动回复，尚无客服消息存储。</div>
              <div><strong>Umami:</strong> 统计代码、HTTPS、分享报表和工作台内嵌报表已接入。</div>
            </div>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- TAB 2: 产品管理 · 模块1 (Product Management) -->
        <!-- ========================================== -->
        <div class="bc-panel" id="panel-products">
          <div class="bc-page-header">
            <div class="bc-page-title">
              <h1>产品管理 · 模块1</h1>
              <p>管理全站 {products.length} 款产品，支持修改价格、起订量、规格参数、上架状态与直接新建发布产品</p>
            </div>
            <div style="display:flex; gap:10px;">
              <button class="bc-btn-secondary" id="btn-export-products-csv">
                <span>导出 CSV 清单</span>
              </button>
              <button class="bc-btn-primary" id="btn-open-add-product-modal">
                <span>+ 新建产品</span>
              </button>
            </div>
          </div>

          <!-- Product Filters Toolbar -->
          <div class="bc-card" style="padding:16px 20px; margin-bottom:16px;">
            <div style="display:flex; gap:16px; flex-wrap:wrap; align-items:center; justify-content:space-between;">
              <div style="display:flex; gap:12px; flex:1; min-width:280px; align-items:center;">
                <div style="position:relative; flex:1; max-width:360px;">
                  <input type="text" class="bc-input" id="prod-search-input" placeholder="搜索产品名称、型号或关键词..." style="padding-left:32px;" />
                  <span style="position:absolute; left:10px; top:50%; transform:translateY(-50%); color:#94a3b8; font-size:14px;">🔍</span>
                </div>
                <select class="bc-select" id="prod-filter-category" style="width:180px;">
                  <option value="ALL">全部分类 (全部)</option>
                  <option value="Electric">Electric 电动系列</option>
                  <option value="Adaptive">Adaptive 自适应系列</option>
                  <option value="Compact">Compact 紧凑系列</option>
                  <option value="Sculpted">Sculpted 匠心雕花系列</option>
                </select>
                <select class="bc-select" id="prod-filter-status" style="width:140px;">
                  <option value="ALL">全部状态</option>
                  <option value="ACTIVE">已上架</option>
                  <option value="DRAFT">草稿 / 已下架</option>
                </select>
              </div>
              <div>
                <span class="bc-badge bc-badge-neutral" id="prod-counter-badge" style="font-size:12px; padding:6px 12px;">
                  共 {products.length} 款产品
                </span>
              </div>
            </div>
          </div>

          <!-- Product Table -->
          <div class="bc-card" style="padding:0; overflow:hidden;">
            <div class="bc-table-wrap" style="border:none;">
              <table class="bc-table" id="products-table">
                <thead>
                  <tr>
                    <th style="width:70px; text-align:center;">缩略图</th>
                    <th style="min-width:220px;">产品名称 & 编号</th>
                    <th style="width:120px;">所属分类</th>
                    <th style="width:100px;">起订量 MOQ</th>
                    <th style="width:140px;">批发参考价 (USD)</th>
                    <th style="width:100px; text-align:center;">上架状态</th>
                    <th style="width:160px; text-align:center;">操作</th>
                  </tr>
                </thead>
                <tbody id="products-tbody">
                  {products.map(p => (
                    <tr data-id={p.id} data-cat={p.data.category} data-name={p.data.name.toLowerCase()} data-status="ACTIVE">
                      <td style="text-align:center;">
                        <img src={p.data.image} alt={p.data.name} style="width:44px; height:44px; object-fit:cover; border-radius:6px; border:1px solid #e2e8f0; background:#f8fafc;" loading="lazy" />
                      </td>
                      <td>
                        <strong style="color:#0f172a; font-size:13px;">{p.data.name}</strong>
                        <div style="font-size:11px; color:#64748b; margin-top:2px;">
                          <code>{p.id}</code> &bull; <span style="color:#2563eb;">{p.data.label}</span>
                        </div>
                      </td>
                      <td>
                        <span class="bc-badge bc-badge-info">{p.data.category}</span>
                      </td>
                      <td>
                        <span style="font-weight:600; font-size:12px;">{getMoq(p)}</span>
                      </td>
                      <td>
                        <span style="font-weight:700; color:#10b981; font-size:13px;">{getFobPrice(p)}</span>
                      </td>
                      <td style="text-align:center;">
                        <label class="bc-switch">
                          <input type="checkbox" checked class="prod-status-toggle" data-id={p.id} />
                          <span class="bc-slider"></span>
                        </label>
                      </td>
                      <td style="text-align:center;">
                        <div style="display:flex; justify-content:center; gap:6px;">
                          <a href={`/products/${p.id}/`} target="_blank" class="bc-btn-secondary bc-btn-sm" title="在前台打开详情页">
                            <span>前台 ↗</span>
                          </a>
                          <button type="button" class="bc-btn-secondary bc-btn-sm btn-edit-prod" data-id={p.id} data-name={p.data.name}>
                            <span>编辑</span>
                          </button>
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- TAB 3: 文章与新闻 (Articles & News) -->
        <!-- ========================================== -->
        <div class="bc-panel" id="panel-articles">
          <div class="bc-page-header">
            <div class="bc-page-title">
              <h1>文章与新闻</h1>
              <p>品牌已发布国际化文章（共 {journal.length} 篇）</p>
            </div>
            <div>
              <button class="bc-btn-primary" id="btn-add-article">
                <span>+ 新建文章</span>
              </button>
            </div>
          </div>

          <div class="bc-card" style="padding:0; overflow:hidden;">
            <div class="bc-table-wrap" style="border:none;">
              <table class="bc-table">
                <thead>
                  <tr>
                    <th style="width:60px; text-align:center;">序号</th>
                    <th>文章标题</th>
                    <th style="width:140px;">分类</th>
                    <th style="width:120px;">阅读时间</th>
                    <th style="width:100px; text-align:center;">发布状态</th>
                    <th style="width:140px; text-align:center;">操作</th>
                  </tr>
                </thead>
                <tbody>
                  {journal.map((art, idx) => (
                    <tr>
                      <td style="text-align:center; color:#94a3b8; font-weight:700;">{idx + 1}</td>
                      <td>
                        <strong style="color:#0f172a; font-size:13px;">{art.data.title}</strong>
                        <p style="margin:2px 0 0; font-size:12px; color:#64748b;">{art.data.description}</p>
                      </td>
                      <td>
                        <span class="bc-badge bc-badge-info">{art.data.category}</span>
                      </td>
                      <td>
                        <span style="font-size:12px; color:#64748b;">{art.data.readTime}</span>
                      </td>
                      <td style="text-align:center;">
                        <span class="bc-badge bc-badge-success">已发布</span>
                      </td>
                      <td style="text-align:center;">
                        <div style="display:flex; justify-content:center; gap:6px;">
                          <a href={`/journal/${art.id}/`} target="_blank" class="bc-btn-secondary bc-btn-sm">
                            <span>前台 ↗</span>
                          </a>
                          <button type="button" class="bc-btn-secondary bc-btn-sm" onclick="alert('文章在线编辑器就绪')">
                            <span>编辑</span>
                          </button>
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- TAB 4: 留言与聊天 (Inquiries & Chat) -->
        <!-- ========================================== -->
        <div class="bc-panel" id="panel-inquiries">
          <div class="bc-page-header">
            <div class="bc-page-title">
              <h1>单据与客户留言 (Inquiries & Chat)</h1>
              <p>查看前台买家通过多选报价单、询盘购物车及工厂定制表单提交的真实采购需求。</p>
            </div>
            <div style="display:flex; gap:10px; align-items:center;">
              <button class="bc-btn-secondary" id="btn-export-rfq-csv">
                <span>导出 CSV 报表</span>
              </button>
              <button class="bc-btn-secondary" id="btn-reset-seed-rfq" style="font-size:12px;" title="恢复至默认3笔基准外贸询盘">
                <span>重置示例单据 ↺</span>
              </button>
            </div>
          </div>

          <div class="bc-card" style="padding:0; overflow:hidden;">
            <div class="bc-table-wrap" style="border:none;">
              <table class="bc-table" id="inquiries-table">
