                    <img class="woo-preset-thumb" src="/images/spotlight-summer.webp" alt="Summer Rabbit" title="Summer Rabbit" />
                    <img class="woo-preset-thumb" src="/images/spotlight-bite.webp" alt="Bite" title="Bite" />
                    <img class="woo-preset-thumb" src="/images/spotlight-xiaoqiao.webp" alt="Xiaoqiao" title="Xiaoqiao" />
                    <img class="woo-preset-thumb" src="/images/spotlight-mengqu.webp" alt="Mengqu" title="Mengqu" />
