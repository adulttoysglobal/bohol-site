              <div class="woo-tags-input-row">
                <input type="text" class="woo-input-text" id="woo-tag-input" placeholder="输入标签，以逗号分隔" value="LSR-Silicone, Dual-Motor, IPX7" />
                <button type="button" class="woo-btn-draft" id="woo-btn-add-tag">添加</button>
              </div>
              <div class="woo-popular-tags-cloud" id="woo-tags-cloud">
                <span class="woo-tag-pill">+ USB-C</span>
                <span class="woo-tag-pill">+ Low-Noise</span>
                <span class="woo-tag-pill">+ 100-MOQ</span>
                <span class="woo-tag-pill">+ OEM-Ready</span>
                <span class="woo-tag-pill">+ Medical-Grade</span>
                <span class="woo-tag-pill">+ Waterproof</span>
