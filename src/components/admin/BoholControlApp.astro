    features: p.data.features || [],
    specs: p.data.specs || [],
    detailImages: p.data.detailImages || [],
    highlights: p.data.highlights || [],
    seoTitle: p.data.seoTitle || p.data.name,
    seoDescription: p.data.seoDescription || p.data.subtitle,
    featured: p.data.featured ?? true,
    order: p.data.order || 0
  })))} />

