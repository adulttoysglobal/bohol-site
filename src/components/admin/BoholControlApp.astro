          <!-- 4. 产品分类 (Product Categories) -->
          <div class="woo-postbox">
            <div class="woo-postbox-header">
              <h3>产品分类 (Product Categories)</h3>
            </div>
            <div class="woo-postbox-inside">
              <div class="woo-cat-tabs">
                <button type="button" class="woo-cat-tab-btn active">所有分类</button>
                <button type="button" class="woo-cat-tab-btn">最常用</button>
