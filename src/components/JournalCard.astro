---
import Icon from './Icon.astro';
const { article } = Astro.props;
const pubDateStr = article.data.pubDate
  ? new Date(article.data.pubDate).toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric'
    })
  : 'Oct 14, 2026';
---
<a class="journal-card" href={`/journal/${article.id}/`} title={article.data.title}>
  <div class="journal-image">
    <img
      src={article.data.image}
      alt={article.data.title}
      width="800"
      height="800"
      loading="lazy"
    />
    <span class="journal-cat-pill">{article.data.category}</span>
  </div>
  <div class="journal-meta">
    <span class="journal-date">📅 {pubDateStr}</span>
    <span class="journal-readtime">⏱️ {article.data.readTime}</span>
  </div>
  <h3>{article.data.title}</h3>
  <p class="journal-summary">{article.data.description}</p>
  <span class="journal-read">
    <span>Read Full Analysis</span>
    <Icon name="arrow-up-right" size={16} />
  </span>
</a>

<style>
  .journal-card {
    background: #ffffff;
    border: 1px solid var(--line-strong);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
  }
  .journal-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 28px rgba(15, 23, 42, 0.09);
    border-color: var(--accent);
  }
  .journal-image {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #f8fafc;
  }
  .journal-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .journal-card:hover .journal-image img {
    transform: scale(1.04);
  }
  .journal-cat-pill {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(15, 23, 42, 0.85);
    color: #38bdf8;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 6px;
    backdrop-filter: blur(6px);
  }
  .journal-meta {
    padding: 16px 20px 6px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 11.5px;
    color: var(--text-muted);
    font-weight: 600;
  }
  .journal-card h3 {
    padding: 0 20px 8px;
    font-size: 17px;
    font-weight: 800;
    line-height: 1.35;
    color: var(--navy-dark);
    margin: 0;
  }
  .journal-summary {
    padding: 0 20px 16px;
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .journal-read {
    padding: 12px 20px;
    border-top: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--accent);
    background: #fafbfc;
  }
</style>
