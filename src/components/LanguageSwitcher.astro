---
/**
 * BOHOL Smart Multi-Language Localization Engine & Switcher
 *
 * Supported Technologies:
 * 1. navigator.languages / navigator.language vector matching
 * 2. Intl.DateTimeFormat().resolvedOptions().timeZone GEO heuristics
 * 3. Persistent memory via localStorage ('bohol_user_lang') & cookies ('googtrans')
 * 4. Non-intrusive Geo-Detection Recommendation Banner (Apple / Nike international UX pattern)
 * 5. Clean, zero-banner Google Neural Translation integration
 */

const languages = [
  { code: 'en', label: 'English', flag: '🇬🇧', region: 'Global' },
  { code: 'es', label: 'Español', flag: '🇪🇸', region: 'Spain & LATAM' },
  { code: 'de', label: 'Deutsch', flag: '🇩🇪', region: 'Germany / Austria' },
  { code: 'fr', label: 'Français', flag: '🇫🇷', region: 'France / Europe' },
  { code: 'ru', label: 'Русский', flag: '🇷🇺', region: 'Russia & CIS' },
  { code: 'ar', label: 'العربية', flag: '🇸🇦', region: 'Middle East' },
  { code: 'ja', label: '日本語', flag: '🇯🇵', region: 'Japan' },
  { code: 'pt', label: 'Português', flag: '🇵🇹', region: 'Brazil & Portugal' },
  { code: 'zh-CN', label: '简体中文', flag: '🇨🇳', region: 'China / APAC' },
  { code: 'it', label: 'Italiano', flag: '🇮🇹', region: 'Italy' }
];
---

<!-- Header Language Dropdown Box -->
<div class="sf-language-box" id="bohol-lang-selector-container">
  <button type="button" class="sf-lang-btn" id="bohol-lang-current-btn" aria-haspopup="true" aria-expanded="false" title="Select Website Language" aria-label="Select Website Language">
    <span class="sf-lang-globe">🌐</span>
    <span class="sf-lang-current-label" id="bohol-lang-active-label">EN</span>
    <svg class="sf-lang-chevron" width="8" height="8" viewBox="0 0 448 512" fill="currentColor" aria-hidden="true">
      <path d="M207.029 381.476L12.686 187.132c-9.373-9.373-9.373-24.569 0-33.941l22.667-22.667c9.357-9.357 24.522-9.375 33.901-.04L224 284.505l154.745-154.021c9.379-9.335 24.544-9.317 33.901.04l22.667 22.667c9.373 9.373 9.373 24.569 0 33.941L240.971 381.476c-9.373 9.372-24.569 9.372-33.942 0z"/>
    </svg>
  </button>

  <div class="sf-lang-dropdown" id="bohol-lang-dropdown-menu">
    <div class="sf-lang-dropdown-header">
      <span>Global Language / Region</span>
    </div>
    <ul class="sf-lang-list">
      {languages.map((lang) => (
        <li>
          <button type="button" class="sf-lang-option" data-lang={lang.code}>
            <span class="sf-lang-flag">{lang.flag}</span>
            <span class="sf-lang-name">{lang.label}</span>
            <span class="sf-lang-code">{lang.code.toUpperCase()}</span>
          </button>
        </li>
      ))}
    </ul>
  </div>
</div>

<!-- Non-Intrusive Smart Geo-Language Recommendation Toast -->
<aside class="geo-lang-toast" id="bohol-geo-lang-toast" hidden aria-live="polite">
  <div class="geo-toast-inner">
    <span class="geo-toast-icon" id="geo-toast-flag">🌐</span>
    <div class="geo-toast-content">
      <strong id="geo-toast-title">Language Recommendation</strong>
      <p id="geo-toast-msg">We detected your region preference. Would you like to view BOHOL in your local language?</p>
    </div>
    <div class="geo-toast-actions">
      <button type="button" class="geo-toast-accept-btn" id="geo-toast-accept-btn">Switch Language</button>
      <button type="button" class="geo-toast-dismiss-btn" id="geo-toast-dismiss-btn">Keep English</button>
    </div>
    <button type="button" class="geo-toast-close" id="geo-toast-close-btn" aria-label="Close notification">&times;</button>
  </div>
</aside>

<!-- Hidden Google Translate Element -->
<div id="google_translate_element" style="display:none;" aria-hidden="true"></div>

<style>
  /* ==========================================================================
     LANGUAGE SELECTOR & DROPDOWN STYLES (Pure White High-End B2B Theme)
     ========================================================================== */
  .sf-language-box {
    position: relative;
    display: inline-block;
  }

  .sf-lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #ffffff;
    border: 1px solid var(--line-strong, #cbd5e1);
    color: #0f172a;
    font-size: 12.5px;
    font-weight: 700;
    padding: 6px 10px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .sf-lang-btn:hover {
    background: #f8fafc;
    border-color: #2563eb;
    color: #2563eb;
  }

  .sf-lang-globe {
    font-size: 14px;
    line-height: 1;
  }

  .sf-lang-chevron {
    transition: transform 0.2s ease;
    opacity: 0.7;
  }

  .sf-language-box.is-open .sf-lang-chevron {
    transform: rotate(180deg);
  }

  .sf-lang-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: 220px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    box-shadow: 0 16px 36px -8px rgba(15, 23, 42, 0.16);
    padding: 8px 0;
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sf-language-box.is-open .sf-lang-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .sf-lang-dropdown-header {
    padding: 8px 16px 6px;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #64748b;
    border-bottom: 1px solid #f1f5f9;
  }

  .sf-lang-list {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    max-height: 320px;
    overflow-y: auto;
  }

  .sf-lang-list li {
    margin: 0;
    padding: 0;
  }

  .sf-lang-option {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    background: transparent;
    border: none;
    text-align: left;
    font-size: 13px;
    font-weight: 600;
    color: #1e293b;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .sf-lang-option:hover {
    background: #f1f5f9;
    color: #2563eb;
  }

  .sf-lang-option.is-active {
    background: #eff6ff;
    color: #2563eb;
    font-weight: 700;
  }

  .sf-lang-flag {
    font-size: 15px;
    line-height: 1;
  }

  .sf-lang-name {
    flex-grow: 1;
  }

  .sf-lang-code {
    font-size: 10.5px;
    font-weight: 700;
    color: #475569;
    background: #f8fafc;
    padding: 2px 5px;
    border-radius: 4px;
  }

  /* ==========================================================================
     GEO-LANGUAGE RECOMMENDATION TOAST (Apple / Nike International Pattern)
     ========================================================================== */
  .geo-lang-toast {
    position: fixed;
    bottom: 24px;
    right: 24px;
    max-width: 440px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    box-shadow: 0 20px 45px -10px rgba(15, 23, 42, 0.22);
    z-index: 9999;
    padding: 16px 20px;
    animation: toast-slide-up 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes toast-slide-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .geo-toast-inner {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    position: relative;
  }

  .geo-toast-icon {
    font-size: 24px;
    line-height: 1;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .geo-toast-content {
    flex-grow: 1;
  }

  .geo-toast-content strong {
    display: block;
    font-size: 14px;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 3px;
  }

  .geo-toast-content p {
    font-size: 12.5px;
    color: #64748b;
    line-height: 1.45;
    margin: 0 0 10px;
  }

  .geo-toast-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .geo-toast-accept-btn {
    background: #2563eb;
    color: #ffffff;
    border: none;
    padding: 6px 14px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .geo-toast-accept-btn:hover {
    background: #1d4ed8;
  }

  .geo-toast-dismiss-btn {
    background: #f1f5f9;
    color: #475569;
    border: none;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .geo-toast-dismiss-btn:hover {
    background: #e2e8f0;
    color: #0f172a;
  }

  .geo-toast-close {
    position: absolute;
    top: -6px;
    right: -8px;
    background: transparent;
    border: none;
    font-size: 18px;
    line-height: 1;
    color: #475569;
    cursor: pointer;
    padding: 4px;
  }

  .geo-toast-close:hover {
    color: #0f172a;
  }

  @media (max-width: 600px) {
    .geo-lang-toast {
      left: 16px;
      right: 16px;
      bottom: 16px;
      max-width: none;
    }
  }

  /* Hide Google Translate Banner and Iframe artifacts */
  :global(.goog-te-banner-frame.skiptranslate),
  :global(.goog-te-gadget-icon),
  :global(#goog-gt-tt),
  :global(.goog-te-balloon-frame) {
    display: none !important;
    visibility: hidden !important;
  }
  :global(body) {
    top: 0px !important;
  }
  :global(.goog-tooltip) {
    display: none !important;
  }
  :global(.goog-text-highlight) {
    background-color: transparent !important;
    border: none !important;
    box-shadow: none !important;
  }
</style>

<script is:inline>
  // Languages Definition Dictionary
  const BOHOL_LANGS = {
    'en': { name: 'English', flag: '🇬🇧', label: 'EN' },
    'es': { name: 'Español', flag: '🇪🇸', label: 'ES', prompt: 'Detectamos que nos visitas desde un país de habla hispana. ¿Deseas ver la página en Español?' },
    'de': { name: 'Deutsch', flag: '🇩🇪', label: 'DE', prompt: 'Wir haben festgestellt, dass Sie aus dem deutschsprachigen Raum zugreifen. Möchten Sie die Seite auf Deutsch anzeigen?' },
    'fr': { name: 'Français', flag: '🇫🇷', label: 'FR', prompt: 'Nous avons détecté que vous visitez depuis une région francophone. Souhaitez-vous afficher le site en Français ?' },
    'ru': { name: 'Русский', flag: '🇷🇺', label: 'RU', prompt: 'Мы заметили, что вы зашли из русскоязычного региона. Переключить сайт на русский язык?' },
    'ar': { name: 'العربية', flag: '🇸🇦', label: 'AR', prompt: 'لاحظنا أنك تتصفح من منطقة ناطقة بالعربية. هل ترغب في تصفح الموقع باللغة العربية؟' },
    'ja': { name: '日本語', flag: '🇯🇵', label: 'JA', prompt: '日本語圏からのアクセスを検出しました。サイトを日本語で表示しますか？' },
    'pt': { name: 'Português', flag: '🇵🇹', label: 'PT', prompt: 'Detectamos que você está acessando de uma região de língua portuguesa. Deseja visualizar o site em Português?' },
    'zh-CN': { name: '简体中文', flag: '🇨🇳', label: '中', prompt: '检测到您的浏览器为中文环境，是否切换至中文界面？' },
    'it': { name: 'Italiano', flag: '🇮🇹', label: 'IT', prompt: 'Abbiamo rilevato che visiti da una regione italiana. Vuoi visualizzare il sito in Italiano?' }
  };

  /**
   * Smart GEO & Browser Technology Identification
   * Combines navigator.languages vector with Intl.DateTimeFormat timezone heuristics.
   */
  function detectClientPreferredLanguage() {
    // 1. Check navigator.languages (order of preference)
    const browserLangs = navigator.languages || [navigator.language || navigator.userLanguage || 'en'];
    for (const raw of browserLangs) {
      const code = raw.toLowerCase();
      if (code.startsWith('zh')) return 'zh-CN';
      if (code.startsWith('es')) return 'es';
      if (code.startsWith('de')) return 'de';
      if (code.startsWith('fr')) return 'fr';
      if (code.startsWith('ru')) return 'ru';
      if (code.startsWith('ja')) return 'ja';
      if (code.startsWith('ar')) return 'ar';
      if (code.startsWith('pt')) return 'pt';
      if (code.startsWith('it')) return 'it';
      if (code.startsWith('en')) return 'en';
    }

    // 2. Fallback to Timezone Heuristics
    try {
      const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
      if (tz.includes('Berlin') || tz.includes('Vienna') || tz.includes('Zurich')) return 'de';
      if (tz.includes('Madrid') || tz.includes('Mexico') || tz.includes('Bogota') || tz.includes('Buenos_Aires') || tz.includes('Santiago')) return 'es';
      if (tz.includes('Paris') || tz.includes('Brussels') || tz.includes('Montreal')) return 'fr';
      if (tz.includes('Moscow') || tz.includes('Minsk') || tz.includes('Almaty') || tz.includes('Yekaterinburg')) return 'ru';
      if (tz.includes('Tokyo')) return 'ja';
      if (tz.includes('Riyadh') || tz.includes('Dubai') || tz.includes('Cairo')) return 'ar';
      if (tz.includes('Sao_Paulo') || tz.includes('Lisbon')) return 'pt';
      if (tz.includes('Shanghai') || tz.includes('Taipei') || tz.includes('Hong_Kong') || tz.includes('Chongqing')) return 'zh-CN';
      if (tz.includes('Rome')) return 'it';
    } catch (e) {}

    return 'en';
  }

  /**
   * Set Google Translate Cookie & Refresh Page or Trigger DOM Translation
   */
  function applyLanguage(targetLang, reload = true) {
    if (!targetLang) return;
    localStorage.setItem('bohol_user_lang', targetLang);

    // Set cookie for Google Translate element
    const cookieVal = targetLang === 'en' ? '' : `/en/${targetLang}`;
    document.cookie = `googtrans=${cookieVal}; path=/; domain=${location.hostname};`;
    document.cookie = `googtrans=${cookieVal}; path=/;`;

    // Update active label in UI
    const info = BOHOL_LANGS[targetLang] || BOHOL_LANGS['en'];
    const activeLabel = document.getElementById('bohol-lang-active-label');
    if (activeLabel) activeLabel.textContent = info.label;

    // Highlight active option
    document.querySelectorAll('.sf-lang-option').forEach(btn => {
      btn.classList.toggle('is-active', btn.getAttribute('data-lang') === targetLang);
    });

    if (reload) {
      location.reload();
    }
  }

  /**
   * Initialize Language Engine on DOM Loaded
   */
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('bohol-lang-selector-container');
    const toggleBtn = document.getElementById('bohol-lang-current-btn');
    const toast = document.getElementById('bohol-geo-lang-toast');
    const savedLang = localStorage.getItem('bohol_user_lang');

    // 1. Toggle dropdown
    if (toggleBtn && container) {
      toggleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = container.classList.toggle('is-open');
        toggleBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });

      document.addEventListener('click', (e) => {
        if (!container.contains(e.target)) {
          container.classList.remove('is-open');
          toggleBtn.setAttribute('aria-expanded', 'false');
        }
      });
    }

    // 2. Bind language click options
    document.querySelectorAll('.sf-lang-option').forEach(btn => {
      btn.addEventListener('click', () => {
        const lang = btn.getAttribute('data-lang');
        if (lang) {
          applyLanguage(lang, true);
        }
      });
    });

    // 3. Sync UI with current saved language
    const currentActive = savedLang || 'en';
    const activeInfo = BOHOL_LANGS[currentActive] || BOHOL_LANGS['en'];
    const activeLabel = document.getElementById('bohol-lang-active-label');
    if (activeLabel) activeLabel.textContent = activeInfo.label;
    document.querySelectorAll('.sf-lang-option').forEach(btn => {
      btn.classList.toggle('is-active', btn.getAttribute('data-lang') === currentActive);
    });

    // 4. Smart Geo-Recommendation Toast for First-Time Non-English Visitors
    const hasPrompted = sessionStorage.getItem('bohol_geo_prompted');
    if (!savedLang && !hasPrompted) {
      const detected = detectClientPreferredLanguage();
      if (detected !== 'en' && BOHOL_LANGS[detected]) {
        const langInfo = BOHOL_LANGS[detected];
        const flagEl = document.getElementById('geo-toast-flag');
        const titleEl = document.getElementById('geo-toast-title');
        const msgEl = document.getElementById('geo-toast-msg');
        const acceptBtn = document.getElementById('geo-toast-accept-btn');
        const dismissBtn = document.getElementById('geo-toast-dismiss-btn');
        const closeBtn = document.getElementById('geo-toast-close-btn');

        if (toast && flagEl && titleEl && msgEl && acceptBtn) {
          flagEl.textContent = langInfo.flag;
          titleEl.textContent = `Switch to ${langInfo.name}?`;
          msgEl.textContent = langInfo.prompt || `We detected your language preference. Would you like to view BOHOL in ${langInfo.name}?`;
          acceptBtn.textContent = `Switch to ${langInfo.name} (${langInfo.flag})`;

          toast.hidden = false;
          sessionStorage.setItem('bohol_geo_prompted', 'true');

          acceptBtn.addEventListener('click', () => {
            toast.hidden = true;
            ensureGoogleTranslate();
            applyLanguage(detected, true);
          });

          const dismiss = () => {
            toast.hidden = true;
            localStorage.setItem('bohol_user_lang', 'en');
          };

          if (dismissBtn) dismissBtn.addEventListener('click', dismiss);
          if (closeBtn) closeBtn.addEventListener('click', dismiss);
        }
      }
    }

    // Lazy load Google Translate only if user already has an active translation preference
    if (savedLang && savedLang !== 'en') {
      ensureGoogleTranslate();
    }
  });

  // Global Google Translate Init Callback
  window.googleTranslateElementInit = function() {
    if (window.google && window.google.translate) {
      new window.google.translate.TranslateElement({
        pageLanguage: 'en',
        includedLanguages: 'en,es,de,fr,ru,ar,ja,pt,zh-CN,it',
        autoDisplay: false
      }, 'google_translate_element');
    }
  };

  // On-demand Google Translate script injector
  let translateScriptLoaded = false;
  function ensureGoogleTranslate() {
    if (translateScriptLoaded) return;
    translateScriptLoaded = true;
    const s = document.createElement('script');
    s.src = '//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';
    s.defer = true;
    document.body.appendChild(s);
  }

  // Pre-load translator upon user interaction with language trigger
  const langTrigger = document.getElementById('bohol-lang-current-btn');
  langTrigger?.addEventListener('mouseenter', ensureGoogleTranslate, { once: true });
  langTrigger?.addEventListener('touchstart', ensureGoogleTranslate, { once: true, passive: true });
  langTrigger?.addEventListener('click', ensureGoogleTranslate, { once: true });
</script>
