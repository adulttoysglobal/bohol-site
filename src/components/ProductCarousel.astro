---
import Icon from './Icon.astro';

const slides = [
  {
    id: '01',
    code: '35,000 m² DIRECT FACTORY · 14 PRIVATE MOLDS',
    tag: 'DIRECT FACTORY OEM & IN-HOUSE TOOLING',
    name: 'Private-Mold Flagships',
    headline: 'Industrial Precision Personal Hardware',
    accent: '35,000 m² Direct Factory · Class 100,000 LSR Cleanrooms',
    description:
      'Direct factory engineering from our ISO-certified manufacturing base. We manufacture 14 proprietary private-mold hardware flagships with platinum-cured liquid silicone rubber, coreless whisper motors (< 45 dB), and 100% IPX7 vacuum immersion testing.',
    promoBadge: 'BOHOL DIRECT OEM',
    themeClass: 'slide-theme-white',
    mainImage: '/images/twist-hero.webp',
    subImage1: '/images/harmony-thumb.webp',
    subImage2: '/images/factory-workshop.webp',
    specs: [
      { k: 'Cleanroom', v: 'Class 100,000 LSR' },
      { k: 'In-House IP', v: '14 Private Flagships' },
      { k: 'Wholesale MOQ', v: '100 pcs (50 pcs Samples)' },
      { k: 'Global Freight', v: 'Direct DDP Sea & Air' }
    ],
    href: '/products/?subcat=BOHOL OEM',
    action: 'Explore 14 Private-Mold Flagships'
  },
  {
    id: '02',
    code: 'COMMERCIAL UNATTENDED RETAIL · IOT FLEET TELEMETRY',
    tag: 'COMMERCIAL HOTEL VENDING SYSTEMS',
    name: 'Hotel Vending Systems',
    headline: 'How Does Autonomous In-Room Hotel Vending Work?',
    accent: 'Wall-Mounted Micro Terminals & 65%+ Margin Consumables',
    description:
      'Turnkey micro-retail kiosks designed for boutique and business hotel guest rooms. Features integrated IoT 4G cloud telemetry, Nayax contactless cashless payment, and pre-calibrated 0.01 condoms, pure lubricants, and novelty devices for 24/7 unattended high-margin revenue.',
    promoBadge: 'HOTEL AUTONOMOUS RETAIL',
    themeClass: 'slide-theme-white',
    mainImage: '/images/spotlight-big-mouth.webp',
    subImage1: '/images/factory-assembly.webp',
    subImage2: '/images/factory-shipping.webp',
    specs: [
      { k: 'Terminal Form', v: 'Wall-Mounted Micro Kiosk' },
      { k: 'Payment Reader', v: 'Nayax / QR / Apple Pay' },
      { k: 'Average Margin', v: '65% ~ 75% Gross Profit' },
      { k: 'Drop Detection', v: 'Dual Infrared Laser Sensor' }
    ],
    href: '/products/?subcat=Vending',
    action: 'Explore Hotel Vending Solutions'
  },
  {
    id: '03',
    code: 'CUSTOM TOOLING & WHITE-LABEL OEM · RAPID CAD TO PRODUCTION',
    tag: 'CONTRACT OEM & PRIVATE LABEL',
    name: 'Custom OEM & Tooling',
    headline: 'Why Partner with BOHOL for Turnkey Brand OEM & Private Label?',
    accent: 'Precision Steel Tooling in 25 Days · Custom Pantone & Firmware',
    description:
      'From industrial CAD blueprints and rapid 3D printing to certified Class 100K steel injection tooling. We provide turnkey custom branding, laser etching, luxury rigid packaging design, custom vibration frequency firmware, and international regulatory testing (CE / RoHS / FCC).',
    promoBadge: 'CONTRACT BRAND OEM',
    themeClass: 'slide-theme-white',
    mainImage: '/images/spotlight-bobi-i.webp',
    subImage1: '/images/factory-rd-lab.webp',
    subImage2: '/images/factory-workshop.webp',
    specs: [
      { k: 'Tooling Lead Time', v: '20 ~ 25 Working Days' },
      { k: 'Custom Branding', v: 'Laser Etching & Silk-Screen' },
      { k: 'Packaging Design', v: 'FSC Luxury Rigid Boxes' },
      { k: 'Certifications', v: 'CE / RoHS / FCC / FDA 510(k)' }
    ],
    href: '/partners/',
    action: 'Start Custom OEM / ODM Project'
  }
];
---

<section class="hero-command sf-hero-b2b" aria-label="BOHOL Enterprise Hero Spotlight">
  <div class="hero-container">
    <div class="hero-slides" aria-label="BOHOL Strategic Solutions">
      {slides.map((slide, index) => (
        <article
          class={`product-slide ${slide.themeClass}`}
          hidden={index !== 0}
          aria-label={`${index + 1} of ${slides.length}: ${slide.name}`}
        >
          <div class="slide-copy">
            <div class="slide-badges">
              <span class="badge-factory"><span class="pulse-dot"></span> {slide.tag}</span>
              <span class="badge-code">{slide.code}</span>
            </div>
            {index === 0 ? (
              <h1 class="hero-h1">{slide.headline}<br /><span class="hero-accent-text">{slide.accent}</span></h1>
            ) : (
              <h2 class="hero-h1">{slide.headline}<br /><span class="hero-accent-text">{slide.accent}</span></h2>
            )}
            <p class="slide-desc">{slide.description}</p>

            <div class="slide-telemetry">
              {slide.specs.map((s) => (
                <div class="telemetry-cell">
                  <span class="telemetry-k">{s.k}</span>
                  <strong class="telemetry-v">{s.v}</strong>
                </div>
              ))}
            </div>

            <div class="slide-ctas">
              <a class="btn-primary" href={slide.href}>
                <span>{slide.action}</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
              <a class="btn-secondary" href="/rfq/">
                <span>Build Multi-Product RFQ</span>
              </a>
              <a class="btn-whatsapp-hero" href="https://wa.me/8618588583798" target="_blank" rel="noopener">
                <span>💬 WhatsApp Live Video Audit</span>
              </a>
            </div>
          </div>

          <figure class="slide-pod">
            <div class="pod-frame">
              <div class="pod-header">
                <span class="pod-model-tag">{slide.promoBadge}</span>
                <span class="pod-index">{slide.id} / 0{slides.length}</span>
              </div>
              <div class="pod-halo" aria-hidden="true"></div>
              <div class="pod-collage">
                <a href={slide.href} class="pod-main-visual" aria-label={slide.name}>
                  <img
                    src={slide.mainImage}
                    alt={slide.name}
                    width="760"
                    height="760"
                    loading={index === 0 ? 'eager' : 'lazy'}
                    fetchpriority={index === 0 ? 'high' : 'auto'}
                  />
                </a>
                <div class="pod-side-stack">
                  <a href={slide.href} class="pod-mini-card">
                    <img src={slide.subImage1} width="260" height="260" loading="lazy" alt="Hardware Engineering Detail" />
                    <span>DIRECT FACTORY OEM</span>
                  </a>
                  <a href={slide.href} class="pod-mini-card">
                    <img src={slide.subImage2} width="260" height="260" loading="lazy" alt="Production & Cleanrooms" />
                    <span>ISO 9001 · CLASS 100K</span>
                  </a>
                </div>
              </div>
              <div class="pod-footer">
                <span class="pod-status">✓ 100% Medical-Grade Platinum LSR Silicone · Zero Phthalates · IPX7 Waterproof</span>
                <a href="/catalogue/" class="pod-spec-link">Download Spec Sheet (PDF) &rarr;</a>
              </div>
            </div>
          </figure>
        </article>
      ))}
    </div>

    <!-- Carousel Nav Tabs -->
    <div class="carousel-bar">
      <nav class="carousel-tabs" aria-label="Select solution slide">
        {slides.map((slide, index) => (
          <button
            type="button"
            class="carousel-tab"
            data-slide={index}
            aria-label={`Show ${slide.name}`}
            aria-current={index === 0 ? 'true' : 'false'}
          >
            <span class="tab-num">{slide.id}</span>
            <span class="tab-name">{slide.name}</span>
          </button>
        ))}
      </nav>
      <div class="carousel-actions">
        <button type="button" class="ctrl-btn" data-previous aria-label="Previous slide">&larr;</button>
        <button type="button" class="ctrl-btn" data-next aria-label="Next slide">&rarr;</button>
        <button type="button" class="ctrl-btn pause-btn" data-pause aria-label="Pause slideshow">Pause</button>
      </div>
    </div>
  </div>
</section>

<!-- Enterprise Verification & B2B Sourcing Credentials Bar -->
<section class="b2b-credentials-strip" aria-label="Enterprise Verification & Sourcing Credentials">
  <div class="b2b-credentials-inner">
    <div class="b2b-cred-item">
      <span class="b2b-cred-icon">🏭</span>
      <div>
        <strong>35,000 m² Integrated Campus</strong>
        <p>Meizhou Base · 120+ Assembly Lines</p>
      </div>
    </div>
    <div class="b2b-cred-divider" aria-hidden="true"></div>
    <div class="b2b-cred-item">
      <span class="b2b-cred-icon">⚡</span>
      <div>
        <strong>14 In-House Private Molds</strong>
        <p>Proprietary IP · Zero Middleman Markup</p>
      </div>
    </div>
    <div class="b2b-cred-divider" aria-hidden="true"></div>
    <div class="b2b-cred-item">
      <span class="b2b-cred-icon">🔬</span>
      <div>
        <strong>Class 100,000 Cleanroom</strong>
        <p>Medical Platinum LSR Liquid Silicone</p>
      </div>
    </div>
    <div class="b2b-cred-divider" aria-hidden="true"></div>
    <div class="b2b-cred-item">
      <span class="b2b-cred-icon">📦</span>
      <div>
        <strong>800+ Consolidated SKUs</strong>
        <p>Mixed 40HQ Container Consolidation</p>
      </div>
    </div>
    <div class="b2b-cred-divider" aria-hidden="true"></div>
    <div class="b2b-cred-item">
      <span class="b2b-cred-icon">🚢</span>
      <div>
        <strong>DDP Door-to-Door Freight</strong>
        <p>Direct Sea & Air Logistics to 60+ Nations</p>
      </div>
    </div>
  </div>
</section>

<script>
  const deferCarousel = (cb: () => void) => {
    if ('requestIdleCallback' in window) {
      requestIdleCallback(cb, { timeout: 1500 });
    } else {
      setTimeout(cb, 100);
    }
  };

  deferCarousel(() => {
    const root = document.querySelector<HTMLElement>('.hero-command');
    if (!root) return;

    const slides = Array.from(root.querySelectorAll<HTMLElement>('.product-slide'));
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-slide]'));
    const pause = root.querySelector<HTMLButtonElement>('[data-pause]');
    const prev = root.querySelector<HTMLButtonElement>('[data-previous]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    let current = 0;
    let paused = false;
    let timer: ReturnType<typeof setInterval> | undefined;

    function showSlide(index: number) {
      slides.forEach((el, i) => {
        el.hidden = i !== index;
      });
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-current', i === index ? 'true' : 'false');
      });
      current = index;
    }

    function nextSlide() {
      showSlide((current + 1) % slides.length);
    }

    function prevSlide() {
      showSlide((current - 1 + slides.length) % slides.length);
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const idx = Number(tab.getAttribute('data-slide'));
        showSlide(idx);
      });
    });

    if (prev) prev.addEventListener('click', prevSlide);
    if (next) next.addEventListener('click', nextSlide);

    if (pause) {
      pause.addEventListener('click', () => {
        paused = !paused;
        pause.textContent = paused ? 'Play' : 'Pause';
      });
    }

    timer = setInterval(() => {
      if (!paused) {
        nextSlide();
      }
    }, 7000);
  });
</script>
