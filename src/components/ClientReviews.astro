---
<section class="section reviews-section" id="client-reviews">
  <div class="reviews-top">
    <div class="reviews-head-copy">
      <p class="eyebrow">REAL CUSTOMER SELFIE REVIEWS · VERIFIED BUYER GALLERY</p>
      <h2>4.98 ★ Rated by 12,400+ Verified Buyers & Global Brand Users.</h2>
      <p>Real unboxing selfies and hands-on feedback from verified users across Europe, North America, Asia, and Australia experiencing BOHOL’s medical-grade liquid silicone hardware.</p>
    </div>
    <div class="reviews-kpis">
      <div class="review-kpi-box">
        <strong>4.98 / 5.0</strong>
        <span>Average Customer Star Rating</span>
      </div>
      <div class="review-kpi-box">
        <strong>99.2%</strong>
        <span>Verified Buyer Satisfaction</span>
      </div>
      <div class="review-kpi-box">
        <strong>&lt; 0.15%</strong>
        <span>Factory Defect &amp; Return Rate</span>
      </div>
      <div class="review-kpi-box">
        <strong>38+ Countries</strong>
        <span>Global Retail &amp; DTC Footprint</span>
      </div>
    </div>
  </div>

  <!-- 12-Card Customer Selfie Photo Review Grid (3 rows x 4 columns) -->
  <div class="ugc-reviews-grid">
    {ugcReviews.map((item) => (
      <article class="ugc-card">
        <div
          class="ugc-photo-wrap"
          data-lightbox-src={item.selfie}
          data-lightbox-prod={item.productImg}
          data-lightbox-name={`${item.name} · ${item.productName} (${item.productSku})`}
          data-lightbox-quote={item.quote}
        >
          <img
            src={item.selfie}
            width="600"
            height="750"
            loading="lazy"
            alt={`${item.name} holding BOHOL ${item.productName} in customer review selfie`}
            class="ugc-selfie-img"
          />
          <span class="ugc-verified-pill">
            <svg width="12" height="12" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
            </svg>
            Verified Selfie
          </span>
          <span class="ugc-tag-pill">{item.tag}</span>
        </div>

        <div class="ugc-card-body">
          <div class="ugc-rating-row">
            <span class="ugc-stars" aria-label="5 out of 5 stars">★★★★★</span>
            <span class="ugc-score">{item.rating}</span>
            <span class="ugc-date">{item.date}</span>
          </div>

          <div class="ugc-author-line">
            <h3>{item.name}</h3>
            <span>{item.location}</span>
          </div>

          <p class="ugc-quote">{item.quote}</p>

          <div class="ugc-product-chip">
            <a
              href={item.productImg}
              target="_blank"
              rel="noopener"
              class="ugc-prod-thumb"
              title={`View local HD photo of ${item.productName}`}
              data-prod-preview={item.productImg}
              data-prod-title={`${item.productName} (${item.productSku}) — Official Factory Photo`}
              data-prod-desc={item.quote}
            >
              <img src={item.productImg} width="56" height="56" loading="lazy" alt={item.productName} />
            </a>
            <a href={item.productUrl} class="ugc-prod-meta">
              <span>Purchased Product · {item.productSku}</span>
              <strong>{item.productName}</strong>
            </a>
            <a href={item.productImg} target="_blank" rel="noopener" class="ugc-prod-arrow" title="View Product Image" aria-label={`View full resolution image of ${item.productName}`}>&rarr;</a>
          </div>
        </div>
      </article>
    ))}
  </div>

  <!-- Lightbox Modal for full-size selfie or local product image inspection -->
  <div id="ugc-lightbox" class="ugc-lightbox" hidden>
    <div class="ugc-lightbox-backdrop" id="ugc-lightbox-close"></div>
    <div class="ugc-lightbox-content">
      <button type="button" class="ugc-lightbox-btn" id="ugc-lightbox-x" aria-label="Close photo">✕</button>
      <img id="ugc-lightbox-img" src="" alt="Full preview" />
      <div class="ugc-lightbox-caption">
        <strong id="ugc-lightbox-author"></strong>
        <p id="ugc-lightbox-text"></p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const cards = document.querySelectorAll('.ugc-photo-wrap');
    const prodThumbs = document.querySelectorAll('[data-prod-preview]');
    const lightbox = document.getElementById('ugc-lightbox');
    const lbImg = document.getElementById('ugc-lightbox-img');
    const lbAuthor = document.getElementById('ugc-lightbox-author');
    const lbText = document.getElementById('ugc-lightbox-text');
    const lbClose = document.getElementById('ugc-lightbox-close');
    const lbX = document.getElementById('ugc-lightbox-x');

    if (!lightbox || !lbImg) return;

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const src = card.getAttribute('data-lightbox-src');
        const name = card.getAttribute('data-lightbox-name');
        const quote = card.getAttribute('data-lightbox-quote');
        if (src) {
          lbImg.src = src;
          if (lbAuthor) lbAuthor.textContent = name + ' · Verified Buyer ★★★★★';
          if (lbText) lbText.textContent = quote;
          lightbox.hidden = false;
        }
      });
    });

    prodThumbs.forEach((thumb) => {
      thumb.addEventListener('click', (e) => {
        e.preventDefault();
        const src = thumb.getAttribute('data-prod-preview');
        const title = thumb.getAttribute('data-prod-title');
        const desc = thumb.getAttribute('data-prod-desc');
        if (src) {
          lbImg.src = src;
          if (lbAuthor) lbAuthor.textContent = title;
          if (lbText) lbText.textContent = desc;
          lightbox.hidden = false;
        }
      });
    });

    const closeLb = () => {
      lightbox.hidden = true;
      lbImg.src = '';
    };
    if (lbClose) lbClose.addEventListener('click', closeLb);
    if (lbX) lbX.addEventListener('click', closeLb);
  })();
</script>
