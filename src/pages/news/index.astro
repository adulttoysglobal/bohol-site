---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';

// Fetch all 56 articles, sorted by pubDate descending, then order ascending
const allArticles = (await getCollection('journal')).sort((a, b) => {
  const dateA = new Date(a.data.pubDate || '2026-10-14').getTime();
  const dateB = new Date(b.data.pubDate || '2026-10-14').getTime();
  if (dateB !== dateA) return dateB - dateA;
  return a.data.order - b.data.order;
});

// Normalized category helper so all articles map cleanly to the 6 primary pillars
const normalizeCategory = (cat?: string) => {
  if (!cat) return 'Brand & Manufacturing';
  const c = cat.toLowerCase();
  if (c.includes('vending')) return 'Hotel Vending';
  if (c.includes('male') || c.includes('stroker')) return 'Male Wellness';
  if (c.includes('condom') || c.includes('lubricant') || c.includes('lube')) return 'Condoms & Lubricants';
  if (c.includes('lingerie') || c.includes('couple') || c.includes('bdsm')) return 'Couples & Lingerie';
  if (c.includes('pleasure') || c.includes('vibrat') || c.includes('kegel') || c.includes('product') || c.includes('collection') || c.includes('design')) return 'Pleasure Tech';
  return 'Brand & Manufacturing';
};

// Category pills definition with exact counts
const categoryList = [
  { label: 'All News', slug: 'all', count: allArticles.length },
  { label: 'Pleasure Tech', slug: 'Pleasure Tech', count: allArticles.filter(a => normalizeCategory(a.data.category) === 'Pleasure Tech').length },
  { label: 'Male Wellness', slug: 'Male Wellness', count: allArticles.filter(a => normalizeCategory(a.data.category) === 'Male Wellness').length },
  { label: 'Couples & Lingerie', slug: 'Couples & Lingerie', count: allArticles.filter(a => normalizeCategory(a.data.category) === 'Couples & Lingerie').length },
  { label: 'Condoms & Lubricants', slug: 'Condoms & Lubricants', count: allArticles.filter(a => normalizeCategory(a.data.category) === 'Condoms & Lubricants').length },
  { label: 'Hotel Vending', slug: 'Hotel Vending', count: allArticles.filter(a => normalizeCategory(a.data.category) === 'Hotel Vending').length },
  { label: 'Brand & OEM', slug: 'Brand & Manufacturing', count: allArticles.filter(a => normalizeCategory(a.data.category) === 'Brand & Manufacturing').length },
];

// Top featured article for the hero spotlight
const featuredArticle = allArticles.find(a => a.data.featured) || allArticles[0];

// Format date helper
const formatDate = (dateStr?: string) => {
  if (!dateStr) return 'Oct 15, 2026';
  return new Date(dateStr).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric'
  });
};

// GEO FAQ Schema for Industry News Hub
const newsFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What topics does BOHOL Industry News cover?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'BOHOL Industry News provides daily technical insights across 6 core pillars: female pleasure tech engineering, male automated strokers, couples intimacy and lingerie, condom materials science (0.01mm polyurethane vs latex), autonomous hotel room vending retail, and OEM cleanroom manufacturing standards.'
      }
    },
    {
      '@type': 'Question',
      name: 'How often are new industry articles published?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Articles are published daily at 09:00 AM, curated by BOHOL Intimate Wellness Labs, Electrical Engineering Division, and Vending Intelligence Group direct from our 35,000 m² manufacturing campus.'
      }
    },
    {
      '@type': 'Question',
      name: 'Can distributors and media syndicate BOHOL news via RSS?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. BOHOL provides an automated dynamic RSS 2.0 XML endpoint at /rss.xml for seamless syndication into news readers, enterprise ERPs, and industry feeds.'
      }
    }
  ]
};
---

<Layout
  title="Adult Intimate Wellness & Smart Manufacturing Industry News | BOHOL Intelligence"
  description="Explore daily technical breakthroughs, female pleasure tech engineering, male stroker innovations, 0.01mm condom science, and autonomous hotel vending economics from BOHOL 35,000 m² cleanroom campus."
  schema={newsFaqSchema}
>
  <!-- TOP BREADCRUMB -->
  <div class="news-breadcrumb-bar">
    <div class="news-container">
      <nav class="news-crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="crumb-sep">/</span>
        <span aria-current="page">Industry News</span>
      </nav>
    </div>
  </div>

  <!-- EDITORIAL HERO HEADER -->
  <header class="news-hero-section">
    <div class="news-container text-center">
      <div class="news-pill-tag">
        <span class="news-live-dot"></span>
        <span>BOHOL INDUSTRY INTELLIGENCE & NEWS FEED</span>
      </div>
      <h1 class="news-main-title">Adult Wellness & Smart Manufacturing News</h1>
      <p class="news-hero-desc">
        Authoritative engineering breakdowns, female pleasure tech trends, male stroker innovations, condom material science, and autonomous hotel room vending retail direct from our 35,000 m² cleanroom campus.
      </p>

      <!-- Key Metrics Badge Bar -->
      <div class="news-metrics-strip">
        <div class="metric-item">
          <strong>{allArticles.length}</strong>
          <span>In-Depth Articles</span>
        </div>
        <div class="metric-divider"></div>
        <div class="metric-item">
          <strong>6</strong>
          <span>Industry Pillars</span>
        </div>
        <div class="metric-divider"></div>
        <div class="metric-item">
          <strong>Daily 09:00</strong>
          <span>Automated Publishing</span>
        </div>
        <div class="metric-divider"></div>
        <div class="metric-item">
          <strong>RSS 2.0</strong>
          <span>Feed Syndication</span>
        </div>
      </div>

      <!-- Quick Action Buttons -->
      <div class="news-actions-row">
        <a href="/rss.xml" target="_blank" class="news-btn-secondary" title="Subscribe via RSS 2.0 XML">
          <span>📡 Subscribe via RSS Feed</span>
        </a>
        <a href="/rfq/" class="news-btn-primary" title="Launch OEM RFQ Inquiry">
          <span>Launch OEM Project RFQ</span>
          <Icon name="arrow-up-right" size={14} />
        </a>
      </div>
    </div>
  </header>

  <!-- FEATURED SPOTLIGHT ARTICLE -->
  {featuredArticle && (
    <section class="news-featured-wrap">
      <div class="news-container">
        <div class="featured-card">
          <div class="featured-card-img">
            <img
              src={featuredArticle.data.image}
              alt={featuredArticle.data.title}
              width="800"
              height="500"
              loading="eager"
              onerror="this.onerror=null; this.src='/images/factory-campus.webp';"
            />
            <span class="featured-ribbon">⭐ Featured Story</span>
          </div>
          <div class="featured-card-body">
            <div class="featured-meta">
              <span class="news-cat-pill">{featuredArticle.data.category}</span>
              <span class="news-date-pill">📅 {formatDate(featuredArticle.data.pubDate)}</span>
              <span class="news-read-pill">⏱️ {featuredArticle.data.readTime}</span>
            </div>
            <h2 class="featured-title">
              <a href={`/journal/${featuredArticle.id}/`}>{featuredArticle.data.title}</a>
            </h2>
            <p class="featured-excerpt">{featuredArticle.data.description}</p>
            <div class="featured-footer">
              <div class="author-tag">
                <span class="author-icon">🏢</span>
                <span>{featuredArticle.data.author || 'BOHOL Intimate Wellness Lab'}</span>
              </div>
              <a href={`/journal/${featuredArticle.id}/`} class="featured-read-btn">
                <span>Read Full Analysis</span>
                <Icon name="arrow-up-right" size={15} />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- FILTER & SEARCH CONTROLS -->
  <section class="news-controls-section">
    <div class="news-container">
      <div class="news-controls-bar">
        <!-- Live Search Input -->
        <div class="news-search-box">
          <svg class="search-icon" width="16" height="16" viewBox="0 0 512 512" fill="currentColor">
            <path d="M508.5 468.9L387.1 347.5c-2.3-2.3-5.3-3.5-8.5-3.5h-13.2c31.5-36.5 50.6-84 50.6-136C416 93.1 322.9 0 208 0S0 93.1 0 208s93.1 208 208 208c52 0 99.5-19.1 136-50.6v13.2c0 3.2 1.3 6.2 3.5 8.5l121.4 121.4c4.7 4.7 12.3 4.7 17 0l22.6-22.6c4.7-4.7 4.7-12.3 0-17zM208 368c-88.4 0-160-71.6-160-160S119.6 48 208 48s160 71.6 160 160-71.6 160-160 160z"/>
          </svg>
          <input
            type="search"
            id="news-search-input"
            placeholder={`Search ${allArticles.length} articles (e.g. vibrator, stroker, 0.01, hotel, suction, silicone)...`}
            autocomplete="off"
          />
          <button type="button" id="clear-search-btn" class="clear-btn" style="display:none;" title="Clear search">✕</button>
        </div>

        <!-- Result Counter -->
        <div class="news-count-badge">
          Showing <strong id="visible-range">1–6</strong> of <strong id="total-matching">{allArticles.length}</strong> articles
          <span id="page-indicator" class="page-indicator-badge">Page 1 / {Math.ceil(allArticles.length / 6)}</span>
        </div>
      </div>

      <!-- Category Filter Tabs -->
      <div class="news-category-pills" role="tablist">
        {categoryList.map((cat, idx) => (
          <button
            type="button"
            class={`cat-filter-btn ${idx === 0 ? 'active' : ''}`}
            data-cat={cat.slug}
            role="tab"
          >
            <span>{cat.label}</span>
            <span class="cat-pill-count">{cat.count}</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- ARTICLES GRID -->
  <section class="news-grid-section" id="news-grid-section">
    <div class="news-container">
      <div class="news-cards-grid" id="news-grid">
        {allArticles.map((article) => (
          <article
            class="news-card"
            data-category={normalizeCategory(article.data.category)}
            data-raw-category={article.data.category}
            data-title={article.data.title.toLowerCase()}
            data-desc={article.data.description.toLowerCase()}
            data-tags={article.data.tags ? article.data.tags.join(' ').toLowerCase() : ''}
          >
            <a href={`/journal/${article.id}/`} class="news-card-media" title={article.data.title}>
              <img
                src={article.data.image}
                alt={article.data.title}
                width="600"
                height="380"
                loading="lazy"
                onerror="this.onerror=null; this.src='/images/factory-workshop.webp';"
              />
              <span class="news-card-category-tag">{article.data.category}</span>
            </a>

            <div class="news-card-content">
              <div class="news-card-meta">
                <span class="news-card-date">📅 {formatDate(article.data.pubDate)}</span>
                <span class="news-card-time">⏱️ {article.data.readTime}</span>
              </div>

              <h3 class="news-card-title">
                <a href={`/journal/${article.id}/`} title={article.data.title}>{article.data.title}</a>
              </h3>

              <p class="news-card-desc">{article.data.description}</p>

              <div class="news-card-footer">
                <span class="news-card-author">
                  🏢 {article.data.author || 'BOHOL Intimate Wellness Lab'}
                </span>
                <a href={`/journal/${article.id}/`} class="news-card-link" aria-label={`Read article: ${article.data.title}`}>
                  <span>Read Article</span>
                  <Icon name="arrow-up-right" size={14} />
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- PAGINATION CONTROLS BAR (6 Articles Per Page) -->
      <div class="news-pagination-wrap" id="news-pagination">
        <nav class="news-pagination-nav" aria-label="Article navigation pagination">
          <button type="button" class="page-btn page-btn-prev" id="page-prev-btn" aria-label="Previous Page">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            <span>« 上一页 Prev</span>
          </button>
          <div class="page-numbers-list" id="page-numbers-list">
            <!-- Dynamically populated: 1 2 3 ... N -->
          </div>
          <button type="button" class="page-btn page-btn-next" id="page-next-btn" aria-label="Next Page">
            <span>下一页 Next »</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </nav>
      </div>

      <!-- Empty State When No Results Match -->
      <div id="no-results-box" class="news-empty-state" style="display:none;">
        <div class="empty-icon">🔍</div>
        <h3>No matching industry articles found</h3>
        <p>Try searching for a different keyword like "silicone", "condom", "vibrator", "hotel", or clear your filter.</p>
        <button type="button" id="reset-filter-btn" class="news-btn-primary">Reset Filters & Show All</button>
      </div>
    </div>
  </section>

  <!-- RSS SYNDICATION & NEWSLETTER CALLOUT -->
  <section class="news-syndication-section">
    <div class="news-container">
      <div class="syndication-card">
        <div class="syndication-icon">📡</div>
        <div class="syndication-copy">
          <h3>Automated Daily News Syndication (RSS 2.0)</h3>
          <p>
            Stay ahead of intimacy hardware innovations. All articles published from BOHOL 35,000 m² cleanroom campus are automatically syndicated to our public RSS feed for media partners, retail curators, and global distributors.
          </p>
          <div class="feed-url-box">
            <code>https://bohol-product-studio.subaohe.chatgpt.site/rss.xml</code>
            <a href="/rss.xml" target="_blank" class="feed-link-btn">Open RSS Feed</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- GEO & FACTORY PROCUREMENT FAQ SECTION -->
  <section class="news-faq-section">
    <div class="news-container">
      <div class="text-center" style="margin-bottom: 36px;">
        <div class="news-pill-tag" style="margin-bottom: 8px;">
          <span>TECHNICAL & INDUSTRY REFERENCES</span>
        </div>
        <h2 style="font-size: 28px; font-weight: 800; color: #0f172a; margin: 0 0 10px;">Frequently Asked Questions</h2>
        <p style="font-size: 15px; color: #64748b; max-width: 650px; margin: 0 auto;">
          Authoritative references on adult novelty product standards, OEM cleanroom manufacturing, and global DDP distribution.
        </p>
      </div>

      <div class="faq-list-grid">
        <div class="faq-item-card">
          <h4>Q: How does BOHOL guarantee body-safe biocompatibility?</h4>
          <p>A: All silicone hardware is molded from 100% platinum-cured liquid silicone rubber (LSR) inside our Class 100,000 dust-free cleanrooms. It is free from phthalates, BPA, and porous fillers, certified under ISO 10993 cytotoxicity and FDA 21 CFR 177.2600 standards.</p>
        </div>

        <div class="faq-item-card">
          <h4>Q: Can retail brands commission private-mold vibrators or strokers?</h4>
          <p>A: Yes. With in-house 5-axis DMG MORI CNC tooling and mirror spark EDM, BOHOL delivers functional 3D working prototypes in 7 days, complete T1 steel molds in 25 days, and guarantees 100% exclusive mold ownership protected by bilateral NDAs.</p>
        </div>

        <div class="faq-item-card">
          <h4>Q: What are the primary advantages of autonomous hotel room vending kiosks?</h4>
          <p>A: In-room kiosks eliminate guest embarrassment at the front desk, capturing high-velocity impulse sales between 10 PM and 2 AM. Operators recoup machine hardware costs within 60 to 90 days with 65%–78% product gross profit margins.</p>
        </div>

        <div class="faq-item-card">
          <h4>Q: How does 0.01mm polyurethane compare to standard natural latex condoms?</h4>
          <p>A: At only 0.010 mm thickness, waterborne polyurethane conducts body heat nearly 7 times faster than latex for immediate skin-on-skin warmth. It is also 100% hypoallergenic and protein-free for users with latex allergies.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- BOTTOM FACTORY CTA BANNER -->
  <section class="news-cta-section">
    <div class="news-container text-center">
      <h2>Ready to Partner with BOHOL Direct Manufacturing?</h2>
      <p>Whether you need private-label branding, customized steel tooling, or turnkey hotel vending inventory, our engineering team is here to assist.</p>
      <div class="cta-btns">
        <a href="/rfq/" class="news-btn-primary" style="padding: 14px 28px; font-size: 15px;">
          <span>Request Wholesale & OEM RFQ Quote</span>
          <Icon name="arrow-up-right" size={16} />
        </a>
        <a href="/manufacturing/" class="news-btn-secondary" style="padding: 14px 28px; font-size: 15px;">
          <span>Tour 35,000 m² Campus Facilities</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<!-- CLIENT-SIDE INSTANT FILTER, SEARCH & 6-CARD PAGINATION JAVASCRIPT -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const PAGE_SIZE = 6;
    let currentPage = 1;
    let currentCat = 'all';
    let currentQuery = '';

    const searchInput = document.getElementById('news-search-input');
    const clearBtn = document.getElementById('clear-search-btn');
    const filterBtns = document.querySelectorAll('.cat-filter-btn');
    const cards = Array.from(document.querySelectorAll('#news-grid .news-card'));
    const visibleRangeEl = document.getElementById('visible-range');
    const totalMatchingEl = document.getElementById('total-matching');
    const pageIndicatorEl = document.getElementById('page-indicator');
    const noResultsBox = document.getElementById('no-results-box');
    const resetFilterBtn = document.getElementById('reset-filter-btn');
    const paginationWrap = document.getElementById('news-pagination');
    const pageNumbersList = document.getElementById('page-numbers-list');
    const prevBtn = document.getElementById('page-prev-btn');
    const nextBtn = document.getElementById('page-next-btn');

    // Parse URL params (?page=2&cat=Hotel%20Vending&q=kiosk)
    const urlParams = new URLSearchParams(window.location.search);
    const catParam = urlParams.get('cat');
    const qParam = urlParams.get('q');
    const pageParam = parseInt(urlParams.get('page') || '1', 10);

    if (catParam) {
      currentCat = catParam;
      filterBtns.forEach(btn => {
        if (btn.getAttribute('data-cat') === catParam) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
    }

    if (qParam && searchInput) {
      searchInput.value = qParam;
      currentQuery = qParam.toLowerCase().trim();
      if (clearBtn) clearBtn.style.display = 'block';
    }

    if (!isNaN(pageParam) && pageParam >= 1) {
      currentPage = pageParam;
    }

    function syncUrl() {
      const url = new URL(window.location);
      if (currentCat === 'all') {
        url.searchParams.delete('cat');
      } else {
        url.searchParams.set('cat', currentCat);
      }

      if (!currentQuery) {
        url.searchParams.delete('q');
      } else {
        url.searchParams.set('q', currentQuery);
      }

      if (currentPage === 1) {
        url.searchParams.delete('page');
      } else {
        url.searchParams.set('page', currentPage.toString());
      }
      window.history.replaceState({}, '', url);
    }

    function scrollToGrid() {
      const gridSection = document.getElementById('news-grid-section') || document.getElementById('news-grid');
      if (gridSection) {
        const topOffset = gridSection.getBoundingClientRect().top + window.pageYOffset - 90;
        window.scrollTo({ top: Math.max(0, topOffset), behavior: 'smooth' });
      }
    }

    function renderPagination(totalPages) {
      if (!pageNumbersList) return;
      pageNumbersList.innerHTML = '';

      if (totalPages <= 1) {
        if (paginationWrap) paginationWrap.style.display = 'none';
        return;
      }
      if (paginationWrap) paginationWrap.style.display = 'flex';

      if (prevBtn) prevBtn.disabled = (currentPage <= 1);
      if (nextBtn) nextBtn.disabled = (currentPage >= totalPages);

      // Smart page numbers calculation (e.g. 1 2 3 ... 19)
      let pages = [];
      if (totalPages <= 7) {
        for (let i = 1; i <= totalPages; i++) pages.push(i);
      } else {
        if (currentPage <= 4) {
          pages = [1, 2, 3, 4, 5, '...', totalPages];
        } else if (currentPage >= totalPages - 3) {
          pages = [1, '...', totalPages - 4, totalPages - 3, totalPages - 2, totalPages - 1, totalPages];
        } else {
          pages = [1, '...', currentPage - 1, currentPage, currentPage + 1, '...', totalPages];
        }
      }

      pages.forEach(p => {
        if (p === '...') {
          const ellipsis = document.createElement('span');
          ellipsis.className = 'page-ellipsis';
          ellipsis.textContent = '…';
          pageNumbersList.appendChild(ellipsis);
        } else {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = `page-num-btn ${p === currentPage ? 'active' : ''}`;
          btn.textContent = p;
          btn.setAttribute('aria-label', `Page ${p}`);
          btn.addEventListener('click', () => {
            if (currentPage !== p) {
              currentPage = p;
              syncUrl();
              updateView(true);
            }
          });
          pageNumbersList.appendChild(btn);
        }
      });
    }

    function updateView(shouldScroll = false) {
      // 1. Filter matching cards
      const matchingCards = cards.filter(card => {
        const cat = card.getAttribute('data-category') || '';
        const rawCat = card.getAttribute('data-raw-category') || '';
        const title = card.getAttribute('data-title') || '';
        const desc = card.getAttribute('data-desc') || '';
        const tags = card.getAttribute('data-tags') || '';

        const matchesCat = (currentCat === 'all' ||
          cat.toLowerCase() === currentCat.toLowerCase() ||
          rawCat.toLowerCase() === currentCat.toLowerCase());

        const matchesQuery = (!currentQuery ||
          title.includes(currentQuery) ||
          desc.includes(currentQuery) ||
          tags.includes(currentQuery));

        return matchesCat && matchesQuery;
      });

      const totalCount = matchingCards.length;
      const totalPages = Math.max(1, Math.ceil(totalCount / PAGE_SIZE));

      // Clamp currentPage
      if (currentPage > totalPages) {
        currentPage = 1;
        syncUrl();
      }

      const startIndex = (currentPage - 1) * PAGE_SIZE;
      const endIndex = startIndex + PAGE_SIZE;

      // 2. Hide all cards, then show only the current page (up to 6)
      cards.forEach(card => {
        card.style.display = 'none';
      });

      matchingCards.slice(startIndex, endIndex).forEach(card => {
        card.style.display = 'flex';
      });

      // 3. Update counter text and pagination controls
      if (totalCount === 0) {
        if (visibleRangeEl) visibleRangeEl.textContent = '0';
        if (totalMatchingEl) totalMatchingEl.textContent = '0';
        if (pageIndicatorEl) pageIndicatorEl.textContent = 'Page 0 / 0';
        if (noResultsBox) noResultsBox.style.display = 'block';
        if (paginationWrap) paginationWrap.style.display = 'none';
      } else {
        const startNum = startIndex + 1;
        const endNum = Math.min(endIndex, totalCount);
        if (visibleRangeEl) visibleRangeEl.textContent = `${startNum}–${endNum}`;
        if (totalMatchingEl) totalMatchingEl.textContent = `${totalCount}`;
        if (pageIndicatorEl) pageIndicatorEl.textContent = `Page ${currentPage} / ${totalPages}`;
        if (noResultsBox) noResultsBox.style.display = 'none';
        renderPagination(totalPages);
      }

      if (shouldScroll) {
        scrollToGrid();
      }
    }

    // Prev / Next button listeners
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          syncUrl();
          updateView(true);
        }
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        const matchingCards = cards.filter(card => {
          const cat = card.getAttribute('data-category') || '';
          const rawCat = card.getAttribute('data-raw-category') || '';
          const title = card.getAttribute('data-title') || '';
          const desc = card.getAttribute('data-desc') || '';
          const tags = card.getAttribute('data-tags') || '';
          const matchesCat = (currentCat === 'all' ||
            cat.toLowerCase() === currentCat.toLowerCase() ||
            rawCat.toLowerCase() === currentCat.toLowerCase());
          const matchesQuery = (!currentQuery || title.includes(currentQuery) || desc.includes(currentQuery) || tags.includes(currentQuery));
          return matchesCat && matchesQuery;
        });
        const totalPages = Math.ceil(matchingCards.length / PAGE_SIZE);
        if (currentPage < totalPages) {
          currentPage++;
          syncUrl();
          updateView(true);
        }
      });
    }

    // Category button click
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentCat = btn.getAttribute('data-cat') || 'all';
        currentPage = 1;
        syncUrl();
        updateView(false);
      });
    });

    // Search input typing
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentQuery = e.target.value.toLowerCase().trim();
        if (clearBtn) {
          clearBtn.style.display = currentQuery.length > 0 ? 'block' : 'none';
        }
        currentPage = 1;
        syncUrl();
        updateView(false);
      });
    }

    // Clear search button
    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        currentQuery = '';
        clearBtn.style.display = 'none';
        currentPage = 1;
        syncUrl();
        updateView(false);
      });
    }

    // Reset button in empty state
    if (resetFilterBtn) {
      resetFilterBtn.addEventListener('click', () => {
        currentCat = 'all';
        currentQuery = '';
        currentPage = 1;
        if (searchInput) searchInput.value = '';
        if (clearBtn) clearBtn.style.display = 'none';

        filterBtns.forEach(b => {
          if (b.getAttribute('data-cat') === 'all') b.classList.add('active');
          else b.classList.remove('active');
        });

        syncUrl();
        updateView(false);
      });
    }

    // Initial render
    updateView(false);
  });
</script>

