---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';

const whitepaperSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: '2026 Global Adult Toy Sourcing, Tooling & Regulatory Compliance Dossier',
  description: 'Complete B2B procurement guide for sexual wellness brands: FDA 21 CFR § 177.2600 silicone verification, CE-RED/RoHS electronics compliance, UN38.3 lithium battery logistics, and OEM private-mold economics.',
  author: {
    '@type': 'Organization',
    name: 'BOHOL Manufacturing & Engineering Group',
    url: 'https://adulttoysglobal.com'
  },
  publisher: {
    '@type': 'Organization',
    name: 'BOHOL',
    url: 'https://adulttoysglobal.com'
  },
  datePublished: '2026-01-15T08:00:00Z',
  dateModified: new Date().toISOString()
