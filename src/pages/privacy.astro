---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const privacySchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://adulttoysglobal.com/privacy/#webpage',
      url: 'https://adulttoysglobal.com/privacy/',
      name: 'Privacy Policy, 18+ Adult Compliance & OEM NDA Terms | BOHOL',
      description: 'Official compliance disclosure for BOHOL: 18+ age verification, adult novelty non-medical product disclaimer, GDPR & CCPA privacy protection, bilateral OEM/ODM NDA guarantees, and international customs clearance standards.',
      inLanguage: 'en-US',
      datePublished: '2024-01-01T08:00:00+08:00',
      dateModified: new Date().toISOString(),
      author: {
        '@type': 'Person',
        name: 'Alex Chen',
        jobTitle: 'Chief Compliance & Legal Affairs Officer',
        worksFor: {
          '@type': 'Organization',
          name: 'BOHOL'
        },
        url: 'https://adulttoysglobal.com/about/'
      },
      publisher: {
        '@type': 'Organization',
        name: 'BOHOL',
        url: 'https://adulttoysglobal.com',
        logo: {
          '@type': 'ImageObject',
          url: 'https://adulttoysglobal.com/images/bohol-logo-horiz-dark.webp'
        }
      }
    }
  ]
};
---
<Layout
  title="Privacy Policy, 18+ Adult Compliance & OEM NDA Terms | BOHOL"
  description="Official compliance disclosure for BOHOL: 18+ age verification, adult novelty non-medical product disclaimer, GDPR & CCPA privacy protection, bilateral OEM/ODM NDA guarantees, and international customs clearance standards."
  schema={privacySchema}
>
  <section class="page-head">
    <p class="eyebrow">REGULATORY COMPLIANCE & LEGAL POLICY</p>
    <h1>Compliance, Privacy & OEM NDA Safeguards.</h1>
    <p>BOHOL operates in strict adherence to global trade regulations, consumer data protection laws, adult novelty product standards, and confidential private-label manufacturing covenants.</p>
  </section>

  <!-- AUTHOR BYLINE & MACHINE-READABLE FRESHNESS SIGNALS -->
  <div class="geo-byline-bar" style="max-width: 900px; margin: 1.25rem auto 2.5rem; padding: 0 1.5rem;">
    <div style="display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 8px 14px; font-size: 13px; color: #475569; padding: 8px 18px; background: #f8fafc; border-radius: 9999px; border: 1px solid #e2e8f0;">
      <span>🏭 Compliance Directorate: <strong>BOHOL Legal Division</strong></span>
      <span style="color: #cbd5e1;">•</span>
      <span>Officer: <a href="/about/" style="color: #0284c7; text-decoration: underline; font-weight: 700;">Alex Chen (Legal Affairs)</a></span>
      <span style="color: #cbd5e1;">•</span>
      <span>Published: <time datetime="2024-01-01">Jan 1, 2024</time></span>
      <span style="color: #cbd5e1;">•</span>
      <span>Legal Review: <time datetime="2026-10-18">Oct 18, 2026</time></span>
    </div>
  </div>

  <article class="reading" style="max-width: 900px; margin: 0 auto; padding-bottom: 72px;">
    <!-- 1. AGE POLICY -->
    <div class="compliance-card" id="age-policy">
      <div class="compliance-badge">SECTION 01 · AGE RESTRICTION</div>
      <h2>How Does BOHOL Enforce 18+ Age Verification & Adult Audience Policies?</h2>
      <p>
        BOHOL designs, manufactures, and distributes adult novelty personal wellness devices and commercial intimate vending equipment. In compliance with the <strong>U.S. Children's Online Privacy Protection Act (COPPA)</strong>, the <strong>UK Online Safety Act</strong>, the <strong>European Union Digital Services Act (DSA)</strong>, and applicable international laws:
      </p>
      <ul>
        <li>This website is exclusively intended for consenting adults aged <strong>18 years or older</strong> (or the legal age of majority in your jurisdiction).</li>
        <li>Individuals under 18 years of age are strictly prohibited from accessing, browsing, submitting inquiries, or purchasing products through this platform.</li>
        <li>We employ digital age verification gatekeepers and do not knowingly solicit or collect personally identifiable information from minors. If you suspect a minor has accessed this site, please notify our compliance officer immediately at <a href="mailto:compliance@boholtech.com">compliance@boholtech.com</a>.</li>
      </ul>
    </div>

    <!-- 2. NOVELTY DISCLAIMER -->
    <div class="compliance-card" id="disclaimer">
      <div class="compliance-badge">SECTION 02 · REGULATORY STATUS</div>
      <h2>What Is BOHOL's Adult Novelty Product & Non-Medical Regulatory Status?</h2>
      <p>
        To ensure complete legal transparency and compliance with the <strong>U.S. Food and Drug Administration (FDA)</strong> guidelines and the <strong>EU Medical Device Regulation (MDR)</strong>:
      </p>
      <ul>
        <li>All products manufactured or showcased by BOHOL—including motorized suction massagers, automatic strokers, vibrators, and intimate wellness devices—are sold strictly as <strong>adult novelty goods and personal pleasure products</strong>.</li>
        <li><strong>No Medical Claims:</strong> These products are NOT medical devices. They are not intended to diagnose, treat, cure, mitigate, or prevent any disease, medical disorder, erectile dysfunction, pelvic organ prolapse, or any other pathological condition.</li>
        <li>No therapeutic, physiological, or anatomical claims are made or implied. Any experiential or ergonomic descriptions represent novelty design attributes only.</li>
      </ul>
    </div>

    <!-- 3. OEM / ODM BILATERAL NDA -->
    <div class="compliance-card" id="nda-terms">
      <div class="compliance-badge">SECTION 03 · INTELLECTUAL PROPERTY</div>
      <h2>How Does BOHOL Protect Client IP Under Bilateral OEM / ODM NDAs?</h2>
      <p>
        As a vertically integrated direct manufacturing partner supplying leading international brands across 60+ countries, BOHOL enforces rigorous intellectual property safeguards:
      </p>
      <ul>
        <li><strong>Bilateral Confidentiality:</strong> Prior to receiving client 3D CAD files, industrial ID drawings, circuit schematics, or branding artwork, BOHOL executes an enforceable bilateral Non-Disclosure Agreement governed by agreed international arbitration jurisdiction.</li>
        <li><strong>Exclusive Mold Ownership:</strong> Custom steel tooling fabricated under private-label contracts remains the 100% exclusive intellectual property of the commissioning client. Molds are tagged, cataloged, and never utilized for unauthorized production or third-party replication.</li>
        <li><strong>Supply Chain Air-Gap:</strong> Production schedules, component BOMs, and destination logistics manifests for OEM clients are partitioned within our ERP system to protect client confidentiality.</li>
      </ul>
    </div>

    <!-- 4. GDPR & CCPA -->
    <div class="compliance-card" id="data-privacy">
      <div class="compliance-badge">SECTION 04 · DATA PROTECTION</div>
      <h2>How Does BOHOL Safeguard Privacy Under GDPR, CCPA & Global Regulations?</h2>
      <p>
        BOHOL respects your privacy and adheres to the principles of the <strong>General Data Protection Regulation (GDPR - EU 2016/679)</strong> and the <strong>California Consumer Privacy Act (CCPA)</strong>:
      </p>
      <ul>
        <li><strong>Zero Unsolicited Data Resale:</strong> We never sell, rent, monetize, or disclose your company inquiries, contact details, or procurement lists to third-party data brokers or marketing networks.</li>
        <li><strong>Data Encryption & Security:</strong> All web submissions, RFQs, and communications are encrypted in transit via TLS 1.3 cryptographic protocols.</li>
        <li><strong>Right to Rectification & Erasure:</strong> Clients and site visitors have the absolute right to request an extract of their stored business contact records or demand immediate erasure from our CRM.</li>
      </ul>
    </div>

    <!-- 5. PACKAGING & LOGISTICS -->
    <div class="compliance-card" id="discreet-shipping">
      <div class="compliance-badge">SECTION 05 · LOGISTICS & SHIPPING</div>
      <h2>How Does BOHOL Ensure 100% Discreet Packaging & Hazardous Goods Compliance?</h2>
      <p>
        To ensure smooth customs clearance and complete recipient privacy:
      </p>
      <ul>
        <li><strong>Discreet Plain Packaging:</strong> All wholesale cartons, sample packs, and consumer parcels are dispatched in unbranded, neutral outer brown master cartons with zero exterior adult terminology, novelty imagery, or product indicators.</li>
        <li><strong>UN38.3 & MSDS Battery Compliance:</strong> All rechargeable hardware contains certified Grade-A lithium-polymer battery packs tested under UN Manual of Tests and Criteria Part III, Section 38.3. Full MSDS, air cargo (IATA DGR), and ocean freight (IMDG Code) manifests accompany containerized shipments.</li>
        <li><strong>International Customs Declarations:</strong> Shipments are classified under appropriate international Harmonized System (HS) codes (e.g. 8509.80 for electrical domestic appliances / personal massagers) with complete CE-EMC, RoHS 2.0, and FCC Class B certificates.</li>
      </ul>
    </div>

    <!-- Section: ISO / FDA Standards Citation -->
    <div style="margin: 32px 0; background: #ffffff; border-left: 4px solid #0284c7; padding: 18px 24px; border-radius: 0 12px 12px 0; box-shadow: 0 2px 8px rgba(15,23,42,0.04);">
      <blockquote style="margin: 0; font-size: 14px; line-height: 1.7; color: #334155;">
        "All manufacturing covenants and trade protocols strictly abide by ISO 13485:2016 medical device quality assurance directives and FDA 21 CFR § 177.2600 liquid silicone elastomer safety parameters. Official audit reports and testing certificates are made available to authorized partners under bilateral confidentiality."
        <footer style="margin-top: 8px; font-size: 12.5px; color: #64748b; font-weight: 600;">
          — Certified under <a href="https://www.iso.org/standard/59752.html" target="_blank" rel="noopener noreferrer" style="color: #0284c7; text-decoration: underline;">ISO 13485:2016</a> &amp; <a href="https://www.accessdata.fda.gov/scripts/cdrh/cfdocs/cfcfr/cfrsearch.cfm?fr=177.2600" target="_blank" rel="noopener noreferrer" style="color: #0284c7; text-decoration: underline;">FDA 21 CFR § 177.2600</a>
        </footer>
      </blockquote>
    </div>

    <div class="compliance-footer-box">
      <h3>Have a Compliance or Legal Inquiry?</h3>
      <p>Contact BOHOL Legal & Trade Compliance Directorate: <a href="mailto:legal@boholtech.com">legal@boholtech.com</a> · Tel / WhatsApp: <a href="https://wa.me/8618588583798">+86 185 8858 3798</a></p>
      <span>Last Updated: October 2026 · Effective Globally</span>
    </div>
  </article>
</Layout>

<style>
  .compliance-card {
    background: #ffffff;
    border: 1px solid var(--line-strong);
    border-radius: 16px;
    padding: 32px;
    margin-bottom: 28px;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
  }
  .compliance-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #2563eb;
    background: #eff6ff;
    padding: 4px 10px;
    border-radius: 6px;
    margin-bottom: 12px;
  }
  .compliance-card h2 {
    font-size: 20px;
    font-weight: 800;
    color: var(--navy-dark);
    margin: 0 0 14px;
  }
  .compliance-card p {
    font-size: 14.5px;
    color: #475569;
    line-height: 1.65;
    margin: 0 0 14px;
  }
  .compliance-card ul {
    margin: 0;
    padding-left: 20px;
  }
  .compliance-card li {
    font-size: 14px;
    color: #475569;
    line-height: 1.6;
    margin-bottom: 8px;
  }
  .compliance-card strong {
    color: #0f172a;
  }
  .compliance-footer-box {
    background: #f8fafc;
    border: 2px dashed #cbd5e1;
    border-radius: 16px;
    padding: 28px;
    text-align: center;
    margin-top: 40px;
  }
  .compliance-footer-box h3 {
    font-size: 18px;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 8px;
  }
  .compliance-footer-box p {
    font-size: 14px;
    color: #475569;
    margin: 0 0 8px;
  }
  .compliance-footer-box span {
    font-size: 12px;
    color: #94a3b8;
  }
</style>
