          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Always use compliant technical engineering terminology on the commercial invoice and packing list (e.g., "Handheld Electric Personal Wellness Massager with Battery" or "Molded Silicone Ergonomic Article"). Avoid colloquial or explicit slang words like "sex toy" or "dildo" which trigger moral holds.'
          }
        },
        {
          '@type': 'Question',
          name: 'Does BOHOL provide all-inclusive DDP shipping with pre-cleared customs?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. BOHOL provides full DDP (Delivered Duty Paid) door-to-door air freight (7-10 days) and ocean container freight (18-28 days) covering all import tariffs, customs clearance broker fees, and UN38.3 battery declarations.'
          }
        }
