    function updateCalculator() {
      const catKey = document.getElementById('productCategory').value;
      const mktKey = document.getElementById('destinationMarket').value;
      const data = database[catKey];
      if (!data) return;

      const mkt = data.markets[mktKey];

      document.getElementById('outputHsCode').textContent = data.hsCode;
      document.getElementById('outputHsDesc').textContent = data.hsDesc;
      document.getElementById('outputLocalCode').textContent = mkt.code;
      document.getElementById('outputDutyRate').textContent = 'Est. Duty: ' + mkt.duty;
      document.getElementById('outputDutyNote').textContent = mkt.note;
      document.getElementById('outputInvoiceText').textContent = data.invoice;

      const ulDossiers = document.getElementById('outputDossiers');
      ulDossiers.innerHTML = '';
      data.dossiers.forEach(d => {
        const li = document.createElement('li');
        li.className = 'flex items-center gap-1.5';
        li.innerHTML = '<span class="text-emerald-500 font-bold">✓</span> ' + d;
        ulDossiers.appendChild(li);
      });
    }

    document.getElementById('productCategory')?.addEventListener('change', updateCalculator);
    document.getElementById('destinationMarket')?.addEventListener('change', updateCalculator);

    document.getElementById('btnCopyInvoice')?.addEventListener('click', () => {
      const text = document.getElementById('outputInvoiceText').textContent;
      navigator.clipboard.writeText(text).then(() => {
        const btn = document.getElementById('btnCopyInvoice');
        const old = btn.textContent;
        btn.textContent = 'Copied!';
        btn.classList.add('bg-emerald-600');
        setTimeout(() => {
          btn.textContent = old;
          btn.classList.remove('bg-emerald-600');
        }, 2000);
      });
    });

    // Run on load
    updateCalculator();
  </script>
