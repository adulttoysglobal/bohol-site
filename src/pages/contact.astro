---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import settings from '../data/settings.json';
const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  '@id': 'https://adulttoysglobal.com/contact/#webpage',
  url: 'https://adulttoysglobal.com/contact/',
  name: 'BOHOL | Contact Global Headquarters, Factory Showroom & B2B Enquiries',
  description: 'Visit BOHOL 35,000 m² smart manufacturing headquarters, 500 m² flagship showroom, or book a live virtual factory walkthrough with our international trade team.',
  inLanguage: 'en-US',
  mainEntity: {
    '@type': 'Organization',
    name: 'BOHOL',
    url: 'https://adulttoysglobal.com',
    telephone: '+86-185-8858-3798',
    email: settings.contactEmail || 'adulttoysglobal1997@gmail.com',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Meizhou',
      addressRegion: 'Guangdong',
      addressCountry: 'CN'
    }
  },
  datePublished: '2024-01-01T08:00:00+08:00',
  dateModified: new Date().toISOString()
};
---
<Layout
  title="BOHOL | Contact Global Headquarters, Factory Showroom & B2B Enquiries"
  description="Visit BOHOL 35,000 m² smart manufacturing headquarters, 500 m² flagship showroom, or book a live virtual factory walkthrough with our international trade team."
  schema={contactSchema}
>
  <section class="page-head">
    <p class="eyebrow">GLOBAL HEADQUARTERS & FACTORY VISIT</p>
    <h1>Visit BOHOL.<br/>Let’s get specific.</h1>
    <p>Whether you're planning an in-person campus tour, a live virtual video audit, or negotiating private-label OEM contracts—our team is ready.</p>
    
    <div style="display: inline-flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 8px 14px; font-size: 13px; color: #475569; margin-top: 14px; padding: 6px 14px; background: #f8fafc; border-radius: 9999px; border: 1px solid #e2e8f0;">
      <span>Manufacturer: <strong>BOHOL</strong></span>
      <span>•</span>
      <span>24h B2B Trade Desk: <strong>Alex Chen &amp; Engineering Team</strong></span>
      <span>•</span>
      <span>Verified: <time datetime={new Date().toISOString().split('T')[0]}>{new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time></span>
    </div>
  </section>

  <section class="section" style="padding-top:10px">
    <div class="hq-banner-hero">
      <div class="hq-banner-card">
        <img src="/images/hq-lobby.webp" width="1024" height="768" loading="lazy" alt="BOHOL Global Headquarters Reception and Executive Lobby" />
        <div class="hq-banner-overlay">
          <span class="hq-banner-tag">EXECUTIVE HEADQUARTERS</span>
          <h3>Global Guest Reception & Campus Tours</h3>
          <p>Welcome international distributors, retail buyers, and brand partners for confidential OEM discussions and guided cleanroom inspections.</p>
        </div>
      </div>
      <div class="hq-banner-card">
        <img src="/images/hq-showroom.webp" width="1024" height="768" loading="lazy" alt="BOHOL 500 m² Flagship Product Experience Showroom" />
        <div class="hq-banner-overlay">
          <span class="hq-banner-tag">500 m² SHOWROOM</span>
          <h3>Flagship Experience & Sample Selection</h3>
          <p>Explore all 14 proprietary hardware series, custom gift box unboxing, POS vending hardware, and tactile medical-grade silicone finishes.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:20px">
    <div class="contact-columns">
      <div class="contact-column">
        <p class="eyebrow">FOR BUSINESS PARTNERS & DISTRIBUTORS</p>
        <h2>How Do You Submit Wholesale &amp; OEM Inquiries?</h2>
        <p>Shortlist product models, target destination markets, volume requirements, and private-label packaging details for a comprehensive quotation within 2 hours.</p>
        <a class="btn-primary" style="display:inline-flex; align-items:center; gap:8px; margin-top:16px; padding:12px 22px; font-size:14px;" href="/partners/#enquiry">
          Prepare RFQ Brief <Icon name="arrow-up-right"/>
        </a>
      </div>
      <div class="contact-column">
        <p class="eyebrow">SCHEDULE A CAMPUS OR VIRTUAL TOUR</p>
        <h2>How Can You Book a Showroom Walkthrough or Video Audit?</h2>
        <p>Schedule an in-person meeting at our 35,000 m² manufacturing campus or request a private 1-on-1 WhatsApp / Zoom video walkthrough with our senior project engineers.</p>
        <a class="btn-secondary" style="display:inline-flex; align-items:center; gap:8px; margin-top:16px; padding:12px 22px; font-size:14px;" href={`https://wa.me/${(settings.whatsapp || '8618588583798').replace(/\D/g,'')}`}>
          Book via WhatsApp <Icon name="arrow-up-right"/>
        </a>
      </div>
    </div>

    <div class="contact-details" style="margin-top:36px">
      <div>
        <h3>Manufacturing Campus & Headquarters</h3>
        <p>BOHOL Smart Manufacturing Headquarters · 35,000 m² Integrated Campus & 500 m² Showroom</p>
      </div>
      <div>
        <h3>Official Direct Channels</h3>
        {settings.contactEmail && (
          <p><a class="text-link" href={`mailto:${settings.contactEmail}`}>Email: {settings.contactEmail} <Icon name="arrow-up-right" size={15}/></a></p>
        )}
        {settings.whatsapp && (
          <p><a class="text-link" href={`https://wa.me/${settings.whatsapp.replace(/\D/g,'')}`}>WhatsApp: {settings.whatsapp} <Icon name="arrow-up-right" size={15}/></a></p>
        )}
        {settings.wechat && (
          <p style="margin-top:6px;"><span class="text-link" style="color:var(--text);">WeChat (微信): <strong>{settings.wechat}</strong> (+86 185 8858 3798)</span></p>
        )}
        <p style="font-size:12.5px; color:var(--text-muted); margin-top:6px;">Office Hours: Mon - Fri 09:00 - 18:00 (GMT+8) · 24/7 RFQ Response</p>
      </div>
    </div>
  </section>

  <!-- OFFICIAL SOCIAL MEDIA & COMMUNITY CHANNELS -->
  <section class="section contact-social-section">
    <div class="contact-social-head">
      <p class="eyebrow">GLOBAL COMMUNITY & MEDIA CHANNELS</p>
      <h2>Follow BOHOL Across Social Media.</h2>
      <p>Subscribe to our official corporate channels for live 4K cleanroom tours, private-mold teardowns, motor acoustic soundroom benchmarks, and international expo broadcasts.</p>
    </div>

    <div class="contact-social-grid">
      <!-- LinkedIn -->
      <a href={settings.social?.linkedin || "https://www.linkedin.com/company/bohol-wellness"} target="_blank" rel="noopener" class="contact-social-card">
        <div class="contact-social-card-top">
          <div class="contact-social-icon-box" style="background:#e0f2fe; color:#0284c7;">
            <svg viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9h2.8v8.37h-2.8V10.9M7.86 6.54a1.62 1.62 0 0 0-1.63 1.63c0 .9.73 1.63 1.63 1.63.9 0 1.63-.73 1.63-1.63 0-.9-.73-1.63-1.63-1.63Z"/></svg>
          </div>
          <div>
            <h3>LinkedIn</h3>
            <span>@bohol-wellness</span>
          </div>
        </div>
        <p>B2B executive network, corporate certifications, engineering whitepapers, and OEM procurement announcements.</p>
        <span class="contact-social-action">Connect on LinkedIn &rarr;</span>
      </a>

      <!-- YouTube -->
      <a href={settings.social?.youtube || "https://www.youtube.com/@bohol-manufacturing"} target="_blank" rel="noopener" class="contact-social-card">
        <div class="contact-social-card-top">
          <div class="contact-social-icon-box" style="background:#fee2e2; color:#ef4444;">
            <svg viewBox="0 0 24 24"><path d="m10 15 5.19-3L10 9v6m11.56-7.83c.13.47.22 1.1.28 1.9.07.8.1 1.49.1 2.09L22 12c0 2.19-.16 3.8-.44 4.83-.25.9-.83 1.48-1.73 1.73-.47.13-1.33.22-2.65.28-1.3.07-2.49.1-3.59.1L12 19c-4.19 0-6.8-.16-7.83-.44-.9-.25-1.48-.83-1.73-1.73-.13-.47-.22-1.1-.28-1.9-.07-.8-.1-1.49-.1-2.09L2 12c0-2.19.16-3.8.44-4.83.25-.9.83-1.48 1.73-1.73Z"/></svg>
          </div>
          <div>
            <h3>YouTube</h3>
            <span>@bohol-manufacturing</span>
          </div>
        </div>
        <p>4K smart factory cleanroom walkthroughs, 5-axis CNC tooling demonstrations, and waterproof immersion testing.</p>
        <span class="contact-social-action">Watch Factory Videos &rarr;</span>
      </a>

      <!-- Instagram -->
      <a href={settings.social?.instagram || "https://www.instagram.com/bohol_official"} target="_blank" rel="noopener" class="contact-social-card">
        <div class="contact-social-card-top">
          <div class="contact-social-icon-box" style="background:#fce7f3; color:#ec4899;">
            <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </div>
          <div>
            <h3>Instagram</h3>
            <span>@bohol_official</span>
          </div>
        </div>
        <p>Curated product aesthetics, Pantone color swatches, tactile medical silicone photography, and luxury retail packaging.</p>
        <span class="contact-social-action">Follow on Instagram &rarr;</span>
      </a>

      <!-- Facebook -->
      <a href={settings.social?.facebook || "https://www.facebook.com/boholwellness"} target="_blank" rel="noopener" class="contact-social-card">
        <div class="contact-social-card-top">
          <div class="contact-social-icon-box" style="background:#dbeafe; color:#2563eb;">
            <svg viewBox="0 0 24 24"><path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z"/></svg>
          </div>
          <div>
            <h3>Facebook</h3>
            <span>@boholwellness</span>
          </div>
        </div>
        <p>Global buyer community, international wellness trade expo updates, and distributor partnership stories.</p>
        <span class="contact-social-action">Follow on Facebook &rarr;</span>
      </a>

      <!-- TikTok -->
      <a href={settings.social?.tiktok || "https://www.tiktok.com/@bohol_hardware"} target="_blank" rel="noopener" class="contact-social-card">
        <div class="contact-social-card-top">
          <div class="contact-social-icon-box" style="background:#f1f5f9; color:#0f172a;">
            <svg viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.82 4.49 6.3 6.3 0 0 0 1.86-4.49V8.58a8.28 8.28 0 0 0 4.84 1.56V6.69h-.93z"/></svg>
          </div>
          <div>
            <h3>TikTok</h3>
            <span>@bohol_hardware</span>
          </div>
        </div>
        <p>Viral hardware features, acoustic whisper noise benchmarks, ergonomic comparisons, and creative micro-demos.</p>
        <span class="contact-social-action">Explore on TikTok &rarr;</span>
      </a>

      <!-- WhatsApp Live Chat -->
      <a href="https://wa.me/8618588583798" target="_blank" rel="noopener" class="contact-social-card">
        <div class="contact-social-card-top">
          <div class="contact-social-icon-box" style="background:#dcfce7; color:#16a34a;">
            <svg viewBox="0 0 24 24"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.19-.09-1.12-.55-1.3-.61-.17-.07-.3-.1-.42.1-.13.19-.48.61-.59.74-.11.12-.22.14-.4.05-.19-.09-.79-.29-1.5-.93-.56-.49-.93-1.11-1.04-1.3-.11-.19-.01-.29.08-.38.08-.08.19-.22.28-.33.09-.11.13-.19.19-.31.06-.13.03-.24-.01-.33-.05-.09-.42-1.01-.58-1.39-.15-.36-.31-.31-.42-.32h-.36c-.13 0-.33.05-.5.24-.17.19-.66.65-.66 1.58 0 .93.68 1.83.77 1.96.09.12 1.33 2.04 3.23 2.86.45.19.81.31 1.08.4.45.14.86.12 1.19.07.36-.05 1.12-.46 1.28-.9.16-.45.16-.83.11-.91-.04-.08-.17-.13-.36-.23"/></svg>
          </div>
          <div>
            <h3>WhatsApp Desk</h3>
            <span>+86 185 8858 3798</span>
          </div>
        </div>
        <p>Direct 1-on-1 private inquiry desk with bilingual project managers, sample reservations, and live video audit calls.</p>
        <span class="contact-social-action">Chat on WhatsApp &rarr;</span>
      </a>

      <!-- WeChat Direct -->
      <div class="contact-social-card" style="cursor:default;">
        <div class="contact-social-card-top">
          <div class="contact-social-icon-box" style="background:#ecfdf5; color:#059669;">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8.5 2C4.36 2 1 4.91 1 8.5c0 2.05 1.07 3.88 2.75 5.09l-.72 2.16 2.53-1.27c.61.18 1.26.27 1.94.27.35 0 .7-.03 1.04-.08A7.37 7.37 0 0 1 8 13c0-3.87 3.58-7 8-7 .4 0 .79.03 1.17.08C16.14 3.73 12.61 2 8.5 2zm-2.25 4a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5zm5 0a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5zM16 8c-3.87 0-7 2.69-7 6s3.13 6 7 6c.6 0 1.18-.08 1.73-.24l2.17 1.09-.61-1.84C20.67 17.9 22 16.08 22 14c0-3.31-3.13-6-7-6zm-2 3.5a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm4.5 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/></svg>
          </div>
          <div>
            <h3>WeChat (微信)</h3>
            <span>18588583798</span>
          </div>
        </div>
        <p>Add directly via WeChat ID or phone number <strong>18588583798</strong> for instant product catalogs, live factory videos, and rapid quoting.</p>
        <span class="contact-social-action" style="color:#059669;">WeChat ID: 18588583798</span>
      </div>
    </div>
  </section>
</Layout>
