---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import settings from '../data/settings.json';

const rfqSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ContactPage',
      '@id': 'https://adulttoysglobal.com/rfq/#page',
      url: 'https://adulttoysglobal.com/rfq/',
      name: 'Request for Quotation (RFQ) & International Shipping Freight Calculator | BOHOL',
      description: 'Select multiple products from BOHOL catalog, configure target wholesale volumes, and request direct factory pricing with DDP customs-cleared freight.',
      inLanguage: 'en-US',
      datePublished: '2024-01-01T08:00:00+08:00',
      dateModified: new Date().toISOString(),
      author: {
        '@type': 'Person',
        name: 'Alex Chen',
        jobTitle: 'Chief International Logistics & Wholesale Director',
        worksFor: {
          '@type': 'Organization',
          name: 'BOHOL'
        },
        url: 'https://adulttoysglobal.com/about/'
      },
      publisher: {
        '@type': 'Organization',
        name: 'BOHOL',
        url: 'https://adulttoysglobal.com'
      }
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://adulttoysglobal.com/rfq/#faq',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'How does BOHOL calculate international shipping freight?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'We partner with premier international air couriers (DHL, FedEx, UPS) and dedicated DDP air/sea freight lines. Freight is calculated on either actual gross weight or volumetric weight (L×W×H / 5000), whichever is greater.'
          }
        },
        {
          '@type': 'Question',
          name: 'What is DDP shipping and does it include customs clearance?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'DDP (Delivered Duty Paid) is our turnkey shipping option for the US, UK, EU, Canada, and Australia. The carrier handles all customs clearance, pays import duties and VAT, and delivers directly to your facility.'
          }
        }
      ]
    }
  ]
};
---
<Layout
  title="Request for Quotation (RFQ) & International Shipping Freight Calculator | BOHOL"
  description="Select multiple products from BOHOL catalog, specify target quantities and packaging preferences, and request factory wholesale pricing and DDP/Air/Sea freight calculation."
  schema={rfqSchema}
>
  <!-- Page Header -->
  <section class="page-head rfq-page-hero">
    <p class="eyebrow">B2B EXPORT PORTAL · FACTORY WHOLESALE & LOGISTICS QUOTATION</p>
    <h1>Multi-Product Inquiry & Freight Request</h1>
    <p>Review your selected hardware models, set wholesale volumes and custom packaging options, and submit your destination port to receive consolidated factory quotations and door-to-door DDP freight rates.</p>
  </section>

  <!-- AUTHOR BYLINE & MACHINE-READABLE FRESHNESS SIGNALS -->
  <div class="geo-byline-bar" style="max-width: 1200px; margin: 1.25rem auto 2.5rem; padding: 0 1.5rem;">
    <div style="display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 8px 14px; font-size: 13px; color: #475569; padding: 8px 18px; background: #f8fafc; border-radius: 9999px; border: 1px solid #e2e8f0;">
      <span>🏭 Direct Factory Trade Desk: <strong>BOHOL International Logistics</strong></span>
      <span style="color: #cbd5e1;">•</span>
      <span>Logistics Director: <a href="/about/" style="color: #0284c7; text-decoration: underline; font-weight: 700;">Alex Chen</a></span>
      <span style="color: #cbd5e1;">•</span>
      <span>Tariff &amp; Freight Rates Updated: <time datetime="2026-10-18">Oct 18, 2026 (Daily Sync)</time></span>
    </div>
  </div>

  <section class="section rfq-main-section">
    <div class="rfq-page-grid">
      <!-- Left Column: Selected Products Table -->
      <div class="rfq-table-col">
        <div class="rfq-card">
          <div class="rfq-card-header">
            <div>
              <h2>Which Hardware SKUs Are in Your RFQ Batch? (<span id="rfq-page-item-count">0</span>)</h2>
              <p>Configure wholesale quantities and packaging preferences per product.</p>
            </div>
            <div class="rfq-card-actions">
              <button type="button" class="btn-secondary" id="rfq-page-clear-btn">Clear List</button>
              <a href="/products/" class="btn-primary">+ Add More Products</a>
            </div>
          </div>

          <!-- Empty State -->
          <div id="rfq-page-empty" class="rfq-page-empty-box">
            <div class="rfq-empty-emoji">📋</div>
            <h3>Your Inquiry List is Empty</h3>
            <p>You have not selected any models yet. Browse our wholesale catalog and click <strong>"+ Add to RFQ"</strong> on any product to consolidate multiple models into one quotation.</p>
            <div class="rfq-empty-shortcuts">
              <a href="/products/?subcat=Men's Toys" class="rfq-shortcut-pill">Men's Toys (24)</a>
              <a href="/products/?subcat=Women's Toys" class="rfq-shortcut-pill">Women's Toys (25)</a>
              <a href="/products/?subcat=Sexy Lingerie" class="rfq-shortcut-pill">Sexy Lingerie (32)</a>
              <a href="/products/?subcat=BDSM & Fetish" class="rfq-shortcut-pill">BDSM & Fetish (27)</a>
              <a href="/products/?subcat=Condoms" class="rfq-shortcut-pill">Condoms (28)</a>
              <a href="/products/?subcat=Lubricants & Care" class="rfq-shortcut-pill">Lubricants (20)</a>
            </div>
          </div>

          <!-- Items Table -->
          <div id="rfq-page-table-wrap" class="rfq-table-wrapper" hidden>
            <table class="rfq-table">
              <thead>
                <tr>
                  <th>Product</th>
                  <th>SKU / Category</th>
                  <th>Quantity (pcs)</th>
                  <th>Packaging Option</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody id="rfq-page-tbody">
                <!-- Populated via script -->
              </tbody>
            </table>
          </div>

          <!-- Volume & Weight Estimator Bar -->
          <div id="rfq-page-estimator" class="rfq-estimator-bar" hidden>
            <div class="rfq-est-item">
              <span>Total Selected Items:</span>
              <strong id="rfq-est-models">0 Models</strong>
            </div>
            <div class="rfq-est-item">
              <span>Total Batch Quantity:</span>
              <strong id="rfq-est-units">0 Units</strong>
            </div>
            <div class="rfq-est-item">
              <span>Estimated Shipping Weight:</span>
              <strong id="rfq-est-weight">~0.0 kg</strong>
            </div>
            <div class="rfq-est-item">
              <span>Packaging Type:</span>
              <strong id="rfq-est-pack">Double-Boxed Corrugated</strong>
            </div>
          </div>
        </div>

        <!-- B2B Freight & Quotation FAQ Accordion -->
        <div class="rfq-faq-card">
          <h2>How Do BOHOL International Freight & Turnkey Quotations Work?</h2>
          <div class="rfq-faq-list">
            <details class="rfq-faq-item" open>
              <summary>How does BOHOL calculate international shipping freight?</summary>
              <p>We partner with premier international air couriers (DHL, FedEx, UPS) and dedicated DDP (Delivered Duty Paid) air/sea freight lines. Freight is calculated on either actual gross weight or volumetric weight (L×W×H / 5000), whichever is greater. Providing your exact city and postal code ensures we obtain real-time daily discounted contract rates.</p>
            </details>
            <details class="rfq-faq-item">
              <summary>What is DDP shipping and does it include customs clearance?</summary>
              <p>Yes. <strong>DDP (Delivered Duty Paid)</strong> is our most popular option for international clients in the US, UK, EU, Canada, and Australia. Under DDP terms, our freight forwarder handles all export and import customs declarations, covers all tariff duties and VAT, and delivers directly to your door or warehouse with zero paperwork required on your end.</p>
            </details>
            <details class="rfq-faq-item">
              <summary>Can we mix different products to reach Minimum Order Quantities (MOQ)?</summary>
              <p>Yes. We actively encourage multi-product consolidation. You can mix vibrators, strokers, lingerie, and accessories in a single shipment to optimize volumetric shipping efficiency and reduce per-unit freight costs significantly.</p>
            </details>
            <details class="rfq-faq-item">
              <summary>Are product packages 100% discreet for overseas customs?</summary>
              <p>Every order is packed in plain, double-walled brown or white corrugated cartons with neutral commercial invoices and zero adult-related labels or logos. Customs descriptions are strictly standardized under compliant consumer hardware / wellness categories.</p>
            </details>
          </div>
        </div>

        <!-- Section: ISO / FDA Standards Citation -->
        <div style="margin: 24px 0; background: #ffffff; border-left: 4px solid #0284c7; padding: 18px 20px; border-radius: 0 12px 12px 0; box-shadow: 0 2px 8px rgba(15,23,42,0.04);">
          <blockquote style="margin: 0; font-size: 13.5px; line-height: 1.6; color: #334155;">
            "Consolidated export shipments strictly conform to ISO 13485:2016 quality traceability standards and FDA 21 CFR § 177.2600 biocompatibility certifications. Every lithium battery consignment is accompanied by verified UN38.3 MSDS documents for accelerated airport and seaport clearance."
            <footer style="margin-top: 8px; font-size: 12px; color: #64748b; font-weight: 600;">
              — Certified under <a href="https://www.iso.org/standard/59752.html" target="_blank" rel="noopener noreferrer" style="color: #0284c7; text-decoration: underline;">ISO 13485:2016</a> &amp; <a href="https://www.accessdata.fda.gov/scripts/cdrh/cfdocs/cfcfr/cfrsearch.cfm?fr=177.2600" target="_blank" rel="noopener noreferrer" style="color: #0284c7; text-decoration: underline;">FDA 21 CFR § 177.2600</a>
            </footer>
          </blockquote>
        </div>
      </div>

      <!-- Right Column: Freight & Quote Submission Form -->
      <div class="rfq-form-col">
        <div class="rfq-card rfq-form-sticky">
          <div class="rfq-card-header">
            <div>
              <h2>Where Should BOHOL Send Your Direct Factory Quotation?</h2>
              <p>Where should we ship and send your official quotation?</p>
            </div>
          </div>

          <form id="rfq-full-form" class="rfq-full-form">
            <div class="rfq-form-block">
              <h3>Shipping Destination (For Freight Calculation)</h3>
              
              <div class="rfq-field">
                <label for="rfq-full-country">Destination Country <em>*</em></label>
                <select id="rfq-full-country" name="country" required>
                  <option value="United States">United States (USA)</option>
                  <option value="United Kingdom">United Kingdom (UK)</option>
                  <option value="Canada">Canada</option>
                  <option value="Australia">Australia</option>
                  <option value="Germany">Germany</option>
                  <option value="France">France</option>
                  <option value="Italy">Italy</option>
                  <option value="Spain">Spain</option>
                  <option value="Netherlands">Netherlands</option>
                  <option value="Japan">Japan</option>
                  <option value="South Korea">South Korea</option>
                  <option value="Singapore">Singapore</option>
                  <option value="New Zealand">New Zealand</option>
                  <option value="United Arab Emirates">United Arab Emirates</option>
                  <option value="Mexico">Mexico</option>
                  <option value="Brazil">Brazil</option>
                  <option value="South Africa">South Africa</option>
                  <option value="Other International">Other (Specify in address)</option>
                </select>
              </div>

              <div class="rfq-field">
                <label for="rfq-full-address">City, State & Postal / ZIP Code <em>*</em></label>
                <input type="text" id="rfq-full-address" name="destinationAddress" placeholder="e.g. Los Angeles, CA 90001" required />
              </div>

              <div class="rfq-field">
                <label for="rfq-full-shipping">Preferred Logistics Method</label>
                <select id="rfq-full-shipping" name="shippingMode">
                  <option value="DDP Dedicated Air Line (8-12 Days · Customs & Duty Included)">DDP Dedicated Air Line (8-12 Days · Tax Included) [Recommended]</option>
                  <option value="Air Express (3-5 Days · DHL / FedEx / UPS Express)">Air Express (3-5 Days · DHL / FedEx / UPS Express)</option>
                  <option value="DDP Sea / Ocean Freight (25-35 Days · Lowest Cost for Bulk)">DDP Sea / Ocean Freight (25-35 Days · Lowest Cost for Bulk)</option>
                  <option value="EXW / FOB China (Nominated Forwarder in China)">EXW / FOB China (Nominated Forwarder in China)</option>
                </select>
              </div>
            </div>

            <div class="rfq-form-block">
              <h3>Contact & Business Details</h3>

              <div class="rfq-field">
                <label for="rfq-full-name">Full Name <em>*</em></label>
                <input type="text" id="rfq-full-name" name="name" placeholder="Contact person name" autocomplete="name" required />
              </div>

              <div class="rfq-field">
                <label for="rfq-full-company">Company / Boutique / Brand Name</label>
                <input type="text" id="rfq-full-company" name="company" placeholder="e.g. Lotus Intimates Boutique" autocomplete="organization" />
              </div>

              <div class="rfq-field">
                <label for="rfq-full-email">Business Email <em>*</em></label>
                <input type="email" id="rfq-full-email" name="email" placeholder="buyer@company.com" autocomplete="email" required />
              </div>

              <div class="rfq-field">
                <label for="rfq-full-phone">WhatsApp / Phone <em>*</em></label>
                <input type="tel" id="rfq-full-phone" name="phone" placeholder="+1 / +44 / +86 ... (For instant quote)" autocomplete="tel" required />
              </div>

              <div class="rfq-field">
                <label for="rfq-full-type">Business Model</label>
                <select id="rfq-full-type" name="businessType">
                  <option value="Retail Store / Boutique Owner">Retail Store / Boutique Owner</option>
                  <option value="Amazon / Shopify / Online Seller">Amazon / Shopify / Online Seller</option>
                  <option value="Wholesale Distributor / Importer">Wholesale Distributor / Importer</option>
                  <option value="Brand Owner Seeking OEM / ODM">Brand Owner Seeking OEM / ODM</option>
                  <option value="Sample Evaluation Order">Sample Evaluation Order</option>
                </select>
              </div>

              <div class="rfq-field">
                <label for="rfq-full-message">Special Requirements / Customization Notes</label>
                <textarea id="rfq-full-message" name="message" rows="3" placeholder="Specify if you require custom laser branding, multilingual user manuals, special carton marking, or target FOB prices..."></textarea>
              </div>
            </div>

            <!-- Honeypot -->
            <input type="text" name="website_hp" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;opacity:0;height:0;width:0" />

            <div id="rfq-full-status" class="rfq-submit-status" hidden></div>

            <div class="rfq-submit-actions">
              <button type="submit" class="btn-primary rfq-btn-block" id="rfq-full-submit-btn">
                <span>Submit Multi-Product RFQ & Freight Calculation</span>
                <Icon name="arrow-up-right" size={18} />
              </button>

              <button type="button" class="rfq-btn-whatsapp rfq-btn-block" id="rfq-full-whatsapp-btn">
                <svg width="18" height="18" viewBox="0 0 448 512" fill="currentColor">
                  <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
                </svg>
                <span>Instant Quote on WhatsApp</span>
              </button>

              <button type="button" class="btn-secondary rfq-btn-block" id="rfq-full-copy-btn">
                <span>📋 Copy Quotation Brief to Clipboard</span>
              </button>
            </div>

            <div class="rfq-guarantee-box">
              <p>🔒 <strong>Factory Direct Guarantee:</strong> Protected under standard international mutual NDA. Zero disclosure to third parties. Quotes delivered within 12-24 business hours.</p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <script>
    import {
      getRfqCart,
      removeFromRfqCart,
      updateRfqCartQty,
      updateRfqCartPackaging,
      clearRfqCart,
      buildRfqSummaryText,
      buildRfqWhatsAppUrl,
      saveRfqLead
    } from '../lib/rfqCart.js';

    const itemCountEl = document.querySelector<HTMLElement>('#rfq-page-item-count');
    const emptyBox = document.querySelector<HTMLElement>('#rfq-page-empty');
    const tableWrap = document.querySelector<HTMLElement>('#rfq-page-table-wrap');
    const tbody = document.querySelector<HTMLElement>('#rfq-page-tbody');
    const estimatorBar = document.querySelector<HTMLElement>('#rfq-page-estimator');
    const estModels = document.querySelector<HTMLElement>('#rfq-est-models');
    const estUnits = document.querySelector<HTMLElement>('#rfq-est-units');
    const estWeight = document.querySelector<HTMLElement>('#rfq-est-weight');
    const clearBtn = document.querySelector<HTMLButtonElement>('#rfq-page-clear-btn');
    const fullForm = document.querySelector<HTMLFormElement>('#rfq-full-form');
    const submitBtn = document.querySelector<HTMLButtonElement>('#rfq-full-submit-btn');
    const statusBox = document.querySelector<HTMLElement>('#rfq-full-status');
    const whatsappBtn = document.querySelector<HTMLButtonElement>('#rfq-full-whatsapp-btn');
    const copyBtn = document.querySelector<HTMLButtonElement>('#rfq-full-copy-btn');

    function renderPageTable() {
      const items = getRfqCart();
      const count = items.length;
      const totalUnits = items.reduce((sum, i) => sum + (i.quantity || 50), 0);
      const estKg = (totalUnits * 0.18).toFixed(1);

      if (itemCountEl) itemCountEl.textContent = String(count);

      if (count === 0) {
        if (emptyBox) emptyBox.hidden = false;
        if (tableWrap) tableWrap.hidden = true;
        if (estimatorBar) estimatorBar.hidden = true;
        if (tbody) tbody.innerHTML = '';
        return;
      }

      if (emptyBox) emptyBox.hidden = true;
      if (tableWrap) tableWrap.hidden = false;
      if (estimatorBar) {
        estimatorBar.hidden = false;
        if (estModels) estModels.textContent = `${count} Models`;
        if (estUnits) estUnits.textContent = `${totalUnits} Units`;
        if (estWeight) estWeight.textContent = `~${estKg} kg`;
      }

      if (tbody) {
        tbody.innerHTML = items
          .map(
            (item) => `
          <tr>
            <td>
              <div class="rfq-td-prod">
                <img src="${item.image}" alt="${item.name}" width="54" height="54" />
                <div>
                  <strong>${item.name}</strong>
                  <span>Vendor: ${item.vendor || 'BOHOL Direct OEM'}</span>
                </div>
              </div>
            </td>
            <td>
              <span class="rfq-sku-badge">${item.code || item.id}</span>
              <div class="rfq-subcat-txt">${item.subCategory || item.category}</div>
            </td>
            <td>
              <div class="rfq-page-stepper">
                <button type="button" class="rfq-page-step-btn" data-page-sub="${item.id}">-</button>
                <input type="number" class="rfq-page-qty-input" data-page-qty="${item.id}" value="${item.quantity || 50}" min="1" step="25" />
                <button type="button" class="rfq-page-step-btn" data-page-add="${item.id}">+</button>
              </div>
            </td>
            <td>
              <select class="rfq-page-pack-select" data-page-pack="${item.id}">
                <option value="100% Discreet Box" ${item.packaging === '100% Discreet Box' ? 'selected' : ''}>100% Discreet Box</option>
                <option value="Brand Retail Box" ${item.packaging === 'Brand Retail Box' ? 'selected' : ''}>Brand Retail Box</option>
                <option value="Custom OEM Private Label" ${item.packaging === 'Custom OEM Private Label' ? 'selected' : ''}>OEM Custom Box</option>
              </select>
            </td>
            <td>
              <button type="button" class="rfq-page-del-btn" data-page-del="${item.id}">✕ Remove</button>
            </td>
          </tr>
        `
          )
          .join('');

        tbody.querySelectorAll<HTMLButtonElement>('[data-page-del]').forEach((b) => {
          b.addEventListener('click', () => {
            removeFromRfqCart(b.dataset.pageDel!);
            renderPageTable();
          });
        });

        tbody.querySelectorAll<HTMLInputElement>('[data-page-qty]').forEach((inp) => {
          inp.addEventListener('change', () => {
            updateRfqCartQty(inp.dataset.pageQty!, inp.value);
            renderPageTable();
          });
        });

        tbody.querySelectorAll<HTMLButtonElement>('[data-page-sub]').forEach((b) => {
          b.addEventListener('click', () => {
            const id = b.dataset.pageSub!;
            const item = items.find((i) => i.id === id);
            if (item) {
              updateRfqCartQty(id, Math.max(1, (item.quantity || 50) - 25));
              renderPageTable();
            }
          });
        });

        tbody.querySelectorAll<HTMLButtonElement>('[data-page-add]').forEach((b) => {
          b.addEventListener('click', () => {
            const id = b.dataset.pageAdd!;
            const item = items.find((i) => i.id === id);
            if (item) {
              updateRfqCartQty(id, (item.quantity || 50) + 50);
              renderPageTable();
            }
          });
        });

        tbody.querySelectorAll<HTMLSelectElement>('[data-page-pack]').forEach((sel) => {
          sel.addEventListener('change', () => {
            updateRfqCartPackaging(sel.dataset.pagePack!, sel.value);
          });
        });
      }
    }

    clearBtn?.addEventListener('click', () => {
      if (confirm('Clear all products from your quote list?')) {
        clearRfqCart();
        renderPageTable();
      }
    });

    window.addEventListener('rfq-cart-updated', renderPageTable);
    renderPageTable();

    function getFullFormData() {
      if (!fullForm) return {};
      const fd = new FormData(fullForm);
      return {
        country: String(fd.get('country') || ''),
        destinationAddress: String(fd.get('destinationAddress') || ''),
        shippingMode: String(fd.get('shippingMode') || ''),
        name: String(fd.get('name') || ''),
        company: String(fd.get('company') || ''),
        email: String(fd.get('email') || ''),
        phone: String(fd.get('phone') || ''),
        businessType: String(fd.get('businessType') || ''),
        message: String(fd.get('message') || ''),
        website_hp: String(fd.get('website_hp') || '')
      };
    }

    fullForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const items = getRfqCart();
      if (!items.length) {
        alert('Please select at least 1 product from the catalog before submitting.');
        return;
      }

      const data = getFullFormData();
      if (data.website_hp) return;

      const refId = generateRfqId();
      const payload = {
        id: refId,
        source: 'Website Multi-Product RFQ Page',
        submittedAt: new Date().toISOString(),
        ...data,
        models: items.map((i) => `${i.name} (${i.code || i.id}) x ${i.quantity} [${i.packaging}]`),
        rawItems: items,
        totalUnits: items.reduce((sum, i) => sum + (i.quantity || 0), 0)
      };

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span>Calculating & Submitting...</span>';
      }

      if (statusBox) {
        statusBox.hidden = false;
        statusBox.className = 'rfq-submit-status rfq-status-pending';
        statusBox.textContent = 'Recording your multi-product quotation and dispatching to logistics...';
      }

      await saveRfqLead(payload);

      setTimeout(() => {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<span>✓ Quotation Request Submitted</span>';
        }
        if (statusBox) {
          statusBox.className = 'rfq-submit-status rfq-status-ok';
          statusBox.innerHTML = `
            <strong>✓ Quotation & Freight Request Received (Ref: ${refId})!</strong>
            <p>Our sales and logistics team is calculating real-time freight to <strong>${data.destinationAddress}, ${data.country}</strong>. An official FOB/DDP quotation sheet will be sent to <strong>${data.email}</strong> within 12 hours.</p>
          `;
        }
      }, 700);
    });

    whatsappBtn?.addEventListener('click', () => {
      const items = getRfqCart();
      if (!items.length) {
        alert('Please select products first.');
        return;
      }
      const data = getFullFormData();
      const url = buildRfqWhatsAppUrl(data, items, '+8618588583798');
      window.open(url, '_blank');
    });

    copyBtn?.addEventListener('click', async () => {
      const items = getRfqCart();
      if (!items.length) {
        alert('Please select products first.');
        return;
      }
      const data = getFullFormData();
      const brief = buildRfqSummaryText(data, items);
      try {
        await navigator.clipboard.writeText(brief);
        if (statusBox) {
          statusBox.hidden = false;
          statusBox.className = 'rfq-submit-status rfq-status-ok';
          statusBox.textContent = '✓ Complete quotation brief copied to clipboard! You can paste it into WhatsApp, WeChat, or email.';
        }
      } catch {
        alert('Copied summary to clipboard.');
      }
    });
  </script>

