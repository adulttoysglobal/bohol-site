---
import {getCollection} from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
const products=(await getCollection('products')).sort((a,b)=>a.data.order-b.data.order);
---
<Layout title="Product catalogue — designs and published specifications" description="Browse the complete BOHOL product catalogue with photos, published specifications and links to product enquiries. Print or save a copy for reference."><section class="page-head"><p class="eyebrow">THE PRODUCT CATALOGUE</p><h1>The collection,<br/>at a glance.</h1><p>{products.length} product designs with available specifications. A practical reference for comparing products and preparing an enquiry.</p><div class="catalogue-toolbar"><button class="button primary" id="print-catalogue" hidden>Print / save as PDF <Icon name="arrow-down"/></button><a href="/partners/" class="text-link">Prepare a product enquiry <Icon name="arrow-up-right"/></a></div></section><section class="section" style="padding-top:20px">{products.map(p=><article class="catalogue-entry" id={p.id}><img src={p.data.image} alt={p.data.name} width="800" height="800" loading="lazy"/><div><p class="eyebrow">{p.data.label}</p><h2>{p.data.name}</h2><p>{p.data.description}</p><dl class="catalogue-specs">{p.data.specs.map(spec=><div><dt>{spec.label}</dt><dd>{spec.value}</dd></div>)}</dl><a class="text-link" href={`/products/${p.id}/`}>Full product details <Icon name="arrow-up-right" size={16}/></a></div></article>)}</section><script>const button=document.querySelector<HTMLButtonElement>('#print-catalogue');if(button){button.hidden=false;button.addEventListener('click',()=>window.print());}</script></Layout>
