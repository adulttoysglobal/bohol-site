---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);

const catalogueSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': 'https://adulttoysglobal.com/catalogue/#collection',
      url: 'https://adulttoysglobal.com/catalogue/',
      name: 'BOHOL Complete Hardware & Vending Product Catalogue',
      description: 'Comprehensive catalogue featuring 38 proprietary hardware models and commercial vending kiosks with published factory specifications.',
      inLanguage: 'en-US',
      datePublished: '2024-01-01T08:00:00+08:00',
      dateModified: new Date().toISOString(),
      author: {
        '@type': 'Person',
        name: 'Alex Chen',
        jobTitle: 'Chief Hardware Architect & Catalog Curator',
        worksFor: {
          '@type': 'Organization',
          name: 'BOHOL'
        },
        url: 'https://adulttoysglobal.com/about/'
      },
      publisher: {
        '@type': 'Organization',
        name: 'BOHOL',
        url: 'https://adulttoysglobal.com',
        logo: {
          '@type': 'ImageObject',
          url: 'https://adulttoysglobal.com/images/bohol-logo-horiz-dark.webp'
        }
      }
    },
    {
      '@type': 'ItemList',
      '@id': 'https://adulttoysglobal.com/catalogue/#itemlist',
      name: 'BOHOL Catalogue Items',
      numberOfItems: products.length,
      itemListElement: products.map((prod, idx) => ({
        '@type': 'ListItem',
        position: idx + 1,
        item: {
          '@type': 'Product',
          name: prod.data.name,
          description: prod.data.description,
          image: new URL(prod.data.image, 'https://adulttoysglobal.com').href,
          brand: {
            '@type': 'Brand',
            name: 'BOHOL'
          },
          manufacturer: {
            '@type': 'Organization',
            name: 'BOHOL'
          },
          offers: {
            '@type': 'Offer',
            priceCurrency: 'USD',
            price: prod.data.price ? prod.data.price.replace(/[^0-9.]/g, '') || '28.00' : '28.00',
            availability: 'https://schema.org/InStock',
            url: `https://adulttoysglobal.com/products/${prod.id}/`
          }
        }
      }))
    }
  ]
};
---
<Layout
  title="Product Catalogue — Complete Designs, Specifications & Print View | BOHOL"
  description="Browse the complete BOHOL product catalogue with high-resolution photos, published specifications, wholesale pricing parameters, and direct RFQ enquiry links."
  schema={catalogueSchema}
>
  <section class="page-head">
    <p class="eyebrow">THE PRODUCT CATALOGUE</p>
    <h1>The Collection,<br/>at a Glance.</h1>
    <p>{products.length} proprietary designs and commercial retail kiosks with verified factory specifications. A practical reference for comparing products, calculating container space, and preparing wholesale orders.</p>
    <div class="catalogue-toolbar" style="margin-top: 20px;">
      <button class="button primary" id="print-catalogue" hidden>Print / Save as PDF <Icon name="arrow-down"/></button>
      <a href="/partners/" class="text-link">Prepare a product enquiry <Icon name="arrow-up-right"/></a>
    </div>
  </section>

  <!-- AUTHOR BYLINE & MACHINE-READABLE FRESHNESS SIGNALS -->
  <div class="geo-byline-bar" style="max-width: 1200px; margin: 1.25rem auto 2.5rem; padding: 0 1.5rem;">
    <div style="display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 8px 14px; font-size: 13px; color: #475569; padding: 8px 18px; background: #f8fafc; border-radius: 9999px; border: 1px solid #e2e8f0;">
      <span>🏭 Verified Manufacturer: <strong>BOHOL</strong></span>
      <span style="color: #cbd5e1;">•</span>
      <span>Catalog Architect: <a href="/about/" style="color: #0284c7; text-decoration: underline; font-weight: 700;">Alex Chen</a></span>
      <span style="color: #cbd5e1;">•</span>
      <span>Published: <time datetime="2024-01-01">Jan 1, 2024</time></span>
      <span style="color: #cbd5e1;">•</span>
      <span>Inventory Synchronized: <time datetime="2026-10-18">Oct 18, 2026</time></span>
    </div>
  </div>

  <section class="section" style="padding-top: 10px;">
    {products.map(p => (
      <article class="catalogue-entry" id={p.id}>
        <img src={p.data.image} alt={p.data.name} width="800" height="800" loading="lazy"/>
        <div>
          <p class="eyebrow">{p.data.label}</p>
          <h2>{p.data.name}</h2>
          <p>{p.data.description}</p>
          <dl class="catalogue-specs">
            {p.data.specs.map(spec => (
              <div>
                <dt>{spec.label}</dt>
                <dd>{spec.value}</dd>
              </div>
            ))}
          </dl>
          <a class="text-link" href={`/products/${p.id}/`}>Full product specifications &amp; details <Icon name="arrow-up-right" size={16}/></a>
        </div>
      </article>
    ))}
  </section>

  <!-- Section: ISO / FDA Standards Citation -->
  <section class="section" style="background: #f8fafc; border-top: 1px solid #e2e8f0; padding: 48px max(5vw, 24px); margin-top: 40px;">
    <div style="max-width: 900px; margin: 0 auto;">
      <p class="eyebrow" style="color: #0284c7; font-weight: 700;">QUALITY CERTIFICATION ARCHITECTURE</p>
      <h2 style="font-size: 24px; font-weight: 800; color: #0f172a; margin: 6px 0 16px;">What Quality Standards and Verification Certify the BOHOL Catalogue?</h2>
      <blockquote style="margin: 0; padding: 18px 24px; background: #ffffff; border-left: 4px solid #0284c7; border-radius: 0 12px 12px 0; box-shadow: 0 2px 8px rgba(15,23,42,0.04); font-size: 14.5px; line-height: 1.7; color: #334155;">
        "Every SKU listed across the BOHOL hardware catalogue is manufactured inside audited Class 100,000 cleanrooms under ISO 13485:2016 and ISO 9001:2015 frameworks. Liquid silicone elastomer parts adhere strictly to FDA 21 CFR § 177.2600. Finished assemblies undergo automated IPX7 vacuum immersion and acoustic sound chamber profiling."
        <footer style="margin-top: 10px; font-size: 13px; color: #64748b; font-weight: 600;">
          — Certified under <a href="https://www.iso.org/standard/59752.html" target="_blank" rel="noopener noreferrer" style="color: #0284c7; text-decoration: underline;">ISO 13485:2016</a> &amp; <a href="https://www.accessdata.fda.gov/scripts/cdrh/cfdocs/cfcfr/cfrsearch.cfm?fr=177.2600" target="_blank" rel="noopener noreferrer" style="color: #0284c7; text-decoration: underline;">FDA 21 CFR § 177.2600</a>
        </footer>
      </blockquote>
    </div>
  </section>

  <script>
    const button = document.querySelector<HTMLButtonElement>('#print-catalogue');
    if (button) {
      button.hidden = false;
      button.addEventListener('click', () => window.print());
    }
  </script>
</Layout>
