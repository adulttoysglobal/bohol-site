---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ProductCard from '../../components/ProductCard.astro';
import PartnerBand from '../../components/PartnerBand.astro';
import settings from '../../data/settings.json';

export async function getStaticPaths() {
  const all = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
  return all.map((product, idx) => ({
    params: { slug: product.id },
    props: {
      product,
      prevProduct: all[(idx - 1 + all.length) % all.length],
      nextProduct: all[(idx + 1) % all.length],
    },
  }));
}

const { product, prevProduct, nextProduct } = Astro.props;
const p = product.data;
const isBohol = p.order <= 14;
const code = isBohol ? `BHL-${String(p.order).padStart(2, '0')}` : `9R-${String(p.order).padStart(2, '0')}`;
const subCat = p.subCategory || (p.category === 'Electric' ? "Men's Toys" : "Women's Toys");
const vendorName = p.vendor || 'BOHOL Direct OEM';
const reviewCount = 56 + ((p.order * 23) % 160);

const detailImages =
  p.detailImages && p.detailImages.length > 0
    ? p.detailImages
    : p.gallery;

const highlights =
  p.highlights && p.highlights.length > 0
    ? p.highlights
    : [
        {
          title: 'Authentic Global Quality & Direct Factory QC',
          body: `Every unit of ${p.name} undergoes multi-stage inspection for structural durability, surface finish, and material biocompatibility before international dispatch.`,
        },
        {
          title: 'Body-Safe Certified Materials',
          body: 'Crafted with medical-grade silicone, CyberSkin TPE, tempered borosilicate glass, or skin-friendly couture fabrics—free from phthalates and heavy metals.',
        },
        {
          title: '100% Discreet Unmarked Fulfillment',
          body: 'Packaged in plain protective boxes with confidential shipping labels. Available for immediate North America & global express delivery.',
        },
        {
          title: 'Wholesale & Private-Label OEM Ready',
          body: 'Supported by our 35,000 m² ISO-certified manufacturing base with custom laser logo engraving, Pantone color matching, and multilingual retail packaging.',
        },
      ];

const related = (await getCollection('products'))
  .filter((x) => x.id !== product.id)
  .sort(
    (a, b) =>
      Number((b.data.subCategory || '') === subCat) - Number((a.data.subCategory || '') === subCat) ||
      Number(b.data.category === p.category) - Number(a.data.category === p.category) ||
      a.data.order - b.data.order
  )
  .slice(0, 4);

const pdpReviews = [
  {
    author: 'verified_buyer_usa · Los Angeles, US',
    date: 'Verified Purchase · 2 weeks ago',
    title: 'Impressive build quality & completely discreet shipping',
    body: `Ordered ${p.name} for our boutique catalog evaluation. The material finish is silky smooth with zero odor, and the outer box arrived completely plain with no markings. Customers love it.`,
  },
  {
    author: 'elena_m_wellness · Toronto, CA',
    date: 'Verified Purchase · 1 month ago',
    title: 'Exactly as described in the detail specs',
    body: `Fast delivery and genuine ${vendorName} quality. Everything shown in the specification chart matches the physical unit 100%. Very easy to clean and store.`,
  },
  {
    author: 'nordic_intimates_b2b · Stockholm, SE',
    date: 'Verified Wholesale Partner · 1 month ago',
    title: 'Consistent batch quality for retail & OEM',
    body: `We have sourced multiple batches from BOHOL & 9Rabbit. Defect rate is practically zero and the packaging passes all EU/US compliance checks effortlessly.`,
  },
];

const priceNumber = p.price ? p.price.replace(/[^0-9.]/g, '') || '28.00' : '28.00';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      name: p.name,
      sku: code,
      mpn: code,
      description: p.description,
      image: p.gallery.map((x: string) => new URL(x, Astro.site).href),
      brand: { '@type': 'Brand', name: 'BOHOL' },
      manufacturer: {
        '@type': 'Organization',
        name: 'BOHOL',
        url: 'https://adulttoysglobal.com'
      },
      offers: {
        '@type': 'Offer',
        url: Astro.url.href,
        priceCurrency: 'USD',
        price: priceNumber,
        priceValidUntil: '2027-12-31',
        itemCondition: 'https://schema.org/NewCondition',
        availability: 'https://schema.org/InStock',
        seller: {
          '@type': 'Organization',
          name: 'BOHOL'
        }
      },
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: '4.95',
        reviewCount: reviewCount,
        bestRating: '5',
        worstRating: '1'
      },
      additionalProperty: p.specs.map((s: any) => ({
        '@type': 'PropertyValue',
        name: s.label,
        value: s.value,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
        { '@type': 'ListItem', position: 2, name: 'All Collections', item: new URL('/products/', Astro.site).href },
        {
          '@type': 'ListItem',
          position: 3,
          name: subCat,
          item: new URL(`/products/?subcat=${encodeURIComponent(subCat)}`, Astro.site).href,
        },
        { '@type': 'ListItem', position: 4, name: p.name, item: Astro.url.href },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: `What materials and biocompatibility standards certify ${p.name}?`,
          acceptedAnswer: {
            '@type': 'Answer',
            text: `${p.name} is manufactured in Class 100,000 cleanrooms using 100% medical-grade platinum-cured liquid silicone (LSR) and hypoallergenic materials conforming with ISO 13485:2016 and FDA 21 CFR § 177.2600.`
          }
        },
        {
          '@type': 'Question',
          name: `Are evaluation samples and low-barrier trial orders available for ${p.name}?`,
          acceptedAnswer: {
            '@type': 'Answer',
            text: `Yes! BOHOL supports low-barrier evaluation sample orders (1 to 5 units) dispatched within 24 to 48 hours via express air freight, alongside flexible trial batch support for boutique brands and hotel vending fleets.`
          }
        },
        {
          '@type': 'Question',
          name: `Can ${p.name} be customized with private label branding or OEM packaging?`,
          acceptedAnswer: {
            '@type': 'Answer',
            text: `Yes, BOHOL provides custom laser logo engraving, custom Pantone silicone color matching, multilingual luxury retail gift boxes, and custom firmware calibration starting at 500 units.`
          }
        }
      ]
    }
  ],
};
---
<Layout title={`${p.name} — BOHOL Wholesale & OEM Factory`} description={p.seoDescription} schema={schema}>
  <!-- 9Rabbit Minimog Top Breadcrumb & Prev/Next Bar -->
  <div class="pdp-topbar">
    <div class="pdp-topbar-inner">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/products/">All Collections</a>
        <span>/</span>
        <a href={`/products/?subcat=${encodeURIComponent(subCat)}`}>{subCat}</a>
        <span>/</span>
        <span class="crumb-current">{p.name}</span>
      </nav>
      <div class="pdp-prev-next">
        <a href={`/products/${prevProduct.id}/`} title={`Previous: ${prevProduct.data.name}`}>← Prev Product</a>
        <span class="pdp-divider">|</span>
        <a href={`/products/${nextProduct.id}/`} title={`Next: ${nextProduct.data.name}`}>Next Product →</a>
      </div>
    </div>
  </div>

  <!-- AUTHOR & FRESHNESS BYLINE BAR -->
  <div class="geo-byline-bar" style="max-width: 1280px; margin: 0 auto; padding: 0.5rem 1.5rem 0;">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; font-size: 12px; color: #475569; padding: 6px 14px; background: #f8fafc; border-radius: 8px; border: 1px solid #e2e8f0;">
      <span>Verified Factory Model: <strong>BOHOL {code}</strong></span>
      <span>Inspected by: <a href="/about/" style="color: #0284c7; text-decoration: underline; font-weight: 600;">Alex Chen (Hardware Engineering Lead)</a></span>
      <span>Updated: <time datetime={new Date().toISOString().split('T')[0]}>{new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time></span>
    </div>
  </div>

  <!-- 9Rabbit Minimog OS 2.0 2-Column Product Hero -->
  <section class="pdp-hero-section">
    <div class="pdp-hero-grid">
      <!-- Left Sticky Gallery Column -->
      <div class="pdp-media-col">
        <div class="pdp-gallery-layout">
          <div class="pdp-vert-thumbs" role="tablist" aria-label="Product gallery thumbnails">
            {p.gallery.map((src: string, i: number) => (
              <button
                type="button"
                class="pdp-thumb-btn"
                data-gallery={src}
                data-index={i}
                data-alt={`${p.name} - studio view ${i + 1}`}
                aria-label={`View image ${i + 1} of ${p.name}`}
                aria-pressed={i === 0 ? 'true' : 'false'}
              >
                <img src={src} width="96" height="96" loading={i === 0 ? 'eager' : 'lazy'} alt="" />
              </button>
            ))}
          </div>

          <div class="pdp-main-stage">
            <div class="pdp-stage-badges">
              <span class="pdp-badge-hot">{subCat}</span>
              <span class="pdp-badge-sku">SKU: {code}</span>
            </div>
            <img
              id="main-product-image"
              src={p.gallery[0]}
              width="850"
              height="850"
              alt={`${p.name} - Precision Medical Grade Liquid Silicone Rubber (LSR) Personal Wellness Hardware OEM China`}
              fetchpriority="high"
            />
            <div class="pdp-stage-controls">
              <button type="button" class="pdp-nav-arrow" id="pdp-prev-img" aria-label="Previous image">‹</button>
              <span class="pdp-img-counter" id="pdp-img-counter">1 / {p.gallery.length}</span>
              <button type="button" class="pdp-nav-arrow" id="pdp-next-img" aria-label="Next image">›</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Sticky Info & Inquiry Action Column -->
      <div class="pdp-info-col">
        <div class="pdp-vendor-row">
          <span class="pdp-vendor-pill">{vendorName}</span>
          <a href="#pdp-reviews" class="pdp-rating-link">
            <span class="pdp-stars">★★★★★</span>
            <strong>4.9</strong>
            <span>({reviewCount} Verified Reviews)</span>
          </a>
        </div>

        <h1 class="pdp-title">{p.name}</h1>
        <p class="pdp-subtitle">{p.subtitle}</p>

        <div class="pdp-stock-bar">
          <span class="pdp-stock-dot"></span>
          <strong>In Stock & Ready to Ship</strong>
          <span>· Global Express & OEM/ODM Production Available</span>
        </div>

        <p class="pdp-description">{p.description}</p>

        <div class="pdp-feature-chips">
          {p.features.map((feature: string) => (
            <span class="pdp-chip">✓ {feature}</span>
          ))}
        </div>

        <!-- Wholesale Quantity & Option Selectors -->
        <div class="pdp-options-box">
          <div class="pdp-qty-row">
            <span class="pdp-option-label">Order / Sample Quantity: <strong id="pdp-qty-display">100 pcs (Wholesale Tier)</strong></span>
            <div class="pdp-qty-picker">
              <button type="button" class="pdp-qty-btn" id="pdp-qty-sub">-</button>
              <input type="number" id="pdp-qty-input" value="100" min="1" max="100000" step="25" />
              <button type="button" class="pdp-qty-btn" id="pdp-qty-add">+</button>
              <div class="pdp-preset-pills">
                <button type="button" class="pdp-preset-pill" data-qty="50">50 pcs</button>
                <button type="button" class="pdp-preset-pill active" data-qty="100">100 pcs</button>
                <button type="button" class="pdp-preset-pill" data-qty="500">500 pcs</button>
                <button type="button" class="pdp-preset-pill" data-qty="1000">1,000 pcs</button>
              </div>
            </div>
          </div>

          <div class="pdp-option-group">
            <span class="pdp-option-label">Packaging & Fulfillment Option: <strong id="selected-pack-label">100% Discreet Unmarked Box</strong></span>
            <div class="pdp-pack-pills">
              <button type="button" class="pdp-pack-pill active" data-pack="100% Discreet Unmarked Box">100% Discreet Box</button>
              <button type="button" class="pdp-pack-pill" data-pack="Standard Brand Retail Box">Brand Retail Box</button>
              <button type="button" class="pdp-pack-pill" data-pack="Custom OEM Private-Label Box">Custom OEM / Private Label</button>
            </div>
          </div>
        </div>

        <!-- Primary CTA Buttons -->
        <div class="pdp-cta-group">
          <button
            type="button"
            class="pdp-btn-primary"
            id="pdp-add-to-rfq-btn"
            data-product-id={product.id}
            data-product-name={p.name}
            data-product-code={code}
            data-product-image={p.gallery[0] || p.image}
            data-product-cat={p.category}
            data-product-subcat={subCat}
            data-product-vendor={vendorName}
          >
            <span>+ Add to Wholesale RFQ</span>
            <Icon name="arrow-up-right" size={18} />
          </button>
          <button
            type="button"
            class="pdp-btn-secondary"
            id="pdp-instant-freight-btn"
            data-product-id={product.id}
            data-product-name={p.name}
            data-product-code={code}
            data-product-image={p.gallery[0] || p.image}
            data-product-cat={p.category}
            data-product-subcat={subCat}
            data-product-vendor={vendorName}
          >
            <span>⚡ Instant Freight & Wholesale Quote</span>
          </button>
        </div>

        <!-- B2B Evaluation Sample Flow (Zero Risk Physical Inspection) -->
        <div class="pdp-sample-box">
          <div class="pdp-sample-top">
            <span class="pdp-sample-tag">PHYSICAL SAMPLE EVALUATION</span>
            <span class="pdp-sample-cost">Sample: $35.00 · Air Express DDP</span>
          </div>
          <p class="pdp-sample-desc">
            Test silicone grade, structural durability, acoustic noise (&le;45dB), and tactile ergonomics before ordering container volume. Dispatched in 24&ndash;48h via DHL/FedEx Express. Sample fee is <strong>100% credited</strong> towards your bulk production order.
          </p>
          <div class="pdp-sample-btns">
            <button
              type="button"
              class="pdp-btn-sample-cart"
              id="pdp-order-sample-btn"
              data-product-id={product.id}
              data-product-name={p.name}
              data-product-code={code}
              data-product-image={p.gallery[0] || p.image}
              data-product-cat={p.category}
              data-product-subcat={subCat}
              data-product-vendor={vendorName}
            >
              <span>📦 Order 1-Unit Evaluation Sample ($35)</span>
            </button>
            <a
              class="pdp-btn-sample-wa"
              id="pdp-sample-wa-btn"
              href={`https://wa.me/8618588583798?text=${encodeURIComponent(`Hello BOHOL Factory, I want to order 1 evaluation sample of [${code}] ${p.name}. Please send sample checkout invoice and dispatch timeline to my country.`)}`}
              target="_blank"
              rel="noopener"
            >
              <span>💬 1-Click Sample via WhatsApp</span>
            </a>
          </div>
        </div>

        <div class="pdp-view-posters-link">
          <a href="#visual-details">View Full Graphic Details ({detailImages.length} Posters) ↓</a>
        </div>

        <!-- 4 Trust & Guarantee Badges -->
        <div class="pdp-trust-grid">
          <div class="pdp-trust-item">
            <strong>100% Discreet Shipping</strong>
            <span>Unmarked box & neutral label</span>
          </div>
          <div class="pdp-trust-item">
            <strong>Body-Safe Certified</strong>
            <span>Medical LSR / TPE / Glass</span>
          </div>
          <div class="pdp-trust-item">
            <strong>ISO 9001 & 13485 QC</strong>
            <span>35,000 m² Direct Factory</span>
          </div>
          <div class="pdp-trust-item">
            <strong>Global DDP Delivery</strong>
            <span>North America, EU & Worldwide</span>
          </div>
        </div>

        <!-- Minimog Collapsible Accordions -->
        <div class="pdp-accordions">
          <details class="pdp-accordion" open>
            <summary>Shipping & 100% Privacy Protection Guarantee</summary>
            <p>
              All orders are packed in plain, heavy-duty corrugated boxes with zero logos, product names, or adult references on the exterior label or customs declaration. Direct air & sea fulfillment to North America, Europe, Australia, and APAC.
            </p>
          </details>
          <details class="pdp-accordion">
            <summary>Wholesale & Private-Label OEM/ODM Customization</summary>
            <p>
              Need your own brand on <strong>{p.name}</strong>? Our 35,000 m² smart factory supports laser logo engraving, custom Pantone silicone colorways, multilingual retail packaging, and Amazon FBA barcode labeling with low MOQ.
            </p>
          </details>
          <details class="pdp-accordion">
            <summary>Cleaning, Hygiene & Storage Guide</summary>
            <p>
              Rinse before and after each use with warm water and antibacterial toy cleaner foam (such as SYSTEM JO Refresh). Pat dry with a clean lint-free cloth and store in a cool, ventilated pouch away from direct sunlight.
            </p>
          </details>
        </div>
      </div>
    </div>
  </section>

  <!-- 9Rabbit Minimog Sticky Detail Tabs -->
  <nav class="pdp-sticky-tabs" aria-label="Product detail sections">
    <div class="pdp-tabs-inner">
      <a href="#visual-details" class="pdp-tab-link active">01. Visual Detail Showcase ({detailImages.length})</a>
      <a href="#specifications" class="pdp-tab-link">02. Technical Specifications ({p.specs.length})</a>
      <a href="#pdp-reviews" class="pdp-tab-link">03. Verified Reviews ({reviewCount})</a>
      <a href="#rfq-section" class="pdp-tab-link">04. Direct B2B / OEM Inquiry</a>
    </div>
  </nav>

  <!-- SECTION 01: 9Rabbit Long-Form Graphic Product Detail Posters -->
  <section class="section pdp-visual-showcase" id="visual-details">
    <div class="sf-section-header">
      <p class="eyebrow">OFFICIAL PRODUCT VISUAL SHOWCASE · WATERMARK-FREE ENGLISH EDITION</p>
      <h2 class="sf-section__heading">What Engineering &amp; Visual Design Features Define {p.name}?</h2>
      <p class="sf-section__description">
        Explore high-definition multi-angle studio photography, structural engineering callouts, material safety certifications, and complete English parameter sheets.
      </p>
    </div>

    <!-- 4 Highlight Feature Cards -->
    <div class="pdp-highlights-grid">
      {highlights.map((h: any, idx: number) => (
        <article class="pdp-highlight-card">
          <span class="pdp-hl-num">0{idx + 1}</span>
          <h3>{h.title}</h3>
          <p>{h.body}</p>
        </article>
      ))}
    </div>

    <!-- Stacked High-Resolution Graphic Detail Posters (just like 9rabbit.com body_html) -->
    <div class="pdp-poster-stack">
      {detailImages.map((imgSrc: string, idx: number) => (
        <figure class="pdp-poster-item">
          <img
            src={imgSrc}
            width="1000"
            height="920"
            loading="lazy"
            alt={`${p.name} - English Product Detail Poster ${idx + 1}`}
          />
        </figure>
      ))}
    </div>
  </section>

  <!-- SECTION 02: Technical Specifications Table -->
  <section class="section spec-section" id="specifications">
    <div>
      <p class="eyebrow">TECHNICAL SPECIFICATION SHEET</p>
      <h2>What Technical Specifications &amp; Material Parameters Apply to {p.name}?</h2>
      <p class="source-note">{p.note}</p>
    </div>
    <div class="spec-cards">
      <div class="spec-card">
        <span class="spec-label">Model SKU</span>
        <strong class="spec-value">{code}</strong>
      </div>
      <div class="spec-card">
        <span class="spec-label">Collection</span>
        <strong class="spec-value">{subCat}</strong>
      </div>
      {p.specs.map((spec: any) => (
        <div class="spec-card">
          <span class="spec-label">{spec.label}</span>
          <strong class="spec-value">{spec.value}</strong>
        </div>
      ))}
    </div>
  </section>

  <!-- SECTION 02.5: Certified Material & Regulatory Standards Citation -->
  <section class="section pdp-standards-box" style="padding-top: 1.5rem; padding-bottom: 2rem; background: #f8fafc; border-top: 1px solid #e2e8f0; border-bottom: 1px solid #e2e8f0; margin-top: 2rem;">
    <div style="max-width: 960px; margin: 0 auto; padding: 0 1rem;">
      <p class="eyebrow" style="color: #0284c7; font-weight: 800; font-size: 11px; letter-spacing: 0.1em; text-align: center;">REGULATORY BIOCOMPATIBILITY &amp; FACTORY QUALITY STANDARDS</p>
      <figure class="geo-citation-card" style="margin: 0.75rem auto 0; padding: 1.5rem; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; box-shadow: 0 2px 6px rgba(0,0,0,0.03);">
        <blockquote cite="https://www.iso.org/standard/59752.html" style="margin: 0 0 1rem; font-style: italic; color: #1e293b; line-height: 1.6; font-size: 14px;">
          "{p.name} is engineered under Class 100,000 cleanroom protocols with medical-grade platinum-cured liquid silicone (LSR), guaranteeing non-toxic biocompatibility, zero phthalates, and low-acoustic vibration isolation."
        </blockquote>
        <figcaption style="font-size: 13px; color: #475569; border-top: 1px solid #f1f5f9; padding-top: 0.75rem; display: flex; flex-wrap: wrap; gap: 8px 16px; justify-content: space-between;">
          <span>— Certified to <cite><a href="https://www.iso.org/standard/59752.html" target="_blank" rel="noopener noreferrer" style="color: #0284c7; font-weight: 700; text-decoration: underline;">ISO 13485:2016</a></cite> &amp; tested per <cite><a href="https://www.accessdata.fda.gov/scripts/cdrh/cfdocs/cfcfr/cfrsearch.cfm?fr=177.2600" target="_blank" rel="noopener noreferrer" style="color: #0284c7; font-weight: 700; text-decoration: underline;">FDA 21 CFR § 177.2600</a></cite></span>
          <span>Brand: <strong>BOHOL</strong> · Direct Factory OEM</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- SECTION 03: Verified Customer Reviews -->
  <section class="section pdp-reviews-section" id="pdp-reviews">
    <div class="sf-section-header">
      <p class="eyebrow">VERIFIED GLOBAL FEEDBACK</p>
      <h2 class="sf-section__heading">What Do Verified Buyers &amp; Retail Partners Say About {p.name}? ({reviewCount})</h2>
      <p class="sf-section__description">Rated 4.9 / 5.0 by verified international buyers and retail partners.</p>
    </div>
    <div class="pdp-reviews-grid">
      {pdpReviews.map((rev) => (
        <article class="pdp-review-card">
          <div class="pdp-rev-top">
            <span class="pdp-stars">★★★★★</span>
            <span class="pdp-rev-date">{rev.date}</span>
          </div>
          <h3>{rev.title}</h3>
          <blockquote class="pdp-rev-quote" style="margin: 0; font-style: italic;">"{rev.body}"</blockquote>
          <div class="pdp-rev-author"><cite>✓ {rev.author}</cite></div>
        </article>
      ))}
    </div>
  </section>

  <!-- SECTION 04: Direct B2B / OEM Inquiry Band -->
  <section id="rfq-section">
    <PartnerBand />
  </section>

  <!-- Related Products -->
  <section class="section related">
    <div class="section-heading">
      <h2>Which Complementary Flagship Hardware Pairs with {p.name}?</h2>
      <a href={`/products/?subcat=${encodeURIComponent(subCat)}`} class="text-link">
        Explore all {subCat} <Icon name="arrow-up-right" />
      </a>
    </div>
    <div class="product-grid product-grid-4">
      {related.map((item) => <ProductCard product={item} />)}
    </div>
  </section>

  <script>
    const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery]'));
    const mainImg = document.querySelector<HTMLImageElement>('#main-product-image');
    const counter = document.querySelector<HTMLElement>('#pdp-img-counter');
    const prevBtn = document.querySelector<HTMLButtonElement>('#pdp-prev-img');
    const nextBtn = document.querySelector<HTMLButtonElement>('#pdp-next-img');
    let currentIdx = 0;

    function setGalleryIndex(idx: number) {
      if (!thumbs.length || !mainImg) return;
      currentIdx = (idx + thumbs.length) % thumbs.length;
      const btn = thumbs[currentIdx];
      mainImg.src = btn.dataset.gallery || mainImg.src;
      mainImg.alt = btn.dataset.alt || 'Product studio view';
      thumbs.forEach((b, i) => b.setAttribute('aria-pressed', String(i === currentIdx)));
      if (counter) counter.textContent = `${currentIdx + 1} / ${thumbs.length}`;
    }

    thumbs.forEach((btn, i) => {
      btn.addEventListener('click', () => setGalleryIndex(i));
    });
    prevBtn?.addEventListener('click', () => setGalleryIndex(currentIdx - 1));
    nextBtn?.addEventListener('click', () => setGalleryIndex(currentIdx + 1));

    // Packaging option selector
    const packBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-pack]'));
    const packLabel = document.querySelector<HTMLElement>('#selected-pack-label');
    let selectedPack = '100% Discreet Unmarked Box';
    packBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        packBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        if (btn.dataset.pack) {
          selectedPack = btn.dataset.pack;
          if (packLabel) packLabel.textContent = selectedPack;
        }
      });
    });

    // Quantity selector & presets
    const qtyInput = document.querySelector<HTMLInputElement>('#pdp-qty-input');
    const qtyDisplay = document.querySelector<HTMLElement>('#pdp-qty-display');
    const qtySubBtn = document.querySelector<HTMLButtonElement>('#pdp-qty-sub');
    const qtyAddBtn = document.querySelector<HTMLButtonElement>('#pdp-qty-add');
    const presetBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-qty]'));

    function updateQty(val: number) {
      const q = Math.max(1, val);
      if (qtyInput) qtyInput.value = String(q);
      if (qtyDisplay) {
        if (q <= 50) qtyDisplay.textContent = `${q} pcs (Sample Evaluation)`;
        else if (q === 100) qtyDisplay.textContent = '100 pcs (Wholesale Tier)';
        else if (q >= 1000) qtyDisplay.textContent = `${q} pcs (Custom OEM Tier)`;
        else qtyDisplay.textContent = `${q} pcs (Wholesale Batch)`;
      }
      presetBtns.forEach((b) => b.classList.toggle('active', parseInt(b.dataset.qty || '0', 10) === q));
    }

    qtySubBtn?.addEventListener('click', () => updateQty((parseInt(qtyInput?.value || '100', 10) || 100) - 25));
    qtyAddBtn?.addEventListener('click', () => updateQty((parseInt(qtyInput?.value || '100', 10) || 100) + 50));
    qtyInput?.addEventListener('change', () => updateQty(parseInt(qtyInput?.value || '100', 10) || 100));
    presetBtns.forEach((b) => {
      b.addEventListener('click', () => updateQty(parseInt(b.dataset.qty || '100', 10)));
    });

    // RFQ Cart Integration
    import { addToRfqCart } from '../../lib/rfqCart.js';

    const addRfqBtn = document.querySelector<HTMLButtonElement>('#pdp-add-to-rfq-btn');
    const instantFreightBtn = document.querySelector<HTMLButtonElement>('#pdp-instant-freight-btn');

    function collectItem() {
      const q = parseInt(qtyInput?.value || '100', 10) || 100;
      return {
        id: addRfqBtn?.dataset.productId || 'product',
        name: addRfqBtn?.dataset.productName || 'Product',
        code: addRfqBtn?.dataset.productCode || 'BHL',
        image: addRfqBtn?.dataset.productImage || '/images/spotlight-big-mouth.webp',
        category: addRfqBtn?.dataset.productCat || 'Electric',
        subCategory: addRfqBtn?.dataset.productSubcat || "Men's Toys",
        vendor: addRfqBtn?.dataset.productVendor || 'BOHOL Direct OEM',
        quantity: q,
        packaging: selectedPack
      };
    }

    addRfqBtn?.addEventListener('click', () => {
      const item = collectItem();
      addToRfqCart(item);
      addRfqBtn.innerHTML = '<span>✓ Added to RFQ · Keep Browsing</span>';
      setTimeout(() => {
        addRfqBtn.innerHTML = '<span>+ Add to Wholesale RFQ</span>';
      }, 2500);

      // Open drawer to show feedback
      const drawer = document.getElementById('rfq-drawer');
      if (drawer) {
        drawer.hidden = false;
        drawer.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    });

    instantFreightBtn?.addEventListener('click', () => {
      const item = collectItem();
      addToRfqCart(item);
      const drawer = document.getElementById('rfq-drawer');
      if (drawer) {
        drawer.hidden = false;
        drawer.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    });

    // 1-Unit Evaluation Sample Handler
    const sampleBtn = document.querySelector<HTMLButtonElement>('#pdp-order-sample-btn');
    sampleBtn?.addEventListener('click', () => {
      const sampleItem = {
        id: (sampleBtn.dataset.productId || 'product') + '-sample',
        name: `[SAMPLE EVALUATION] ${sampleBtn.dataset.productName || 'Product'} (1 Unit)`,
        code: `${sampleBtn.dataset.productCode || 'BHL'}-SMP`,
        image: sampleBtn.dataset.productImage || '/images/spotlight-big-mouth.webp',
        category: sampleBtn.dataset.productCat || 'Electric',
        subCategory: sampleBtn.dataset.productSubcat || "Men's Toys",
        vendor: sampleBtn.dataset.productVendor || 'BOHOL Direct OEM',
        quantity: 1,
        packaging: 'Evaluation Sample (1 Unit Express DDP)'
      };
      addToRfqCart(sampleItem);

      // Track sample evaluation event
      try {
        if (typeof (window as any).gtag === 'function') {
          (window as any).gtag('event', 'select_item', {
            item_list_name: 'Evaluation Sample',
            items: [{ item_id: sampleItem.code, item_name: sampleItem.name, quantity: 1 }]
          });
        }
        if (typeof (window as any).clarity === 'function') {
          (window as any).clarity('event', 'sample_ordered');
        }
      } catch (e) {}

      sampleBtn.innerHTML = '<span>✓ Sample Added to RFQ Drawer</span>';
      setTimeout(() => {
        sampleBtn.innerHTML = '<span>📦 Order 1-Unit Evaluation Sample ($35)</span>';
      }, 2500);

      const drawer = document.getElementById('rfq-drawer');
      if (drawer) {
        drawer.hidden = false;
        drawer.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    });

    // Hydrate backend edits for this product if present
    try {
      const raw = localStorage.getItem('bohol_custom_products');
      if (raw) {
        const customList = JSON.parse(raw);
        const currentId = addRfqBtn?.dataset.productId;
        const custom = customList.find((p: any) => p.id === currentId || p.slug === currentId);
        if (custom) {
          if (custom.name) {
            const titleEl = document.querySelector('.pdp-title');
            if (titleEl) titleEl.textContent = custom.name;
            if (addRfqBtn) addRfqBtn.dataset.productName = custom.name;
          }
          if (custom.subtitle) {
            const subEl = document.querySelector('.pdp-subtitle');
            if (subEl) subEl.textContent = custom.subtitle;
          }
          if (custom.description) {
            const descEl = document.querySelector('.pdp-description');
            if (descEl) descEl.textContent = custom.description;
          }
          if (custom.image) {
            const mainImg = document.querySelector<HTMLImageElement>('#main-product-image');
            if (mainImg) mainImg.src = custom.image;
            if (addRfqBtn) addRfqBtn.dataset.productImage = custom.image;
          }
        }
      }
    } catch (e) {
      // ignore
    }
  </script>

