---
import Layout from '../../layouts/Layout.astro';
import settings from '../../data/settings.json';
---
<Layout title="RFQ Lead Management & Backend Integration" noindex={true}>
  <section class="page-head">
    <p class="eyebrow">BACKEND INTEGRATION & INQUIRY INBOX</p>
    <h1>B2B RFQ Lead Center</h1>
    <p>View inquiries submitted from the website forms, export CSV/JSON data, and verify your backend API endpoint (`{settings.enquiryEndpoint || '/api/enquiry'}`).</p>
  </section>

  <section class="section">
    <div class="catalogue-toolbar" style="margin-top:0;margin-bottom:28px;justify-content:space-between">
      <div>
        <strong>Configured API Endpoint:</strong> <code>{settings.enquiryEndpoint || '/api/enquiry'}</code>
      </div>
      <div style="display:flex;gap:12px;flex-wrap:wrap">
        <a href="/admin/" class="btn-secondary" style="text-decoration:none">🛍️ BOHOL Content Manager (Decap CMS)</a>
        <button type="button" class="btn-primary" id="export-csv">Export Leads (CSV)</button>
        <button type="button" class="btn-secondary" id="clear-leads">Clear Local Test Leads</button>
      </div>
    </div>

    <div class="table-scroll">
      <table class="compare" id="leads-table">
        <thead>
          <tr>
            <th>Ref & Source</th>
            <th>Date</th>
            <th>Buyer & Company</th>
            <th>Contact</th>
            <th>Freight Destination</th>
            <th>Products & Order Volume</th>
            <th>Notes & Direct Reply</th>
          </tr>
        </thead>
        <tbody id="leads-tbody">
          <tr><td colspan="7">Loading inquiries...</td></tr>
        </tbody>
      </table>
    </div>
  </section>
</Layout>

<script>
  const tbody = document.querySelector<HTMLElement>('#leads-tbody');
  function renderLeads() {
    if (!tbody) return;
    const leads = JSON.parse(localStorage.getItem('bohol_rfq_leads') || '[]');
    if (!leads.length) {
      tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;padding:32px">No inquiry leads recorded yet. Add products to the Inquiry List or submit an RFQ to test!</td></tr>';
      return;
    }
    tbody.innerHTML = leads
      .map(
        (l: any) => {
          const prodsHtml = Array.isArray(l.rawItems) && l.rawItems.length
            ? `<div style="display:flex;flex-direction:column;gap:6px;max-width:320px">
                <span style="font-weight:700;color:var(--text);font-size:0.84rem">${l.rawItems.length} Products (${l.totalUnits || l.quantity || 0} total units):</span>
                ${l.rawItems.map((item: any) => `
                  <div style="font-size:0.78rem;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);padding:4px 8px;border-radius:4px">
                    <strong>[${item.code || item.id}]</strong> ${item.name}<br/>
                    <span style="color:var(--primary);font-weight:600">Qty: ${item.quantity} pcs</span> &bull; <span style="opacity:0.8">${item.packaging || 'Discreet Box'}</span>
                  </div>
                `).join('')}
              </div>`
            : (l.models?.length 
                ? `<div style="max-width:300px;font-size:0.8rem"><strong>Models:</strong> ${l.models.join('<br/>')}</div>` 
                : `<span style="font-weight:600">${l.type || 'Wholesale RFQ'}</span><br/><small>Qty: ${l.quantity || '-'}</small>`);

          const destHtml = l.destinationAddress || l.country
            ? `<div style="font-size:0.82rem;line-height:1.4">
                <strong>📍 ${l.country || '-'}</strong><br/>
                <span style="opacity:0.85">${l.destinationAddress || '-'}</span><br/>
                <span style="display:inline-block;margin-top:4px;padding:2px 6px;border-radius:3px;font-size:0.74rem;background:rgba(180,83,9,0.2);color:#f59e0b;font-weight:600">Mode: ${l.shippingMode || 'DDP Air'}</span>
              </div>`
            : `<span style="opacity:0.6;font-size:0.8rem">Not specified</span>`;

          const waUrl = l.phone
            ? `https://wa.me/${String(l.phone).replace(/[^0-9]/g, '')}?text=${encodeURIComponent(`Hello ${l.name || 'there'}, thank you for your wholesale inquiry (${l.id}) with BOHOL. Here is our official freight quote:`)}`
            : '';

          return `
          <tr>
            <td>
              <strong style="font-size:0.85rem">${l.id || '-'}</strong><br/>
              <span style="font-size:0.75rem;padding:2px 6px;background:rgba(255,255,255,0.06);border-radius:3px;display:inline-block;margin-top:3px">${l.source || 'Website'}</span>
            </td>
            <td style="font-size:0.8rem;white-space:nowrap">${l.submittedAt ? new Date(l.submittedAt).toLocaleString() : '-'}</td>
            <td>
              <strong style="color:var(--text)">${l.name || '-'}</strong><br/>
              <span style="font-size:0.8rem;opacity:0.8">${l.company || '-'}</span>
            </td>
            <td style="font-size:0.82rem">
              ${l.email ? `<a href="mailto:${l.email}" style="color:var(--primary);word-break:break-all">${l.email}</a><br/>` : ''}
              ${l.phone ? `<span>📱 ${l.phone}</span>` : '<span style="opacity:0.6">-</span>'}
            </td>
            <td>${destHtml}</td>
            <td>${prodsHtml}</td>
            <td style="max-width:280px;font-size:0.82rem">
              <p style="margin:0 0 6px 0;line-height:1.35;opacity:0.9">${l.message || 'No additional note'}</p>
              ${l.customization ? `<div style="font-size:0.75rem;opacity:0.75;margin-bottom:6px">Custom: ${l.customization}</div>` : ''}
              <div style="display:flex;gap:6px;flex-wrap:wrap">
                ${waUrl ? `<a href="${waUrl}" target="_blank" rel="noopener" class="btn-primary" style="font-size:0.72rem;padding:4px 8px;text-decoration:none">💬 WhatsApp</a>` : ''}
                ${l.email ? `<a href="mailto:${l.email}?subject=Wholesale%20Quotation%20${encodeURIComponent(l.id || '')}" class="btn-secondary" style="font-size:0.72rem;padding:4px 8px;text-decoration:none">✉ Email</a>` : ''}
              </div>
            </td>
          </tr>`;
        }
      )
      .join('');
  }

  document.querySelector('#export-csv')?.addEventListener('click', () => {
    const leads = JSON.parse(localStorage.getItem('bohol_rfq_leads') || '[]');
    if (!leads.length) {
      alert('No leads to export.');
      return;
    }
    const headers = [
      'id',
      'submittedAt',
      'source',
      'name',
      'company',
      'email',
      'phone',
      'country',
      'destinationAddress',
      'shippingMode',
      'totalUnits',
      'modelsSummary',
      'customization',
      'message',
      'pageUrl'
    ];
    const rows = leads.map((l: any) => {
      const modelsSummary = Array.isArray(l.rawItems)
        ? l.rawItems.map((i: any) => `[${i.code || i.id}] ${i.name} (Qty: ${i.quantity}, ${i.packaging})`).join('; ')
        : (Array.isArray(l.models) ? l.models.join('; ') : '');

      const record: Record<string, any> = {
        ...l,
        modelsSummary: modelsSummary || l.modelsSummary || ''
      };

      return headers.map((k) => `"${String(record[k] || '').replace(/"/g, '""')}"`).join(',');
    });
    const csv = '\ufeff' + [headers.join(','), ...rows].join('\n');
    const url = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
    const a = document.createElement('a');
    a.href = url;
    a.download = `bohol-rfq-leads-${new Date().toISOString().slice(0, 10)}.csv`;
    a.click();
  });

  document.querySelector('#clear-leads')?.addEventListener('click', () => {
    if (confirm('Are you sure you want to clear local test RFQ inquiries?')) {
      localStorage.removeItem('bohol_rfq_leads');
      renderLeads();
    }
  });

  renderLeads();
</script>
