  <script>
    const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const nav = document.querySelector('#navigation');
    toggle?.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      nav?.classList.toggle('open', open);
    });
    nav?.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        nav.classList.remove('open');
        toggle?.setAttribute('aria-expanded', 'false');
      })
    );

    // Search Popup Modal Logic
    const searchModal = document.getElementById('sf-search-modal');
    const openSearchBtn = document.getElementById('open-search-btn');
    const closeSearchBtn = document.getElementById('close-search-btn');
    const closeSearchBackdrop = document.getElementById('close-search-backdrop');
    const searchInput = document.getElementById('sf-search-input') as HTMLInputElement | null;

    const openSearch = () => {
      if (!searchModal) return;
      searchModal.hidden = false;
      setTimeout(() => searchInput?.focus(), 50);
    };
    const closeSearch = () => {
      if (!searchModal) return;
      searchModal.hidden = true;
    };

    openSearchBtn?.addEventListener('click', openSearch);
    closeSearchBtn?.addEventListener('click', closeSearch);
    closeSearchBackdrop?.addEventListener('click', closeSearch);

    // Scroll to Top Button Logic
    const scrollBtn = document.getElementById('scroll-to-top-button');
    window.addEventListener('scroll', () => {
      if (!scrollBtn) return;
      if (window.scrollY > 360) {
        scrollBtn.classList.add('visible');
      } else {
        scrollBtn.classList.remove('visible');
      }
    }, { passive: true });

    scrollBtn?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // Global Multi-Product RFQ Quick-Add Handler
    import { addToRfqCart, isItemInRfqCart, getRfqCart } from '../lib/rfqCart.js';

    function syncCardButtons() {
      const items = getRfqCart();
      const ids = new Set(items.map((i) => i.id));
      document.querySelectorAll<HTMLButtonElement>('.rfq-quick-add-btn').forEach((btn) => {
        const id = btn.dataset.rfqId;
        if (id && ids.has(id)) {
          btn.classList.add('in-cart');
          if (btn.classList.contains('pcard-quote-pill-btn')) {
            btn.innerHTML = '<span>✓ In RFQ List</span>';
          } else {
            btn.innerHTML = '<span>✓ In RFQ List</span>';
          }
        } else {
          btn.classList.remove('in-cart');
          if (btn.classList.contains('pcard-quote-pill-btn')) {
            btn.innerHTML = '<span class="pcard-plus">+</span> Add to RFQ';
          } else {
            btn.textContent = '+ Add to RFQ';
          }
        }
      });
    }

    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest<HTMLButtonElement>('.rfq-quick-add-btn');
      if (!target) return;
      e.preventDefault();
      e.stopPropagation();

      const item = {
        id: target.dataset.rfqId!,
        name: target.dataset.rfqName || 'Product',
        code: target.dataset.rfqCode || target.dataset.rfqId!,
        image: target.dataset.rfqImage || '/images/spotlight-big-mouth.webp',
        category: target.dataset.rfqCategory || 'Adult Wellness',
        subCategory: target.dataset.rfqSubcat || "Men's Toys",
        vendor: target.dataset.rfqVendor || 'BOHOL Direct OEM',
        quantity: parseInt(target.dataset.rfqQty || '50', 10) || 50,
        packaging: target.dataset.rfqPack || '100% Discreet Box'
      };

      addToRfqCart(item);
      syncCardButtons();

      // Show toast or open drawer
      const drawer = document.getElementById('rfq-drawer');
      if (drawer) {
        drawer.hidden = false;
        drawer.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    });

    window.addEventListener('rfq-cart-updated', syncCardButtons);
    syncCardButtons();
  </script>

