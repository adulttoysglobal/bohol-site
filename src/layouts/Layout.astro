const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'BOHOL Global Adult Wellness & Smart Manufacturing',
  url: Astro.site?.toString() || 'https://adulttoysglobal.com',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${Astro.site?.toString() || 'https://adulttoysglobal.com'}/products/?q={search_term_string}`,
    'query-input': 'required name=search_term_string'
  }
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <meta name="theme-color" content="#219dbb" />
  <meta name="rating" content="adult" />
  <meta name="author" content="BOHOL Smart Manufacturing" />
  
  <!-- Canonical & Language -->
  {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
  <link rel="alternate" hreflang="x-default" href={canonical} />
  <link rel="alternate" hreflang="en" href={canonical} />

  <!-- Open Graph / Facebook -->
  <meta property="og:site_name" content="BOHOL Global Adult Wellness & Smart Manufacturing" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@boholwellness" />
  <meta name="twitter:creator" content="@boholwellness" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Performance: Preload Critical Hero Image for LCP Optimization -->
  <link rel="preload" as="image" href="/images/twist-hero.webp" type="image/webp" fetchpriority="high" />

  <!-- Fonts & Favicon: Non-blocking Google Fonts with fallback -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600;700&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600;700&display=swap" /></noscript>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.png" type="image/png" />

  <!-- Global Schema.org JSON-LD (SEO & GEO AI Ingestion) -->
  <script type="application/ld+json" set:html={safeJson(globalOrgSchema)} />
  <script type="application/ld+json" set:html={safeJson(websiteSchema)} />
  {schema && <script type="application/ld+json" set:html={safeJson(schema)} />}

  <!-- Realtime Analytics: Google Analytics 4 (if configured) -->
  {settings.gaId && (
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${settings.gaId}`}></script>
    <script is:inline define:vars={{ gaId: settings.gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  )}

  <!-- Realtime Analytics: Cloudflare Web Analytics Beacon (human visitors only) -->
  {settings.cloudflareBeaconToken && (
    <script is:inline define:vars={{ token: settings.cloudflareBeaconToken }}>
      if (!navigator.webdriver && !/Headless|Lighthouse|PageSpeed/i.test(navigator.userAgent)) {
        const s = document.createElement('script');
        s.defer = true;
        s.src = 'https://static.cloudflareinsights.com/beacon.min.js';
        s.setAttribute('data-cf-beacon', JSON.stringify({ token: token }));
        document.head.appendChild(s);
      }
    </script>
  )}
</head>
